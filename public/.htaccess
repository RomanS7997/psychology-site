# Настройки для Beget (Apache). На GitHub Pages этот файл просто не читается,
# так что он безвреден и там, и тут.
#
# Кладётся в корень сайта вместе с остальными файлами. Если в корне уже лежит
# .htaccess от старого WordPress — его надо заменить целиком, а не дописывать:
# там правила для движка, которого больше нет.

# ---------------------------------------------------------------------------
# Какой файл считать главным в папке
# ---------------------------------------------------------------------------
# Если от старого сайта в корне останется index.php, Apache во многих сборках
# возьмёт его, а не наш index.html — и на домене будет висеть старый сайт при
# полностью залитом новом. Поэтому говорим прямо.
<IfModule mod_dir.c>
  DirectoryIndex index.html
</IfModule>

# ---------------------------------------------------------------------------
# Один адрес вместо четырёх
# ---------------------------------------------------------------------------
# Сайт должен открываться ровно по одному адресу. Без этого https://, http://,
# с www и без www — для поисковика четыре разных сайта с одинаковым текстом.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # -------------------------------------------------------------------------
  # Адреса старого сайта — первыми и сразу на конечный адрес
  # -------------------------------------------------------------------------
  # Они стоят раньше склейки домена и ведут на полный адрес с https и без www.
  # Иначе человек, пришедший по старой ссылке с http и www, прыгал бы трижды:
  # на https, потом на адрес без www, и только потом на нужную страницу.
  # Настоящий 301, а не страница-заглушка: поисковик склеивает старый адрес
  # с новым быстрее, а человек не видит промежуточной страницы.
  RewriteRule ^index\.htm$            https://julialyapina.ru/                [R=301,L]
  RewriteRule ^about/index-1\.htm$    https://julialyapina.ru/about/          [R=301,L]
  RewriteRule ^contact/index-1\.htm$  https://julialyapina.ru/contact/        [R=301,L]
  RewriteRule ^services/index-1\.htm$ https://julialyapina.ru/services/adult/ [R=301,L]

  # -------------------------------------------------------------------------
  # /index.html -> /
  # -------------------------------------------------------------------------
  # Страница открывалась по двум адресам сразу: /  и  /index.html. Для человека
  # это одно и то же, для поисковика — две страницы с одинаковым текстом.
  #
  # Условие смотрит на ИСХОДНУЮ строку запроса (THE_REQUEST), а не на текущий
  # путь. Это важно: Apache сам внутренне дописывает index.html к запросу «/»,
  # и правило, написанное по пути, тут же сработало бы на собственной подстановке
  # и ушло в бесконечный цикл.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L,NE]

  # -------------------------------------------------------------------------
  # www -> без www
  # -------------------------------------------------------------------------
  # Зациклиться не может: после перехода имя уже не начинается с www,
  # и условие во второй раз не выполнится.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # -------------------------------------------------------------------------
  # http -> https
  # -------------------------------------------------------------------------
  # Здесь легко убить сайт насмерть. Перед Apache стоит nginx и забирает TLS
  # на себя; Apache при этом видит обычный http. Правило вида «не https —
  # перенаправляй на https» в такой связке срабатывает бесконечно, и сайт
  # не открывается вообще — ни одна страница.
  #
  # Поэтому условие вывернуто наоборот: перенаправляем, только если сервер
  # ПРЯМО сказал, что соединение было незащищённым. Нет заголовка — ничего
  # не делаем. Худшее, что может случиться, — http не превратится в https;
  # это чинится галочкой в панели Beget, а не падением сайта.
  #
  # Какой именно заголовок ставит Beget, выясняем файлом _probe.php после
  # первой заливки. Как узнаем — правило станет точным, а probe уедет.
  RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
  RewriteCond %{HTTP:X-Forwarded-Ssl} =off [OR]
  RewriteCond %{HTTP:X-Forwarded-Protocol} =http
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Хвосты WordPress, которых на новом сайте нет и не будет
  RewriteRule ^wp-(admin|login|content|includes)(/|$) - [R=410,L]
  RewriteRule ^xmlrpc\.php$                           - [R=410,L]
</IfModule>

# ---------------------------------------------------------------------------
# Сжатие
# ---------------------------------------------------------------------------
# Страница весит 180 КБ текстом и 35 КБ сжатой. Шрифты и картинки сжимать
# повторно бессмысленно — они уже сжаты внутри.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# Сколько держать в кэше браузера
# ---------------------------------------------------------------------------
# У файлов в _astro имя содержит отпечаток содержимого: меняется содержимое —
# меняется имя. Такие можно держать год и не думать. Шрифты и картинки имя не
# меняют, поэтому им месяц. Страницам — десять минут, чтобы правка доезжала
# до людей в тот же день.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 10 minutes"
  ExpiresByType application/xml           "access plus 1 hour"
  ExpiresByType text/plain                "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>

  # Файлы из _astro переименовываются при каждом изменении, поэтому их можно
  # держать год: старое имя просто перестаёт запрашиваться.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_astro/" LONG_CACHE
    Header set Cache-Control "public, max-age=31536000, immutable" env=LONG_CACHE
    # Заодно убираем Expires: он говорит «месяц», Cache-Control — «год».
    # Браузер выберет Cache-Control, но два разных ответа в одних заголовках
    # — это то, в чём потом полдня разбираются.
    Header unset Expires env=LONG_CACHE
  </IfModule>

  # Мелочи безопасности: запретить встраивать сайт в чужой фрейм и подменять
  # тип файла. Формы уходят на formsubmit.co, он в списке разрешённых.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------------
# Типы файлов
# ---------------------------------------------------------------------------
# Без этого старый Apache отдаёт woff2 и webp как «неизвестно что», и браузер
# их не принимает.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# Страницы ошибок — свои, а не апачевские. 403 сюда же: каталоги вроде
# /services/ своей страницы не имеют, и без этой строки человек, набравший
# такой адрес руками, увидел бы служебное «Forbidden» без единого слова
# по-русски и без выхода на сайт.
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# Содержимое каталогов наружу не показываем
Options -Indexes
