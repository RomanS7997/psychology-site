---
// src/pages/programs/umniky.astro
import Layout from '../../layouts/Layout.astro';
import { HERO_SIZES, webpSet } from '../../utils/img';
import ScrollAnimations from '../../components/ScrollAnimations.astro';
import AutoGallerySlider from '../../components/AutoGallerySlider.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SEO from '../../components/SEO.astro';
import FAQ from '../../components/FAQ.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../utils/url';

// Фото галереи: файлы 1..10 в /images/gallery/umniky/
const galleryPhotos = [
  { n: 1,  caption: 'Работа в тетради' },
  { n: 2,  caption: 'Обучение чтению по слогам' },
  { n: 3,  caption: 'Изучаем буквы' },
  { n: 4,  caption: 'Основы математики и счёт' },
  { n: 5,  caption: 'Занятия в группе' },
  { n: 6,  caption: 'Постановка руки к письму' },
  { n: 7,  caption: 'Развитие мелкой моторики' },
  { n: 8,  caption: 'Творческие задания' },
  { n: 9,  caption: 'Числовой ряд и состав числа' },
  { n: 10, caption: 'Логика и внимание' },
];

const galleryImages = galleryPhotos.map(({ n, caption }) => ({
  src: url(`/images/gallery/umniky/${n}.jpg`),
  alt: `Занятие Умники и умницы — ${caption.toLowerCase()}`,
  caption
}));

// Что входит в программу — тексты заказчицы, менялось только оформление
const heroPoints = [
  'Нейропсихологические игры',
  'Обучение чтению и развитие речи',
  'Постановка руки к письму',
  'Основы математики',
  'Еженедельные тематические познавательные занятия',
  'Творческие задания',
  'Психологическая подготовка к школе',
];

const skills = [
  {
    icon: 'book',
    title: 'Обучение чтению',
    text: 'От букв к словам и предложениям. Учим читать осмысленно, понимать прочитанное.',
  },
  {
    icon: 'send',
    title: 'Письмо',
    text: 'Правильная постановка руки, графомоторные навыки.',
  },
  {
    icon: 'check',
    title: 'Математика и логика',
    text: 'Состав числа, счет, решение задач. Развиваем логическое мышление.',
  },
  {
    icon: 'compass',
    title: 'Окружающий мир',
    text: 'Расширяем кругозор, формируем представления о мире. Каждую неделю новая тема.',
  },
  {
    icon: 'chat',
    title: 'Развитие речи',
    text: 'Учим выражать мысли, составлять рассказы, пересказывать. Расширяем словарный запас, работаем над дикцией.',
  },
  {
    icon: 'note',
    title: 'Память и внимание',
    text: 'Тренируем все виды памяти и внимания. Учим концентрироваться, запоминать и воспроизводить информацию.',
  },
];

const results = [
  { icon: 'check', title: 'Готовность к школе и уверенность в себе' },
  { icon: 'book', title: 'Навыки чтения, письма и счета' },
  { icon: 'worth', title: 'Развитая память, внимание и мотивация' },
];

const lessonFormat = [
  { label: 'Длительность', value: 'с 9:00 до 13:00' },
  { label: 'Размер группы', value: 'до 8 детей' },
  { label: 'Возраст', value: '4–6 лет' },
  { label: 'Частота', value: 'ежедневно, будние дни' },
];

const methods = [
  'Методика Зайцева',
  'Нейроупражнения',
  'Мнемотехника',
  'Индивидуальный подход к каждому ребенку',
];
---

<SEO
  title="«Умники и умницы» — подготовка к школе в Одинцово | 4–6 лет"
  description="Программа «Умники и умницы» в Одинцово: ежедневная подготовка к школе для детей 4–6 лет. Чтение, письмо, счёт, развитие речи и внимания."
  keywords="подготовка к школе Одинцово, занятия для дошкольников, развитие детей 4–6 лет, занятия для детей Одинцово"
  schema="service"
/>

<Layout
  title="«Умники и умницы» — подготовка к школе в Одинцово | 4–6 лет"
  description="Психологический курс для детей 4–6 лет. Развитие эмоционального интеллекта, работа со страхами, навыки общения. Группы до 8 детей."
>

  <Breadcrumbs
    items={[
      { label: 'Главная', href: url('/') },
      { label: 'Программы', href: url('/#programs') },
      { label: 'Умники и умницы' }
    ]}
  />

  <!-- ============ Первый экран ============ -->
  <section class="page-hero">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="hero-grid">

        <div>
          <p class="eyebrow mb-4">Для детей 4–6 лет</p>
          <h1 class="display mb-5">«Умники и умницы»</h1>

          <p class="lede mb-8 max-w-[46ch]">
            Ежедневные комплексно-развивающие занятия для детей 4–6 лет
          </p>

          <ul class="check-list mb-9">
            {heroPoints.map((point) => <li>{point}</li>)}
          </ul>

          <div class="flex flex-wrap gap-3">
            <button onclick="openBookingModal('umniky')" class="pill pill-solid pill-lg" type="button">
              Записаться на занятие
            </button>
            <a href="#program" class="pill pill-outline pill-lg">Что входит в программу</a>
          </div>
        </div>

        <div class="hero-visual orb surface-lg">
          <picture>
  <source srcset={webpSet('/images/gallery/umniky/2.jpg')} type="image/webp" sizes={HERO_SIZES} />
  <img src={url('/images/gallery/umniky/2.jpg')} alt="Занятие по программе «Умники и умницы»" class="hero-photo" loading="eager" fetchpriority="high" decoding="async" />
</picture>
        </div>

      </div>
    </div>
  </section>

  <!-- ============ Что будет изучать ребёнок ============ -->
  <section id="program" class="band">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head" data-reveal>
          <p class="eyebrow mb-3">Программа</p>
          <h2 class="heading mb-4">Что будет изучать ваш ребенок</h2>
          <p class="lede max-w-[56ch]">
            Программа разработана с учетом требований ФГОС для подготовки к школе
          </p>
        </div>

        <div class="cards-3">
          {skills.map((skill) => (
            <article class="feature surface lift" data-reveal>
              <span class="card-icon"><Icon name={skill.icon} size={22} /></span>
              <h3 class="card-title">{skill.title}</h3>
              <p class="card-text">{skill.text}</p>
            </article>
          ))}
        </div>

        <!-- Особенность программы -->
        <article class="gradient-card highlight" data-reveal>
          <div class="highlight-inner">
            <span class="card-icon"><Icon name="worth" size={22} /></span>
            <h3 class="heading-sm highlight-title">Особенность программы</h3>
            <p class="highlight-text">
              Мы не просто учим читать и считать — мы формируем учебную мотивацию и психологическую
              готовность к школе. Ребенок научится самостоятельно работать, слушать педагога и
              взаимодействовать с другими детьми.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <AutoGallerySlider
    images={galleryImages}
    title="Фотографии с занятий"
    subtitle="Смотрите, как проходят наши занятия"
    accentColor="blue"
    autoplayDelay={4500}
  />

  <!-- ============ Результаты программы ============ -->
  <section class="band">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head" data-reveal>
          <p class="eyebrow mb-3">Результат</p>
          <h2 class="heading mb-4">Результаты программы</h2>
          <p class="lede max-w-[56ch]">
            Как меняются дети после курса «Умники и умницы»
          </p>
        </div>

        <div class="cards-3">
          {results.map((item) => (
            <div class="result-card" data-reveal>
              <span class="card-icon"><Icon name={item.icon} size={22} /></span>
              <p class="result-title">{item.title}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Расписание и формат ============ -->
  <section class="band">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head" data-reveal>
          <p class="eyebrow mb-3">Расписание</p>
          <h2 class="heading">Расписание и формат занятий</h2>
        </div>

        <div class="split">

          <article class="gradient-card schedule" data-reveal>
            <div class="schedule-inner">
              <span class="card-icon"><Icon name="clock" size={22} /></span>
              <h3 class="heading-sm schedule-days">Ежедневные занятия</h3>

              <div class="glass-card schedule-slot">
                <h4 class="slot-title">Формат занятий:</h4>
                <ul class="slot-list">
                  {lessonFormat.map((row) => (
                    <li><strong>{row.label}:</strong> {row.value}</li>
                  ))}
                </ul>
              </div>
            </div>
          </article>

          <article class="surface methods" data-reveal>
            <div class="methods-inner">
              <span class="card-icon"><Icon name="flask" size={22} /></span>
              <h3 class="heading-sm mb-6">Методы работы</h3>

              <ul class="methods-list">
                {methods.map((method) => <li>{method}</li>)}
              </ul>
            </div>
          </article>

        </div>
      </div>
    </div>
  </section>

  <!-- ============ Финальный призыв ============ -->
  <section class="band band-tight">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="glow-band closing-band" data-reveal>
          <div class="closing-inner">
            <p class="eyebrow mb-4">Запись</p>
            <h2 class="heading mb-4">Записаться на занятие</h2>
            <p class="lede mb-8 max-w-[48ch]">
              Расскажу подробнее о программе и подберу удобное расписание
            </p>

            <div class="closing-actions">
              <button onclick="openBookingModal('umniky')" class="pill pill-solid pill-lg" type="button">
                <Icon name="chat" size={18} />
                Записаться
              </button>
            </div>

            <div class="closing-notes">
              <span><Icon name="team" size={16} />Группы до 8 детей</span>
              <span><Icon name="clock" size={16} />Ежедневно, будние дни</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Вопросы ============ -->
  <div data-reveal>
    <FAQ
      title="Часто задаваемые вопросы"
      subtitle="Ответы на популярные вопросы о программе"
      items={[
        {
          question: "С какого возраста можно начинать?",
          answer: "Программа рассчитана на детей 4–6 лет. Учитываю возрастные особенности и адаптирую задания под каждого ребёнка."
        },
        {
          question: "Когда проходят занятия?",
          answer: "Занятия проходят ежедневно. Точное расписание уточняйте при записи."
        },
        {
          question: "Можно ли посетить пробное занятие?",
          answer: "Вы можете записаться на первое занятие, чтобы познакомиться с педагогами и увидеть, как проходят занятия."
        },
        {
          question: "Нужны ли какие-то материалы?",
          answer: "Все материалы для занятий предоставляются: рабочие тетради, карандаши, краски, пластилин и т.д. Вам ничего не нужно покупать."
        },
        {
          question: "Будет ли ребёнок готов к школе после программы?",
          answer: "Да. Программа даёт и академические знания, и психологическую готовность к школе: ребёнок умеет работать самостоятельно, слушать педагога и взаимодействовать с другими детьми. Наши выпускники уверенно начинают учиться, в том числе в лицеях и гимназиях."
        }
      ]}
    />
  </div>

  <ScrollAnimations />
</Layout>

<style>
  /* ---------- ритм секций ---------- */
  .band { padding: 96px 0; }
  .band-tight { padding: 24px 0 96px; }

  .split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: stretch; }

  /* ---------- первый экран ---------- */
  .page-hero { padding: 28px 0 96px; background: var(--canvas); }
  .hero-grid {
    display: grid; grid-template-columns: 1.02fr 0.98fr; gap: 64px;
    align-items: center; max-width: 1180px; margin: 0 auto;
  }
  .hero-visual { aspect-ratio: 1 / 1.02; }
  .hero-photo {
    position: absolute; inset: 10% 9% 0 9%; z-index: 2;
    width: 82%; height: 90%; object-fit: cover; object-position: center 30%;
    border-radius: 18px 18px 0 0;
    border: 1px solid rgba(255, 255, 255, 0.55); border-bottom: 0;
  }

  /* ---------- список с галочками ---------- */
  .check-list { list-style: none; padding: 0; display: grid; gap: 11px; }
  .check-list li {
    position: relative; padding-left: 26px; font-size: 15px; line-height: 1.55; color: var(--graphite);
  }
  .check-list li::before {
    content: ""; position: absolute; left: 0; top: 8px;
    width: 13px; height: 7px;
    border-left: 1.6px solid var(--spark-water);
    border-bottom: 1.6px solid var(--spark-water);
    transform: rotate(-45deg);
  }

  /* ---------- карточки навыков ---------- */
  .card-icon {
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; width: 40px; height: 40px; border-radius: 12px;
    background: rgba(47, 125, 150, .1); color: var(--spark-deep);
  }
  .gradient-card .card-icon { background: rgba(255, 255, 255, .2); color: #fff; }

  .feature { padding: 28px; }
  .feature .card-icon { margin-bottom: 18px; }
  .card-title { font-size: 18px; font-weight: 400; letter-spacing: -0.01em; line-height: 1.3; margin-bottom: 10px; }
  .card-text { font-size: 14px; line-height: 1.6; color: var(--smoke); }

  /* ---------- особенность программы ---------- */
  .highlight { margin-top: 20px; }
  .highlight-inner { padding: 40px; max-width: 760px; }
  .highlight-inner .card-icon { margin-bottom: 20px; }
  .highlight-title { color: #fff; margin-bottom: 12px; }
  .highlight-text { font-size: 16px; line-height: 1.65; color: #fff; }

  /* ---------- результаты ---------- */
  .result-card {
    background: var(--canvas); border: 1px solid var(--stone); border-radius: var(--r-card);
    padding: 28px; display: flex; align-items: center; gap: 16px;
  }
  .result-title { font-size: 16px; font-weight: 500; letter-spacing: -0.01em; color: var(--ink); }

  /* ---------- расписание ---------- */
  .schedule-inner { padding: 36px; }
  .schedule-inner .card-icon { margin-bottom: 20px; }
  .schedule-days { color: #fff; margin-bottom: 26px; }
  .schedule-slot { padding: 24px; }
  .slot-title { font-size: 15px; font-weight: 500; color: var(--ink); margin-bottom: 14px; }
  .slot-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .slot-list li {
    position: relative; padding-left: 20px; font-size: 14px; line-height: 1.55; color: var(--smoke);
  }
  .slot-list li strong { font-weight: 500; color: var(--ink); }
  .slot-list li::before {
    content: ""; position: absolute; left: 3px; top: 9px;
    width: 5px; height: 5px; border-radius: 50%; background: var(--spark-deep);
  }

  /* ---------- методы работы ---------- */
  .methods-inner { padding: 36px; }
  .methods-inner .card-icon { margin-bottom: 20px; }
  .methods-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .methods-list li {
    padding: 18px 0; border-top: 1px solid var(--stone);
    font-size: 16px; font-weight: 500; letter-spacing: -0.01em; color: var(--ink);
  }
  .methods-list li:last-child { padding-bottom: 0; }

  /* ---------- финальный призыв ---------- */
  .closing-band { padding: 56px 48px; }
  .closing-inner { max-width: 640px; }
  .closing-actions { display: flex; gap: 12px; flex-wrap: wrap; }
  .closing-notes {
    display: flex; gap: 24px; flex-wrap: wrap;
    margin-top: 32px; padding-top: 22px; border-top: 1px solid var(--stone);
    font-size: 13px; color: var(--graphite);
  }
  .closing-notes span { display: inline-flex; align-items: center; gap: 8px; }
  .closing-notes :global(svg) { color: var(--graphite); }

  /* ---------- адаптив ---------- */
  @media (max-width: 1023px) {
    .page-hero { padding: 20px 0 72px; }
    .hero-grid { grid-template-columns: 1fr; gap: 44px; }
    .hero-visual { max-width: 440px; width: 100%; margin-inline: auto; }
    .cards-3 { grid-template-columns: repeat(2, 1fr); }
    .split { grid-template-columns: 1fr; }
  }

  @media (max-width: 767px) {
    .band { padding: 64px 0; }
    .band-tight { padding: 8px 0 64px; }
    .cards-3 { grid-template-columns: 1fr; }
    .feature, .result-card { padding: 24px; }
    .highlight-inner { padding: 26px; }
    .schedule-inner, .methods-inner { padding: 26px; }
    .schedule-slot { padding: 20px; }
    .closing-band { padding: 28px; }
  }
</style>
