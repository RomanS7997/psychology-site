---
// src/pages/programs/azbuka.astro
import Layout from '../../layouts/Layout.astro';
import ScrollAnimations from '../../components/ScrollAnimations.astro';
import AutoGallerySlider from '../../components/AutoGallerySlider.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SEO from '../../components/SEO.astro';
import FAQ from '../../components/FAQ.astro';
// Фото галереи: файлы 1..10 в /images/gallery/azbuka/
const galleryPhotos = [
  { n: 1,  caption: 'Учимся договариваться' },
  { n: 2,  caption: 'Игры на взаимодействие' },
  { n: 3,  caption: 'Настольные игры на эмоции' },
  { n: 4,  caption: 'Разбираем чувства по карточкам' },
  { n: 5,  caption: 'Карточки чувств' },
  { n: 6,  caption: 'Игра в команде' },
  { n: 7,  caption: 'Творческие задания' },
  { n: 8,  caption: 'Работа с карточками эмоций' },
  { n: 9,  caption: '«Компас чувств»' },
  { n: 10, caption: 'Учимся называть свои эмоции' },
];

const galleryImages = galleryPhotos.map(({ n, caption }) => ({
  src: url(`/images/gallery/azbuka/${n}.jpg`),
  alt: `Занятие Азбука общения — ${caption.toLowerCase()}`,
  caption
}));
import { url } from '../../utils/url';
---

<SEO 
  title="Азбука общения - Развитие EQ в Одинцово | Для детей 5-9 лет"
  description="Программа Азбука общения в Одинцово. Развитие эмоционального интеллекта для детей 5-9 лет. Умение общаться, дружить, понимать эмоции."
  keywords="эмоциональный интеллект детей, развитие EQ, занятия для детей Одинцово"
  schema="service"
/>

<Layout 
  title="Азбука общения - Развитие EQ в Одинцово | Для детей 5-9 лет"
  description="Психологический курс для детей 5-9 лет. Развитие эмоционального интеллекта, работа со страхами, навыки общения. Группы до 8 детей."
>

  

  <section class="relative pt-32 pb-20 overflow-hidden bg-gradient-to-br from-[#F2F7FD] via-white to-[#F2F7FD]" data-animate="fade">
    <div class="container mx-auto px-4 lg:px-8 relative z-10">
      <div class="grid md:grid-cols-2 gap-12 items-center max-w-7xl mx-auto">
        
        <!-- Текст -->
        <div>
          <h1 class="text-5xl md:text-6xl font-bold mb-6 bg-gradient-to-r from-[#4894B2] to-[#18698F] bg-clip-text text-transparent">
            «Азбука общения»
          </h1>

          <p class="text-xl text-gray-700 mb-4 font-semibold leading-relaxed">
            Уникальный психологический курс, который сочетает в себе все необходимые
            компоненты для гармоничного развития детей!
          </p>

          <p class="text-lg text-gray-700 mb-6">
            Занятия раз в неделю. Дети научатся:
          </p>

          <ul class="space-y-2 mb-8 text-gray-700">
            <li class="flex items-start gap-2"><span class="text-[#4894B2] mt-1">✅</span><span>Раскрыться, научиться говорить о своих чувствах, проявлять и реагировать на них</span></li>
            <li class="flex items-start gap-2"><span class="text-[#4894B2] mt-1">✅</span><span>Выстраивать границы и чувствовать их у других</span></li>
            <li class="flex items-start gap-2"><span class="text-[#4894B2] mt-1">✅</span><span>Избавиться от страхов, переживаний и обид</span></li>
            <li class="flex items-start gap-2"><span class="text-[#4894B2] mt-1">✅</span><span>Играть по правилам, уметь достойно проигрывать и выигрывать</span></li>
            <li class="flex items-start gap-2"><span class="text-[#4894B2] mt-1">✅</span><span>Работать в команде, быть лидером и её частью</span></li>
          </ul>

          <div class="flex flex-wrap gap-4 mb-8">
            <button
              onclick="openBookingModal()"
              class="px-8 py-4 bg-[#4894B2] hover:bg-[#18698F] text-white rounded-full font-semibold transition shadow-lg hover:shadow-xl hover:scale-105"
            >
              Записаться на занятие
            </button>
          </div>
        </div>
        
          <!-- Изображение -->
        <div class="flex justify-center lg:justify-end " >
        <div class="relative w-full max-w-md">
          <div class="aspect-[3/4] rounded-2xl overflow-hidden shadow-2xl">
            <img 
              src={url('/images/gallery/azbuka/hero.jpg')} 
              alt="Консультация психолога" 
              class="w-full h-auto" loading="eager" fetchpriority="high" decoding="async" />
          
          <!-- Декоративные элементы -->
          <div class="absolute -top-6 -right-6 w-24 h-24 bg-[#F2F7FD] rounded-full opacity-30 blur-2xl"></div>
          <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-[#F2F7FD] rounded-full opacity-30 blur-2xl"></div>
        </div>
        
      </div>
    </div>
  </section>
<Breadcrumbs 
    items={[
      { label: 'Главная', href: '/' },
      { label: 'Программы', href: '/#programs' },
      { label: 'Азбука общения' }
    ]}
  />
  </div><!-- 
  Что ребенок развивает -->
  <section class="py-20 bg-white" data-animate="slide-up">
    <div class="container mx-auto px-4 lg:px-8">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-4">
        Что ребенок развивает на занятиях
      </h2>
      <p class="text-center text-gray-600 text-lg mb-16 max-w-2xl mx-auto">
        Формирование высокого эмоционального интеллекта — важнейший фактор успешного общения
      </p>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        
        <!-- Навык 1 -->
        <div class="bg-gradient-to-br from-[#F2F7FD] to-white rounded-2xl p-8 hover:shadow-xl transition-all duration-300">
          <div class="text-5xl mb-4 text-center">💪</div>
          <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">Уверенность в себе</h3>
          <ul class="space-y-2 text-sm text-gray-700">
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Повышение самооценки</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Развитие самостоятельности</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Умение принимать решения</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Вера в свои силы</span>
            </li>
          </ul>
        </div>
        
        <!-- Навык 2 -->
        <div class="bg-gradient-to-br from-[#F2F7FD] to-white rounded-2xl p-8 hover:shadow-xl transition-all duration-300">
          <div class="text-5xl mb-4 text-center">🌟</div>
          <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">Позитивное отношение</h3>
          <ul class="space-y-2 text-sm text-gray-700">
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Принятие себя</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Дружелюбие к сверстникам</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Оптимистичный взгляд</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Благодарность</span>
            </li>
          </ul>
        </div>

        <!-- Навык 3 -->
        <div class="bg-gradient-to-br from-[#F2F7FD] to-white rounded-2xl p-8 hover:shadow-xl transition-all duration-300">
          <div class="text-5xl mb-4 text-center">💖</div>
          <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">Эмпатия</h3>
          <ul class="space-y-2 text-sm text-gray-700">
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Понимание чувств других</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Умение сопереживать</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Поддержка друзей</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Забота о близких</span>
            </li>
          </ul>
        </div>

        <!-- Навык 4 -->
        <div class="bg-gradient-to-br from-[#F2F7FD] to-white rounded-2xl p-8 hover:shadow-xl transition-all duration-300">
          <div class="text-5xl mb-4 text-center">🛡️</div>
          <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">Личные границы</h3>
          <ul class="space-y-2 text-sm text-gray-700">
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Выстраивание своих границ</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Уважение границ других</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Умение говорить "нет"</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Защита своих интересов</span>
            </li>
          </ul>
        </div>

        <!-- Навык 5 -->
        <div class="bg-gradient-to-br from-[#F2F7FD] to-white rounded-2xl p-8 hover:shadow-xl transition-all duration-300">
          <div class="text-5xl mb-4 text-center">🌈</div>
          <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">Работа с эмоциями</h3>
          <ul class="space-y-2 text-sm text-gray-700">
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Распознавание эмоций</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Управление страхами</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Работа с тревогой</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Преодоление обид</span>
            </li>
          </ul>
        </div>

        <!-- Навык 6 -->
        <div class="bg-gradient-to-br from-[#F2F7FD] to-white rounded-2xl p-8 hover:shadow-xl transition-all duration-300">
          <div class="text-5xl mb-4 text-center">🎯</div>
          <h3 class="text-xl font-bold text-gray-900 mb-4 text-center">Социальные навыки</h3>
          <ul class="space-y-2 text-sm text-gray-700">
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Игра по правилам</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Умение проигрывать</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Работа в команде</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#4894B2] mt-1">•</span>
              <span>Лидерские качества</span>
            </li>
          </ul>
        </div>
        
      </div>

      <!-- Особенность программы -->
      <div class="mt-16 bg-gradient-to-r from-[#4894B2] to-[#18698F] rounded-3xl p-10 text-white text-center max-w-4xl mx-auto">
        <div class="text-5xl mb-4">🧘</div>
        <h3 class="text-3xl font-bold mb-4">Релаксация и саморегуляция</h3>
        <p class="text-xl opacity-90">
          Дети знакомятся с техниками релаксации и саморегуляции, с помощью которых 
          легко управлять своим эмоциональным состоянием и повышать эмоциональную устойчивость.
        </p>
      </div>
    </div>
  </section>
  <!-- НОВАЯ ГАЛЕРЕЯ: Автослайдер с 48 фото -->
  <AutoGallerySlider 
    images={galleryImages}
    title="Как проходят наши занятия"
    subtitle="Смотрите, как дети учатся понимать эмоции и общаться друг с другом"
    accentColor="pink"
    autoplayDelay={4500}
  />
  <!-- Расписание и формат -->
  <section class="py-20 bg-white" data-animate="slide-up">
    <div class="container mx-auto px-4 lg:px-8">
      <h2 class="text-4xl md:text-5xl font-bold text-center mb-16">
        Расписание и формат занятий
      </h2>
      
      <div class="grid md:grid-cols-2 gap-12 max-w-6xl mx-auto">
        
        <!-- Расписание -->
        <div class="bg-gradient-to-br from-[#4894B2] to-[#18698F] rounded-3xl p-10">
          <div class="text-6xl mb-6 text-center">📅</div>
          <h3 class="text-3xl font-bold text-white mb-6 text-center">Занятия раз в неделю</h3>

          <div class="bg-white/70 backdrop-blur-sm rounded-2xl p-6">
            <h4 class="font-bold text-gray-900 mb-4">Формат занятий:</h4>
            <ul class="space-y-3">
              <li class="flex items-center gap-3">
                <span class="text-[#4894B2] text-xl">✓</span>
                <span><strong>Длительность:</strong> 60 минут</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-[#4894B2] text-xl">✓</span>
                <span><strong>Размер группы:</strong> до 8 детей</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-[#4894B2] text-xl">✓</span>
                <span><strong>Возраст:</strong> 5-9 лет</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Методы работы -->
        <div class="bg-gradient-to-br from-[rgba(230,215,205,0.2)] via-[rgba(215,198,188,0.26)] to-[rgba(200,180,170,0.35)] rounded-3xl p-10">
          <div class="text-6xl mb-6 text-center">🎭</div>
          <h3 class="text-3xl font-bold text-gray-900 mb-6 text-center">Методы работы</h3>
          
          <div class="space-y-6">
            <div class="bg-white/70 backdrop-blur-sm rounded-2xl p-6">
              <h4 class="font-bold text-gray-900 mb-2">Игротерапия</h4>
              <p class="text-gray-700">Проработка эмоций через игру и ролевые ситуации</p>
            </div>

            <div class="bg-white/70 backdrop-blur-sm rounded-2xl p-6">
              <h4 class="font-bold text-gray-900 mb-2">Арт-терапия</h4>
              <p class="text-gray-700">Выражение чувств через рисование и творчество</p>
            </div>
          </div>
        </div>
        
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-gradient-to-br from-[#4894B2] to-[#18698F] text-white relative overflow-hidden" data-animate="slide-up">
    <div class="container mx-auto px-4 lg:px-8 relative z-10 text-center">
      <h2 class="text-4xl md:text-5xl font-bold mb-6">
        Записаться на программу
      </h2>
      <p class="text-xl opacity-90 mb-10 max-w-2xl mx-auto">
        Расскажу подробнее о курсе и подберу удобное расписание
      </p>
      <button
        onclick="openBookingModal()"
        class="px-12 py-6 bg-white hover:bg-gray-100 text-[#4894B2] rounded-full font-bold transition-all shadow-2xl text-2xl"
      >
        💬 Записаться
      </button>
    </div>
  </section>

  <!-- FAQ -->
  <div data-animate="fade">

    <div data-animate="fade">


      <FAQ 
    title="Часто задаваемые вопросы"
    subtitle="Ответы на популярные вопросы о программе"
    items={[
      {
        question: "Подойдет ли программа моему ребенку?",
        answer: "Программа подходит для детей 5-9 лет с любым уровнем развития эмоционального интеллекта. Особенно полезна детям, которые стесняются, замкнуты, имеют трудности в общении или не умеют выражать свои эмоции."
      },
      {
        question: "Как быстро будут видны результаты?",
        answer: "Первые изменения родители замечают уже после 3-4 занятий. Ребенок начинает лучше понимать свои эмоции и говорить о них. Стабильные результаты видны через 2-3 месяца регулярных занятий."
      },
      {
        question: "Когда начинаются занятия?",
        answer: "Занятия проходят раз в неделю. Точное расписание уточняйте при записи."
      },
      {
        question: "Можно ли посетить пробное занятие?",
        answer: "Вы можете записаться на первое занятие, чтобы ребёнок познакомился с психологом и другими детьми, попробовал формат занятий."
      },
      {
        question: "Что если ребенок пропустит занятие?",
        answer: "При болезни (по справке) занятие можно перенести на другой день или получить возврат средств. При пропуске по другим причинам — возможна отработка в индивидуальном формате."
      }
    ]}
  />
  </div>

  <ScrollAnimations />
</Layout>
