---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import ScrollAnimations from '../components/ScrollAnimations.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SEO from '../components/SEO.astro';
import Icon from '../components/Icon.astro';
import { url } from '../utils/url';
---

<SEO
  title="Контакты - Кабинет психолога в Одинцово | Записаться на прием"
  description="Контакты психологического центра в Одинцово. Адрес, телефон, email, карта проезда. Записаться на консультацию онлайн или по телефону."
  keywords="контакты психолога Одинцово, адрес центра, записаться к психологу"
  schema="localbusiness"
/>

<Layout
  title="Контакты - Кабинет психолога в Одинцово | Записаться на прием"
  description="Контакты психологического центра в Одинцово."
>

  <Breadcrumbs
    items={[
      { label: 'Главная', href: url('/') },
      { label: 'Контакты' }
    ]}
  />

  <!-- Шапка страницы -->
  <section class="page-hero">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div data-reveal>
          <h1 class="display mb-5">Свяжитесь с нами</h1>
          <p class="lede max-w-[52ch]">
            Ответим на все ваши вопросы и поможем записаться на консультацию
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Основной контент: Форма + Контакты -->
  <section id="contact-form" class="band band-top-tight">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="contact-grid">

          <!-- Форма обратной связи -->
          <div class="surface-lg form-card" data-reveal>
            <h2 class="heading-sm mb-7">Напишите нам</h2>

            <form onsubmit="handleFormSubmit(event)">

              <div class="field">
                <label class="field-label" for="contact-name">Ваше имя *</label>
                <input
                  type="text"
                  id="contact-name"
                  name="name"
                  required
                  class="form-field"
                  placeholder="Введите ваше имя"
                >
              </div>

              <div class="field">
                <label class="field-label" for="contact-phone">Телефон *</label>
                <input
                  type="tel"
                  id="contact-phone"
                  name="phone"
                  required
                  class="form-field"
                  placeholder="+7 (___) ___-__-__"
                >
              </div>

              <div class="field">
                <label class="field-label" for="contact-email">Email</label>
                <input
                  type="email"
                  id="contact-email"
                  name="email"
                  class="form-field"
                  placeholder="your@email.com"
                >
              </div>

              <div class="field">
                <label class="field-label" for="contact-subject">Тема обращения</label>
                <select
                  id="contact-subject"
                  name="subject"
                  class="form-field"
                >
                  <option>Выберите тему</option>
                  <option>Запись на консультацию</option>
                  <option>Вопрос о программах</option>
                  <option>Вопрос о стоимости</option>
                  <option>Сотрудничество</option>
                  <option>Другое</option>
                </select>
              </div>

              <div class="field">
                <label class="field-label" for="contact-message">Ваше сообщение *</label>
                <textarea
                  id="contact-message"
                  name="message"
                  required
                  rows="5"
                  class="form-field"
                  placeholder="Расскажите о вашем запросе..."
                ></textarea>
              </div>

              <div class="consent-box">
                <label>
                  <input type="checkbox" name="privacy" id="contact-privacy" required>
                  <span class="consent-text">
                    Я согласен(а) на обработку персональных данных в соответствии с
                    <a href={url('/privacy')} target="_blank" rel="noopener">Политикой конфиденциальности</a>
                  </span>
                </label>
              </div>

              <button type="submit" class="pill pill-solid form-submit">
                Отправить сообщение
              </button>

            </form>

            <p id="contact-form-note" class="form-status" role="status" aria-live="polite"></p>

            <p class="form-note">
              <Icon name="clock" size={16} />
              Мы ответим в течение 15 минут в рабочее время
            </p>
          </div>

          <!-- Контактная информация -->
          <div>
            <h2 class="heading-sm mb-7" data-reveal>Контактная информация</h2>

            <div class="contact-list">

              <!-- Телефон -->
              <div class="contact-item" data-reveal>
                <span class="contact-icon"><Icon name="phone" size={20} /></span>
                <div class="contact-body">
                  <p class="contact-title">Телефон</p>
                  <a href="tel:+79151955132" class="contact-value">+7 (915) 195-51-32</a>
                  <p class="contact-sub">Ежедневно с 9:00 до 21:00</p>
                </div>
              </div>

              <!-- Email -->
              <div class="contact-item" data-reveal>
                <span class="contact-icon"><Icon name="mail" size={20} /></span>
                <div class="contact-body">
                  <p class="contact-title">Email</p>
                  <a href="mailto:lyapina_sorokina@mail.ru" class="contact-value contact-value-sm">
                    lyapina_sorokina@mail.ru
                  </a>
                </div>
              </div>

              <!-- Адрес -->
              <div class="contact-item" data-reveal>
                <span class="contact-icon"><Icon name="pin" size={20} /></span>
                <div class="contact-body">
                  <p class="contact-title">Адрес</p>
                  <p class="contact-value contact-value-sm">Одинцово, Лесной городок</p>
                  <p class="contact-sub">Точный адрес кабинета сообщим при записи</p>
                  <a href="#map" class="contact-link">
                    Как добраться
                    <Icon name="arrow" size={16} />
                  </a>
                </div>
              </div>

              <!-- Мессенджеры -->
              <div class="contact-item" data-reveal>
                <span class="contact-icon"><Icon name="chat" size={20} /></span>
                <div class="contact-body">
                  <p class="contact-title">Мессенджеры</p>
                  <div class="messengers">
                    <a
                      href="https://wa.me/79151955132"
                      target="_blank"
                      rel="noopener"
                      class="pill pill-outline messenger-btn"
                    >
                      <Icon name="chat" size={16} />
                      WhatsApp
                    </a>
                    <a
                      href="https://t.me/+79151955132"
                      target="_blank"
                      rel="noopener"
                      class="pill pill-outline messenger-btn"
                    >
                      <Icon name="send" size={16} />
                      Telegram
                    </a>
                    <a
                      href="tel:+79151955132"
                      class="pill pill-outline messenger-btn"
                    >
                      <Icon name="phone" size={16} />
                      Позвонить
                    </a>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Карта -->
  <section id="map" class="band band-taupe">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">

        <div class="band-head" data-reveal>
          <p class="eyebrow mb-3">Адрес</p>
          <h2 class="heading">Как нас найти</h2>
        </div>

        <!-- Яндекс.Карты -->
        <div class="map-frame" data-reveal>
          <div id="yandex-map">
            <div class="map-fallback" id="map-fallback">
              <span class="contact-icon"><Icon name="pin" size={20} /></span>
              <p class="map-fallback-title">Одинцово, Лесной городок</p>
              <p class="map-fallback-text">Точный адрес кабинета сообщим при записи</p>
            </div>
          </div>
        </div>

        <!-- Инструкции как добраться -->
        <h3 class="heading-sm routes-head" data-reveal>Как добраться:</h3>

        <div class="routes">

          <!-- На электричке -->
          <div class="surface route-card lift" data-reveal>
            <span class="contact-icon"><Icon name="pin" size={20} /></span>
            <h4 class="route-title">На электричке</h4>
            <p class="route-text">
              С Белорусского вокзала до станции «Лесной Городок» или «Одинцово». Точный маршрут сообщим при записи.
            </p>
          </div>

          <!-- На машине -->
          <div class="surface route-card lift" data-reveal>
            <span class="contact-icon"><Icon name="compass" size={20} /></span>
            <h4 class="route-title">На машине</h4>
            <p class="route-text">
              По Минскому или Можайскому шоссе. Парковка рядом с кабинетом. Маршрут сообщим при записи.
            </p>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Финальный призыв -->
  <section class="band band-tight">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="glow-band closing-band" data-reveal>
          <p class="eyebrow eyebrow-center mb-4">Запись</p>
          <h2 class="heading mb-4">Готовы записаться на консультацию?</h2>
          <p class="lede closing-lede">
            Позвоните нам или заполните форму — мы свяжемся с вами в ближайшее время
          </p>
          <div class="closing-actions">
            <a href="tel:+79151955132" class="pill pill-solid pill-lg">
              Позвонить сейчас
            </a>
            <a href="#contact-form" class="pill pill-outline pill-lg">
              Заполнить форму
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ScrollAnimations />
</Layout>

<!-- Яндекс.Карты API -->
<script is:inline src="https://api-maps.yandex.ru/2.1/?apikey=YOUR_API_KEY&lang=ru_RU"></script>

<script is:inline>
  // Обработка формы. Раньше здесь стоял alert без отправки — заявки терялись.
  async function handleFormSubmit(event) {
    event.preventDefault();

    const form = event.target;
    const fd = new FormData(form);
    const btn = form.querySelector('button[type="submit"]');
    const note = document.getElementById('contact-form-note');
    const label = btn ? btn.textContent : '';

    if (btn) { btn.disabled = true; btn.textContent = 'Отправка...'; }
    if (note) { note.textContent = ''; note.className = 'form-status'; }

    try {
      const response = await fetch('https://formsubmit.co/ajax/lyapina_sorokina@mail.ru', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          _subject: 'Новое обращение с сайта — форма «Напишите нам»',
          _template: 'table',
          _captcha: 'false',
          'Имя': fd.get('name') || '—',
          'Телефон': fd.get('phone') || '—',
          'Email': fd.get('email') || '—',
          'Тема': fd.get('subject') || '—',
          'Сообщение': fd.get('message') || '—',
          'Источник': 'Страница контактов',
        }),
      });

      // Сервис отвечает 200 и при отказе — смотрим тело
      const data = await response.json().catch(() => null);
      if (!response.ok || !data || String(data.success) !== 'true') {
        throw new Error('Заявка не принята');
      }

      form.reset();
      if (note) {
        note.className = 'form-status form-status-ok';
        note.textContent = 'Спасибо! Сообщение отправлено — мы свяжемся с вами.';
      }
    } catch (err) {
      if (note) {
        note.className = 'form-status form-status-fail';
        note.innerHTML =
          'Не удалось отправить сообщение. Позвоните нам: ' +
          '<a href="tel:+79151955132">+7 (915) 195-51-32</a>';
      }
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = label; }
    }
  }

  // Инициализация Яндекс.Карты
  function initYandexMap() {
    if (typeof ymaps === 'undefined') {
      console.error('Yandex Maps API не загружен');
      return;
    }

    ymaps.ready(function () {
      // Координаты Лесной городок, Одинцово
      const map = new ymaps.Map('yandex-map', {
        center: [55.634, 37.193],
        zoom: 13,
        controls: ['zoomControl', 'fullscreenControl', 'geolocationControl']
      });

      const placemark = new ymaps.Placemark([55.634, 37.193], {
        balloonContent: '<strong>Кабинет психолога Ляпина Юлия</strong><br>Одинцово, Лесной городок<br>+7 (915) 195-51-32',
        hintContent: 'Кабинет психолога'
      }, {
        preset: 'islands#blueMedicalIcon',
        iconColor: '#276579'
      });

      map.geoObjects.add(placemark);

      // Отключение скроллинга карты колесиком мыши
      map.behaviors.disable('scrollZoom');

      // Адрес-подстраховку убираем только теперь, когда карта действительно
      // построилась. Раньше её стирали заранее — и при неверном ключе
      // на месте карты оставалась пустота без единой строчки адреса.
      const fallback = document.getElementById('map-fallback');
      if (fallback && fallback.parentNode) fallback.parentNode.removeChild(fallback);
    });
  }

  // Запуск инициализации карты после загрузки страницы
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initYandexMap);
  } else {
    initYandexMap();
  }
</script>

<style>
  /* ---------- ритм секций ---------- */
  .band { padding: 96px 0; }
  .band-top-tight { padding-top: 0; }
  .band-tight { padding: 24px 0 96px; }

  /* Шапка сайта закреплена сверху — хлебные крошки не должны уезжать под неё */

  .page-hero { padding: 40px 0 64px; background: var(--canvas); }

  /* ---------- форма и контакты ---------- */
  .contact-grid {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: 56px;
    align-items: start;
  }

  .form-card { padding: 36px; }

  .field { margin-bottom: 18px; }

  .field-label {
    display: block;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--graphite);
    margin-bottom: 7px;
  }

  .form-field {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid var(--stone);
    border-radius: 10px;
    background: var(--canvas);
    color: var(--ink);
    font-family: inherit;
    font-size: 16px  /* меньше 16px — и Safari на iPhone зумит страницу */;
    line-height: 1.5;
    transition: border-color 0.2s ease;
  }
  .form-field::placeholder { color: var(--ash); }
  .form-field:hover { border-color: var(--ash); }
  .form-field:focus-visible {
    outline: 2px solid var(--spark-deep);
    outline-offset: 2px;
    border-color: var(--spark-water);
  }
  textarea.form-field { resize: none; }

  .form-submit { width: 100%; margin-top: 6px; }

  .consent-box {
    padding: 14px 16px;
    margin-bottom: 20px;
    border-radius: 14px;
    background: var(--taupe);
    border: 1px solid var(--stone);
  }
  .consent-box label {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
  }
  .consent-box input { margin-top: 3px; width: 18px; height: 18px; flex-shrink: 0; accent-color: var(--spark-deep); }
  .consent-text { font-size: 13px; line-height: 1.55; color: var(--smoke); }
  .consent-text a { color: var(--spark-deep); text-decoration: underline; }

  .form-status {
    margin-top: 16px;
    font-size: 14px;
    line-height: 1.55;
  }
  .form-status:empty { display: none; }
  .form-status-ok { color: var(--spark-deep); }
  .form-status-fail { color: var(--ink); }
  .form-status a { color: var(--spark-deep); text-decoration: underline; }

  .form-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 18px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--smoke);
    text-align: center;
  }
  .form-note :global(svg) { color: var(--ash); flex-shrink: 0; }

  /* ---------- контактная колонка ---------- */
  .contact-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 22px 0;
    border-top: 1px solid var(--stone);
  }

  .contact-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(47, 125, 150, 0.1);
    color: var(--spark-deep);
  }

  .contact-body { min-width: 0; }

  .contact-title {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ash);
    margin-bottom: 9px;
  }

  .contact-value {
    display: inline-block;
    font-size: 24px;
    font-weight: 300;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink);
    text-decoration: none;
    word-break: break-word;
    transition: color 0.2s ease;
  }
  a.contact-value:hover { color: var(--spark-deep); }
  .contact-value-sm { font-size: 19px; }

  .contact-sub {
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--smoke);
    margin-top: 7px;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
  }
  .contact-link :global(svg) { transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1); }
  .contact-link:hover :global(svg) { transform: translateX(3px); }

  .messengers { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .messenger-btn { padding: 10px 18px; font-size: 13.5px; }

  /* ---------- карта ---------- */
  .map-frame {
    border: 1px solid var(--stone);
    border-radius: var(--r-large);
    overflow: hidden;
    background: var(--canvas);
  }

  #yandex-map { width: 100%; height: 460px; }

  /* Пока карта не подгрузилась, в рамке остаётся адрес */
  .map-fallback {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 32px;
    text-align: center;
  }
  .map-fallback-title { font-size: 19px; font-weight: 300; letter-spacing: -0.02em; color: var(--ink); }
  .map-fallback-text { font-size: 13.5px; color: var(--smoke); }

  .routes-head { margin: 56px 0 24px; }

  .routes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .route-card { padding: 28px; background: var(--canvas); }
  .route-card .contact-icon { margin-bottom: 16px; }
  .route-title { font-size: 17px; font-weight: 400; letter-spacing: -0.01em; margin-bottom: 8px; }
  .route-text { font-size: 14px; line-height: 1.6; color: var(--smoke); }

  /* ---------- финальный призыв ---------- */
  .closing-band { padding: 56px 48px; text-align: center; }
  .closing-lede { margin: 0 auto 32px; max-width: 52ch; }
  .closing-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }

  /* ---------- адаптив ---------- */
  @media (max-width: 1023px) {
    .contact-grid { grid-template-columns: 1fr; gap: 44px; }
  }

  @media (max-width: 767px) {
    .band { padding: 64px 0; }
    .band-top-tight { padding-top: 0; }
    .band-tight { padding: 8px 0 64px; }
    .page-hero { padding: 28px 0 44px; }
    .form-card { padding: 26px; }
    .routes { grid-template-columns: 1fr; }
    .routes-head { margin: 40px 0 20px; }
    #yandex-map { height: 340px; }
    .contact-value { font-size: 22px; }
    .contact-value-sm { font-size: 17px; }
    .closing-band { padding: 32px 24px; }
  }
</style>
