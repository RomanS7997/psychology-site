---
// src/pages/test/general.astro
import Layout from '../../layouts/Layout.astro';
import { url } from '../../utils/url';
import SEO from '../../components/SEO.astro';
import Icon from '../../components/Icon.astro';
import ScrollAnimations from '../../components/ScrollAnimations.astro';
---

<SEO
  title="Бесплатный психологический тест | Кабинет психолога Ляпина Юлия"
  description="Пройдите короткий тест и получите рекомендации психолога по вашей ситуации."
/>

<Layout
  title="Бесплатный психологический тест - Психологический центр"
  description="Пройдите бесплатный тест и получите рекомендации от психолога."
>

  <section class="band band-taupe test-band">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">

        <!-- Прогресс -->
        <div class="progress" data-reveal>
          <div class="progress-row" role="status" aria-live="polite">
            <span class="progress-step">Шаг <span id="current-step">1</span> из <span id="total-steps">6</span></span>
            <span class="progress-percent"><span id="progress-percent">0</span>%</span>
          </div>
          <div class="progress-track" aria-hidden="true">
            <div id="progress-bar" class="progress-fill" style="width: 0%"></div>
          </div>
        </div>

        <!-- Форма теста -->
        <div class="test-card" data-reveal>

          <!-- Шаг 0: Приветствие -->
          <div class="step active" data-step="0">
            <div class="intro">
              <span class="intro-icon"><Icon name="compass" size={26} /></span>
              <h1 class="display mb-4">
                Бесплатный психологический тест
              </h1>
              <p class="lede intro-lede">
                Узнайте, что вас беспокоит, и получите рекомендации психолога
              </p>
            </div>

            <div class="panel">
              <p class="panel-lead">
                <strong>Тест займёт всего 2-3 минуты</strong> и поможет:
              </p>
              <ul class="check-list">
                <li>Определить, с чем вы столкнулись</li>
                <li>Понять степень ситуации</li>
                <li>Получить персональные рекомендации</li>
                <li>Подобрать подходящего специалиста</li>
              </ul>
            </div>

            <p class="fine">
              Все ответы конфиденциальны и используются только для подбора рекомендаций
            </p>

            <button data-action="next" class="pill pill-solid pill-lg btn-wide" type="button">
              Начать тест
            </button>
          </div>

          <!-- Шаг 1: Что беспокоит -->
          <div class="step" data-step="1">
            <h2 class="heading-sm q-title">Что вас беспокоит больше всего?</h2>

            <div class="answers">
              <label class="answer-option">
                <input type="radio" name="concern" value="anxiety" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Тревога и страхи</span>
                    <span class="answer-text">Постоянное беспокойство, панические атаки, фобии</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="concern" value="depression" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Депрессия и апатия</span>
                    <span class="answer-text">Потеря интереса к жизни, грусть, нет сил</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="concern" value="relationships" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Проблемы в отношениях</span>
                    <span class="answer-text">Конфликты с партнёром, семьёй, друзьями</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="concern" value="stress" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Стресс и выгорание</span>
                    <span class="answer-text">Переутомление, нет энергии, эмоциональное истощение</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="concern" value="self-esteem" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Низкая самооценка</span>
                    <span class="answer-text">Неуверенность в себе, самокритика, комплексы</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="concern" value="trauma" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Травматический опыт</span>
                    <span class="answer-text">Последствия тяжёлых событий, потерь, насилия</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="concern" value="other" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Другое</span>
                    <span class="answer-text">Хочу разобраться в себе, личностный рост</span>
                  </span>
                </div>
              </label>
            </div>

            <div class="actions">
              <button data-action="prev" class="pill pill-outline" type="button">
                Назад
              </button>
              <button data-action="next" class="pill pill-solid" type="button">
                Далее
              </button>
            </div>
          </div>

          <!-- Шаг 2: Как долго беспокоит -->
          <div class="step" data-step="2">
            <h2 class="heading-sm q-title">Как долго вас это беспокоит?</h2>

            <div class="answers">
              <label class="answer-option">
                <input type="radio" name="duration" value="recent" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Недавно (до 1 месяца)</span>
                    <span class="answer-text">Это началось совсем недавно</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="duration" value="months" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Несколько месяцев (1-6 месяцев)</span>
                    <span class="answer-text">Уже какое-то время меня это беспокоит</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="duration" value="year" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Больше года</span>
                    <span class="answer-text">Это длится уже давно</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="duration" value="always" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Всю жизнь или очень давно</span>
                    <span class="answer-text">Я помню это с детства / очень давно</span>
                  </span>
                </div>
              </label>
            </div>

            <div class="actions">
              <button data-action="prev" class="pill pill-outline" type="button">
                Назад
              </button>
              <button data-action="next" class="pill pill-solid" type="button">
                Далее
              </button>
            </div>
          </div>

          <!-- Шаг 3: Степень влияния на жизнь -->
          <div class="step" data-step="3">
            <h2 class="heading-sm q-title">Насколько это влияет на вашу жизнь?</h2>

            <div class="answers">
              <label class="answer-option">
                <input type="radio" name="severity" value="low" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Слегка беспокоит</span>
                    <span class="answer-text">Могу справляться, но хочу улучшить ситуацию</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="severity" value="medium" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Заметно мешает</span>
                    <span class="answer-text">Влияет на работу, отношения или самочувствие</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="severity" value="high" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Сильно мешает жить</span>
                    <span class="answer-text">Трудно справляться, снижает качество жизни</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="severity" value="critical" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Критическая ситуация</span>
                    <span class="answer-text">Не могу справиться самостоятельно, нужна срочная помощь</span>
                  </span>
                </div>
              </label>
            </div>

            <div class="actions">
              <button data-action="prev" class="pill pill-outline" type="button">
                Назад
              </button>
              <button data-action="next" class="pill pill-solid" type="button">
                Далее
              </button>
            </div>
          </div>

          <!-- Шаг 4: Контактные данные -->
          <div class="step" data-step="4">
            <h2 class="heading-sm q-title">Ваши контактные данные</h2>
            <p class="q-note">
              Мы свяжемся с вами и расскажем о рекомендациях на основе ваших ответов
            </p>

            <div class="fields">
              <div class="field">
                <label class="field-label" for="user-name">Ваше имя *</label>
                <input
                  type="text"
                  id="user-name"
                  required
                  class="field-input"
                  placeholder="Как к вам обращаться?"
                >
              </div>

              <div class="field">
                <label class="field-label" for="user-phone">Телефон *</label>
                <input
                  type="tel"
                  id="user-phone"
                  required
                  class="field-input"
                  placeholder="+7 (___) ___-__-__"
                >
              </div>

              <div class="field">
                <label class="field-label" for="user-email">Email (необязательно)</label>
                <input
                  type="email"
                  id="user-email"
                  class="field-input"
                  placeholder="your@email.com"
                >
              </div>

              <div class="field">
                <label class="field-label" for="user-comment">Комментарий (необязательно)</label>
                <textarea
                  id="user-comment"
                  rows="3"
                  class="field-input field-area"
                  placeholder="Если хотите что-то добавить..."
                ></textarea>
              </div>
            </div>

            <div class="actions">
              <button data-action="prev" class="pill pill-outline" type="button">
                Назад
              </button>
              <button data-action="submit" class="pill pill-solid" type="button">
                Получить рекомендации
              </button>
            </div>
          </div>

          <!-- Шаг 5: Финальный экран -->
          <div class="step" data-step="5">
            <div class="intro">
              <span class="intro-icon"><Icon name="check" size={26} /></span>
              <h2 class="heading mb-4">
                Спасибо за прохождение теста!
              </h2>
              <p class="lede intro-lede">
                Мы свяжемся с вами в течение 15 минут и дадим персональные рекомендации
              </p>
              <p id="test-send-note" class="send-note" role="status" aria-live="polite"></p>
            </div>

            <div class="panel">
              <p class="panel-lead">Что дальше?</p>
              <ol class="next-steps">
                <li>
                  <span class="next-num">01</span>
                  <span>Наш психолог свяжется с вами по телефону</span>
                </li>
                <li>
                  <span class="next-num">02</span>
                  <span>Расскажет о рекомендациях на основе ваших ответов</span>
                </li>
                <li>
                  <span class="next-num">03</span>
                  <span>Подберём подходящего специалиста</span>
                </li>
                <li>
                  <span class="next-num">04</span>
                  <span>Запишем вас на удобное время</span>
                </li>
              </ol>
            </div>

            <div class="actions actions-center">
              <a href={url('/')} class="pill pill-solid pill-lg">
                Вернуться на главную
              </a>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <ScrollAnimations />
</Layout>

<style>
  /* ---------- полоса страницы ---------- */
  .band { padding: 96px 0; }
  /* На этих страницах нет крошек, поэтому отступ под закреплённой
     шапкой держит первая полоса — иначе прогресс уезжает под неё. */
  .test-band { padding-top: 128px; }
  .test-band { min-height: 100vh; }
  .inner { max-width: 720px; margin: 0 auto; }

  /* ---------- прогресс ---------- */
  .progress { margin-bottom: 24px; }
  .progress-row {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 10px; font-size: 13px; letter-spacing: 0.02em;
  }
  .progress-step { color: var(--graphite); }
  .progress-percent { color: var(--smoke); font-variant-numeric: tabular-nums; }
  .progress-track {
    height: 4px; border-radius: var(--r-pill); overflow: hidden;
    background: var(--stone);
  }
  .progress-fill {
    height: 100%; border-radius: var(--r-pill);
    background: linear-gradient(90deg, var(--spark-deep-visual), var(--spark-water));
    transition: width 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  /* ---------- карточка теста ---------- */
  .test-card {
    background: var(--canvas);
    border: 1px solid var(--stone);
    border-radius: var(--r-large);
    padding: 40px;
  }

  .step { display: none; }
  .step.active { display: block; animation: fadeIn 0.5s ease-in-out; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .step.active { animation: none; }
  }

  /* ---------- вступление и финал ---------- */
  .intro { text-align: center; margin-bottom: 32px; }
  .intro-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 56px; height: 56px; border-radius: 16px; margin-bottom: 22px;
    background: rgba(47, 125, 150, 0.1); color: var(--spark-deep);
  }
  .send-note {
    margin-top: 14px;
    font-size: 14px;
    color: var(--ink);
  }
  .send-note:empty { display: none; }
  .send-note a { color: var(--spark-deep); text-decoration: underline; }

  .intro-lede { max-width: 48ch; margin: 0 auto; }

  /* ---------- панель со списком ---------- */
  .panel {
    background: var(--taupe);
    border: 1px solid var(--stone);
    border-radius: var(--r-card);
    padding: 26px 28px;
    margin-bottom: 24px;
  }
  .panel-lead { font-size: 15px; color: var(--graphite); margin-bottom: 16px; }
  .panel-lead strong { font-weight: 500; color: var(--ink); }

  .check-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 11px; }
  .check-list li {
    position: relative; padding-left: 26px; font-size: 15px; line-height: 1.5; color: var(--graphite);
  }
  .check-list li::before {
    content: ""; position: absolute; left: 0; top: 6px;
    width: 13px; height: 7px;
    border-left: 1.6px solid var(--spark-water);
    border-bottom: 1.6px solid var(--spark-water);
    transform: rotate(-45deg);
  }

  .next-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .next-steps li {
    display: flex; align-items: flex-start; gap: 14px;
    font-size: 15px; line-height: 1.5; color: var(--graphite); text-align: left;
  }
  .next-num {
    flex-shrink: 0; font-size: 12px; font-weight: 500; letter-spacing: 0.1em;
    color: var(--ash); font-variant-numeric: tabular-nums; padding-top: 3px;
  }

  .fine {
    font-size: 13px; line-height: 1.55; color: var(--smoke);
    text-align: center; margin-bottom: 26px;
  }

  /* ---------- вопрос ---------- */
  .q-title { margin-bottom: 8px; }
  .q-note { font-size: 15px; line-height: 1.6; color: var(--smoke); margin-bottom: 24px; }
  .q-title + .answers, .q-title + .fields { margin-top: 24px; }

  /* ---------- варианты ответа ---------- */
  .answers { display: grid; gap: 10px; }
  .answer-option { display: block; cursor: pointer; }

  /* поле остаётся в потоке для клавиатуры, но невидимо */
  .answer-input {
    position: absolute; width: 1px; height: 1px;
    margin: -1px; padding: 0; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .answer-card {
    display: flex; align-items: flex-start; gap: 14px;
    padding: 16px 18px;
    background: var(--taupe);
    border: 1px solid var(--stone);
    border-radius: 14px;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  .answer-option:hover .answer-card { border-color: var(--ash); }

  .answer-mark {
    flex-shrink: 0; width: 18px; height: 18px; margin-top: 2px;
    border-radius: 50%; border: 1px solid var(--ash);
    background: var(--canvas);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .answer-body { display: block; }
  .answer-title {
    display: block; font-size: 15px; font-weight: 500;
    letter-spacing: -0.01em; color: var(--ink);
  }
  .answer-text {
    display: block; margin-top: 4px;
    font-size: 13.5px; line-height: 1.5; color: var(--smoke);
  }
  /* у коротких ответов подписи нет — заголовок один и звучит крупнее */
  .answer-title:only-child { font-size: 16px; }

  .answer-input:checked + .answer-card {
    border-color: var(--spark-deep);
    background: rgba(47, 125, 150, 0.07);
  }
  .answer-input:checked + .answer-card .answer-mark {
    border-color: var(--spark-deep);
    box-shadow: inset 0 0 0 4px var(--spark-deep);
  }
  .answer-input:focus-visible + .answer-card {
    outline: 2px solid var(--spark-deep);
    outline-offset: 3px;
  }

  /* ---------- поля формы ---------- */
  .fields { display: grid; gap: 18px; }
  .field-label {
    display: block; margin-bottom: 8px;
    font-size: 13px; font-weight: 500; letter-spacing: 0.01em; color: var(--graphite);
  }
  .field-input {
    width: 100%; padding: 13px 16px;
    font-family: inherit; font-size: 16px  /* меньше 16px — и Safari на iPhone зумит страницу */; color: var(--ink);
    background: var(--taupe);
    border: 1px solid var(--stone);
    border-radius: 14px;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  .field-input::placeholder { color: var(--ash); }
  .field-input:hover { border-color: var(--ash); }
  .field-input:focus {
    outline: none;
    border-color: var(--spark-deep);
    background: var(--canvas);
  }
  .field-area { resize: none; line-height: 1.55; }

  /* ---------- кнопки шага ---------- */
  .actions { display: flex; gap: 12px; margin-top: 32px; }
  .actions .pill { flex: 1; }
  .actions-center { justify-content: center; }
  .actions-center .pill { flex: 0 0 auto; }
  .btn-wide { width: 100%; }

  /* ---------- адаптив ---------- */
  @media (max-width: 767px) {
    .band { padding: 56px 0; }
    .test-band { padding-top: 120px; }
    .test-card { padding: 26px 20px; border-radius: var(--r-card); }
    .panel { padding: 22px 20px; }
    .actions { flex-wrap: wrap; }
    .actions .pill { flex: 1 1 100%; }
    .actions-center .pill { flex: 1 1 100%; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    let currentStep = 0;
    const totalSteps = 5;
    const testData = {};

    function updateProgress() {
      const percent = Math.round((currentStep / totalSteps) * 100);
      document.getElementById('progress-bar').style.width = percent + '%';
      document.getElementById('progress-percent').textContent = percent;
      document.getElementById('current-step').textContent = currentStep + 1;
      document.getElementById('total-steps').textContent = totalSteps + 1;
    }

    function focusStep(step) {
      if (!step) return;
      const heading = step.querySelector('h2, h3, legend, .question-title');
      if (heading) {
        heading.setAttribute('tabindex', '-1');
        heading.focus({ preventScroll: true });
      } else {
        step.querySelector('input, button, textarea')?.focus({ preventScroll: true });
      }
    }

    function nextStep() {
      const currentStepEl = document.querySelector(`.step[data-step="${currentStep}"]`);
      const selectedAnswer = currentStepEl?.querySelector('input[type="radio"]:checked');

      if (currentStep > 0 && currentStep < 4 && !selectedAnswer) {
        alert('Пожалуйста, выберите ответ');
        return;
      }

      if (selectedAnswer) {
        testData[selectedAnswer.name] = selectedAnswer.value;
      }

      document.querySelector(`.step[data-step="${currentStep}"]`)?.classList.remove('active');
      currentStep++;
      const shownStep = document.querySelector(`.step[data-step="${currentStep}"]`);
      shownStep?.classList.add('active');
      // Фокус стоял на кнопке, которая уехала в скрытый шаг: без переноса
      // он падал на body, и следующий Tab начинался с шапки сайта.
      focusStep(shownStep);

      updateProgress();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function prevStep() {
      document.querySelector(`.step[data-step="${currentStep}"]`)?.classList.remove('active');
      currentStep--;
      const backStep = document.querySelector(`.step[data-step="${currentStep}"]`);
      backStep?.classList.add('active');
      focusStep(backStep);

      updateProgress();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function sendTest(data) {
      const answers = Object.entries(data)
        .filter(([k]) => !['name', 'phone', 'email', 'comment'].includes(k))
        .map(([k, v]) => `${k}: ${v}`)
        .join('; ');

      try {
        const response = await fetch('https://formsubmit.co/ajax/lyapina_sorokina@mail.ru', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            _subject: 'Результат теста с сайта — взрослый',
            _template: 'table',
            _captcha: 'false',
            'Имя': data.name || '—',
            'Телефон': data.phone || '—',
            'Email': data.email || '—',
            'Комментарий': data.comment || '—',
            'Ответы': answers || '—',
            'Источник': 'Тест для взрослых',
          }),
        });
        const body = await response.json().catch(() => null);
        if (!response.ok || !body || String(body.success) !== 'true') {
          throw new Error('Заявка не принята');
        }
      } catch (err) {
        const note = document.getElementById('test-send-note');
        if (note) {
          note.innerHTML =
            'Не получилось отправить ответы. Позвоните нам: ' +
            '<a href="tel:+79151955132">+7 (915) 195-51-32</a>';
        }
      }
    }

    function submitTest() {
      const name = document.getElementById('user-name')?.value;
      const phone = document.getElementById('user-phone')?.value;
      const email = document.getElementById('user-email')?.value;
      const comment = document.getElementById('user-comment')?.value;

      if (!name || !phone) {
        alert('Пожалуйста, заполните обязательные поля');
        return;
      }

      testData.name = name;
      testData.phone = phone;
      testData.email = email;
      testData.comment = comment;

      // Раньше ответы и телефон уходили в консоль браузера и терялись.
      sendTest(testData);
      nextStep();
    }

    // Добавляем обработчики на все кнопки
    document.querySelectorAll('[data-action="next"]').forEach(btn => {
      btn.addEventListener('click', nextStep);
    });

    document.querySelectorAll('[data-action="prev"]').forEach(btn => {
      btn.addEventListener('click', prevStep);
    });

    document.querySelectorAll('[data-action="submit"]').forEach(btn => {
      btn.addEventListener('click', submitTest);
    });

    updateProgress();
  });
</script>
