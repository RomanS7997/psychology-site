---
// src/pages/test/children.astro
import Layout from '../../layouts/Layout.astro';
import { url } from '../../utils/url';
import SEO from '../../components/SEO.astro';
import Icon from '../../components/Icon.astro';
import ScrollAnimations from '../../components/ScrollAnimations.astro';
---

<SEO
  title="Тест для родителей | Кабинет психолога Ляпина Юлия"
  description="Короткий тест для родителей: оцените, нужна ли ребёнку помощь психолога."
/>

<Layout
  title="Тест для родителей - Психологический центр"
  description="Пройдите бесплатный тест и получите рекомендации по развитию вашего ребенка."
>

  <section class="band band-taupe test-band">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">

        <!-- Прогресс -->
        <div class="progress" data-reveal>
          <div class="progress-row" role="status" aria-live="polite">
            <span class="progress-step">Шаг <span id="current-step">1</span> из <span id="total-steps">7</span></span>
            <span class="progress-percent"><span id="progress-percent">0</span>%</span>
          </div>
          <div class="progress-track" aria-hidden="true">
            <div id="progress-bar" class="progress-fill" style="width: 0%"></div>
          </div>
        </div>

        <!-- Форма теста -->
        <div class="test-card" data-reveal>

          <!-- Шаг 0: Приветствие -->
          <div class="step active" data-step="0">
            <div class="intro">
              <span class="intro-icon"><Icon name="child" size={26} /></span>
              <h1 class="display mb-4">
                Тест для родителей
              </h1>
              <p class="lede intro-lede">
                Узнайте, какая программа лучше всего подойдёт вашему ребёнку
              </p>
            </div>

            <div class="panel">
              <p class="panel-lead">
                <strong>Тест займёт всего 2 минуты</strong> и поможет нам:
              </p>
              <ul class="check-list">
                <li>Понять особенности и потребности вашего ребёнка</li>
                <li>Подобрать подходящую программу развития</li>
                <li>Дать рекомендации от детского психолога</li>
              </ul>
            </div>

            <button data-action="next" class="pill pill-solid pill-lg btn-wide" type="button">
              Начать тест
            </button>
          </div>

          <!-- Шаг 1: Возраст ребёнка -->
          <div class="step" data-step="1">
            <h2 class="heading-sm q-title">Сколько лет вашему ребёнку?</h2>

            <div class="answers">
              <label class="answer-option">
                <input type="radio" name="age" value="3-4" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">3-4 года</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="age" value="5-6" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">5-6 лет</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="age" value="7-9" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">7-9 лет</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="age" value="10+" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">10+ лет</span>
                  </span>
                </div>
              </label>
            </div>


            <div class="actions">
              <button data-action="prev" class="pill pill-outline" type="button">
                Назад
              </button>
              <button data-action="next" class="pill pill-solid" type="button">
                Далее
              </button>
            </div>
          </div>

          <!-- Шаг 2: Что беспокоит -->
          <div class="step" data-step="2">
            <h2 class="heading-sm q-title">Что вас беспокоит больше всего?</h2>

            <div class="answers">
              <label class="answer-option">
                <input type="radio" name="concern" value="behavior" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Поведение</span>
                    <span class="answer-text">Не слушается, капризничает, агрессия</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="concern" value="communication" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Общение</span>
                    <span class="answer-text">Трудности в контакте с детьми или взрослыми</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="concern" value="emotions" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Эмоции</span>
                    <span class="answer-text">Страхи, тревоги, частые истерики</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="concern" value="development" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Развитие</span>
                    <span class="answer-text">Подготовка к школе, внимание, память</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="concern" value="school" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Школьные проблемы</span>
                    <span class="answer-text">Не хочет учиться, конфликты в школе</span>
                  </span>
                </div>
              </label>
            </div>

            <div class="actions">
              <button data-action="prev" class="pill pill-outline" type="button">
                Назад
              </button>
              <button data-action="next" class="pill pill-solid" type="button">
                Далее
              </button>
            </div>
          </div>

          <!-- Шаг 3: Степень беспокойства -->
          <div class="step" data-step="3">
            <h2 class="heading-sm q-title">Насколько серьёзной вы считаете проблему?</h2>

            <div class="answers">
              <label class="answer-option">
                <input type="radio" name="severity" value="low" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Незначительная</span>
                    <span class="answer-text">Хочу предупредить возможные трудности</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="severity" value="medium" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Средняя</span>
                    <span class="answer-text">Периодически возникают сложности</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="severity" value="high" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Серьёзная</span>
                    <span class="answer-text">Проблема мешает ребёнку в повседневной жизни</span>
                  </span>
                </div>
              </label>
            </div>

            <div class="actions">
              <button data-action="prev" class="pill pill-outline" type="button">
                Назад
              </button>
              <button data-action="next" class="pill pill-solid" type="button">
                Далее
              </button>
            </div>
          </div>

          <!-- Шаг 4: Посещал ли психолога -->
          <div class="step" data-step="4">
            <h2 class="heading-sm q-title">Ребёнок уже посещал психолога?</h2>

            <div class="answers">
              <label class="answer-option">
                <input type="radio" name="visited" value="yes" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Да, посещал</span>
                  </span>
                </div>
              </label>

              <label class="answer-option">
                <input type="radio" name="visited" value="no" class="answer-input">
                <div class="answer-card">
                  <span class="answer-mark" aria-hidden="true"></span>
                  <span class="answer-body">
                    <span class="answer-title">Нет, это будет первый раз</span>
                  </span>
                </div>
              </label>
            </div>

            <div class="actions">
              <button data-action="prev" class="pill pill-outline" type="button">
                Назад
              </button>
              <button data-action="next" class="pill pill-solid" type="button">
                Далее
              </button>
            </div>
          </div>

          <!-- Шаг 5: Контактные данные -->
          <div class="step" data-step="5">
            <h2 class="heading-sm q-title">Ваши контактные данные</h2>
            <p class="q-note">
              Мы свяжемся с вами и расскажем о рекомендациях на основе ваших ответов
            </p>

            <div class="fields">
              <div class="field">
                <label class="field-label" for="parent-name">Ваше имя *</label>
                <input
                  type="text"
                  id="parent-name"
                  required
                  class="field-input"
                  placeholder="Как к вам обращаться?"
                >
              </div>

              <div class="field">
                <label class="field-label" for="parent-phone">Телефон *</label>
                <input
                  type="tel"
                  id="parent-phone"
                  required
                  class="field-input"
                  placeholder="+7 (___) ___-__-__"
                >
              </div>

              <div class="field">
                <label class="field-label" for="child-name">Имя ребёнка (необязательно)</label>
                <input
                  type="text"
                  id="child-name"
                  class="field-input"
                  placeholder="Имя вашего ребёнка"
                >
              </div>
            </div>

            <div class="consent-box">
              <label>
                <input type="checkbox" name="privacy" required>
                <span class="consent-text">
                  Я согласен(а) на обработку персональных данных, включая ответы о ребёнке в соответствии с
                  <a href={url('/privacy')} target="_blank" rel="noopener">Политикой конфиденциальности</a>
                </span>
              </label>
            </div>

            <div class="actions">
              <button data-action="prev" class="pill pill-outline" type="button">
                Назад
              </button>
              <button data-action="submit" class="pill pill-solid" type="button">
                Получить результат
              </button>
            </div>
          </div>

          <!-- Шаг 6: Финальный экран -->
          <div class="step" data-step="6">
            <div class="intro">
              <span class="intro-icon"><Icon name="check" size={26} /></span>
              <h2 class="heading mb-4">
                Спасибо за прохождение теста!
              </h2>
              <p class="lede intro-lede">
                Мы свяжемся с вами в течение 15 минут и расскажем о наших рекомендациях
              </p>
              <p id="test-send-note" class="send-note" role="status" aria-live="polite"></p>
            </div>

            <div class="panel">
              <p class="panel-lead">Что дальше?</p>
              <ol class="next-steps">
                <li>
                  <span class="next-num">01</span>
                  <span>Наш специалист свяжется с вами по телефону</span>
                </li>
                <li>
                  <span class="next-num">02</span>
                  <span>Мы расскажем о рекомендациях на основе ваших ответов</span>
                </li>
                <li>
                  <span class="next-num">03</span>
                  <span>Подберём удобное время для первой консультации</span>
                </li>
              </ol>
            </div>

            <div class="actions">
              <a href={url('/')} class="pill pill-solid">
                Вернуться на главную
              </a>
              <a href={url('/programs/azbuka')} class="pill pill-outline">
                Посмотреть программы
              </a>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <ScrollAnimations />
</Layout>

<style>
  /* ---------- полоса страницы ---------- */
  .band { padding: 96px 0; }
  /* На этих страницах нет крошек, поэтому отступ под закреплённой
     шапкой держит первая полоса — иначе прогресс уезжает под неё. */
  .test-band { padding-top: 128px; }
  .test-band { min-height: 100vh; }
  .inner { max-width: 720px; margin: 0 auto; }

  /* ---------- прогресс ---------- */
  .progress { margin-bottom: 24px; }
  .progress-row {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 10px; font-size: 13px; letter-spacing: 0.02em;
  }
  .progress-step { color: var(--graphite); }
  .progress-percent { color: var(--smoke); font-variant-numeric: tabular-nums; }
  .progress-track {
    height: 4px; border-radius: var(--r-pill); overflow: hidden;
    background: var(--stone);
  }
  .progress-fill {
    height: 100%; border-radius: var(--r-pill);
    background: linear-gradient(90deg, var(--spark-deep-visual), var(--spark-water));
    transition: width 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  /* ---------- карточка теста ---------- */
  .test-card {
    background: var(--canvas);
    border: 1px solid var(--stone);
    border-radius: var(--r-large);
    padding: 40px;
  }

  .step { display: none; }
  .step.active { display: block; animation: fadeIn 0.5s ease-in-out; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .step.active { animation: none; }
  }

  /* ---------- вступление и финал ---------- */
  .intro { text-align: center; margin-bottom: 32px; }
  .intro-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 56px; height: 56px; border-radius: 16px; margin-bottom: 22px;
    background: rgba(47, 125, 150, 0.1); color: var(--spark-deep);
  }
  .consent-box {
    padding: 14px 16px;
    margin-bottom: 20px;
    border-radius: 14px;
    background: var(--taupe);
    border: 1px solid var(--stone);
  }
  .consent-box label {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
  }
  .consent-box input { margin-top: 3px; width: 18px; height: 18px; flex-shrink: 0; accent-color: var(--spark-deep); }
  .consent-text { font-size: 13px; line-height: 1.55; color: var(--smoke); }
  .consent-text a { color: var(--spark-deep); text-decoration: underline; }

  .send-note {
    margin-top: 14px;
    font-size: 14px;
    color: var(--ink);
  }
  .send-note:empty { display: none; }
  .send-note a { color: var(--spark-deep); text-decoration: underline; }

  .intro-lede { max-width: 48ch; margin: 0 auto; }

  /* ---------- панель со списком ---------- */
  .panel {
    background: var(--taupe);
    border: 1px solid var(--stone);
    border-radius: var(--r-card);
    padding: 26px 28px;
    margin-bottom: 24px;
  }
  .panel-lead { font-size: 15px; color: var(--graphite); margin-bottom: 16px; }
  .panel-lead strong { font-weight: 500; color: var(--ink); }

  .check-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 11px; }
  .check-list li {
    position: relative; padding-left: 26px; font-size: 15px; line-height: 1.5; color: var(--graphite);
  }
  .check-list li::before {
    content: ""; position: absolute; left: 0; top: 6px;
    width: 13px; height: 7px;
    border-left: 1.6px solid var(--spark-water);
    border-bottom: 1.6px solid var(--spark-water);
    transform: rotate(-45deg);
  }

  .next-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .next-steps li {
    display: flex; align-items: flex-start; gap: 14px;
    font-size: 15px; line-height: 1.5; color: var(--graphite); text-align: left;
  }
  .next-num {
    flex-shrink: 0; font-size: 12px; font-weight: 500; letter-spacing: 0.1em;
    color: var(--ash); font-variant-numeric: tabular-nums; padding-top: 3px;
  }

  /* ---------- вопрос ---------- */
  .q-title { margin-bottom: 8px; }
  .q-note { font-size: 15px; line-height: 1.6; color: var(--smoke); margin-bottom: 24px; }
  .q-title + .answers, .q-title + .fields { margin-top: 24px; }

  /* ---------- варианты ответа ---------- */
  .answers { display: grid; gap: 10px; }
  .answer-option { display: block; cursor: pointer; }

  /* поле остаётся в потоке для клавиатуры, но невидимо */
  .answer-input {
    position: absolute; width: 1px; height: 1px;
    margin: -1px; padding: 0; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .answer-card {
    display: flex; align-items: flex-start; gap: 14px;
    padding: 16px 18px;
    background: var(--taupe);
    border: 1px solid var(--stone);
    border-radius: 14px;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  .answer-option:hover .answer-card { border-color: var(--ash); }

  .answer-mark {
    flex-shrink: 0; width: 18px; height: 18px; margin-top: 2px;
    border-radius: 50%; border: 1px solid var(--ash);
    background: var(--canvas);
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .answer-body { display: block; }
  .answer-title {
    display: block; font-size: 15px; font-weight: 500;
    letter-spacing: -0.01em; color: var(--ink);
  }
  .answer-text {
    display: block; margin-top: 4px;
    font-size: 13.5px; line-height: 1.5; color: var(--smoke);
  }
  /* у коротких ответов подписи нет — заголовок один и звучит крупнее */
  .answer-title:only-child { font-size: 16px; }

  .answer-input:checked + .answer-card {
    border-color: var(--spark-deep);
    background: rgba(47, 125, 150, 0.07);
  }
  .answer-input:checked + .answer-card .answer-mark {
    border-color: var(--spark-deep);
    box-shadow: inset 0 0 0 4px var(--spark-deep);
  }
  .answer-input:focus-visible + .answer-card {
    outline: 2px solid var(--spark-deep);
    outline-offset: 3px;
  }

  /* ---------- поля формы ---------- */
  .fields { display: grid; gap: 18px; }
  .field-label {
    display: block; margin-bottom: 8px;
    font-size: 13px; font-weight: 500; letter-spacing: 0.01em; color: var(--graphite);
  }
  .field-input {
    width: 100%; padding: 13px 16px;
    font-family: inherit; font-size: 16px  /* меньше 16px — и Safari на iPhone зумит страницу */; color: var(--ink);
    background: var(--taupe);
    border: 1px solid var(--stone);
    border-radius: 14px;
    transition: border-color 0.25s ease, background-color 0.25s ease;
  }
  .field-input::placeholder { color: var(--ash); }
  .field-input:hover { border-color: var(--ash); }
  .field-input:focus {
    outline: none;
    border-color: var(--spark-deep);
    background: var(--canvas);
  }

  /* ---------- кнопки шага ---------- */
  .actions { display: flex; gap: 12px; margin-top: 32px; }
  .actions .pill { flex: 1; }
  .btn-wide { width: 100%; }

  /* ---------- адаптив ---------- */
  @media (max-width: 767px) {
    .band { padding: 56px 0; }
    .test-band { padding-top: 120px; }
    .test-card { padding: 26px 20px; border-radius: var(--r-card); }
    .panel { padding: 22px 20px; }
    .actions { flex-wrap: wrap; }
    .actions .pill { flex: 1 1 100%; }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    let currentStep = 0;
    const totalSteps = 6;
    const testData = {};

    function updateProgress() {
      const percent = Math.round((currentStep / totalSteps) * 100);
      document.getElementById('progress-bar').style.width = percent + '%';
      document.getElementById('progress-percent').textContent = percent;
      document.getElementById('current-step').textContent = currentStep + 1;
      document.getElementById('total-steps').textContent = totalSteps + 1;
    }

    function focusStep(step) {
      if (!step) return;
      const heading = step.querySelector('h2, h3, legend, .question-title');
      if (heading) {
        heading.setAttribute('tabindex', '-1');
        heading.focus({ preventScroll: true });
      } else {
        step.querySelector('input, button, textarea')?.focus({ preventScroll: true });
      }
    }

    function nextStep() {
      const currentStepEl = document.querySelector(`.step[data-step="${currentStep}"]`);
      const selectedAnswer = currentStepEl?.querySelector('input[type="radio"]:checked');

      if (currentStep > 0 && currentStep < 5 && !selectedAnswer) {
        alert('Пожалуйста, выберите ответ');
        return;
      }

      if (selectedAnswer) {
        testData[selectedAnswer.name] = selectedAnswer.value;
      }

      document.querySelector(`.step[data-step="${currentStep}"]`)?.classList.remove('active');
      currentStep++;
      const shownStep = document.querySelector(`.step[data-step="${currentStep}"]`);
      shownStep?.classList.add('active');
      // Фокус стоял на кнопке, которая уехала в скрытый шаг: без переноса
      // он падал на body, и следующий Tab начинался с шапки сайта.
      focusStep(shownStep);

      updateProgress();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function prevStep() {
      document.querySelector(`.step[data-step="${currentStep}"]`)?.classList.remove('active');
      currentStep--;
      const backStep = document.querySelector(`.step[data-step="${currentStep}"]`);
      backStep?.classList.add('active');
      focusStep(backStep);

      updateProgress();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    async function sendTest(data) {
      const answers = Object.entries(data)
        .filter(([k]) => !['name', 'parentName', 'childName', 'phone', 'email', 'comment'].includes(k))
        .map(([k, v]) => `${k}: ${v}`)
        .join('; ');

      try {
        const response = await fetch('https://formsubmit.co/ajax/lyapina_sorokina@mail.ru', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            _subject: 'Результат теста с сайта — родитель',
            _template: 'table',
            _captcha: 'false',
            'Имя родителя': data.parentName || data.name || '—',
            'Имя ребёнка': data.childName || '—',
            'Телефон': data.phone || '—',
            'Email': data.email || '—',
            'Комментарий': data.comment || '—',
            'Ответы': answers || '—',
            'Источник': 'Тест для родителей',
          }),
        });
        const body = await response.json().catch(() => null);
        if (!response.ok || !body || String(body.success) !== 'true') {
          throw new Error('Заявка не принята');
        }
      } catch (err) {
        const note = document.getElementById('test-send-note');
        if (note) {
          note.innerHTML =
            'Не получилось отправить ответы. Позвоните нам: ' +
            '<a href="tel:+79151955132">+7 (915) 195-51-32</a>';
        }
      }
    }

    async function submitTest() {
      const name = document.getElementById('parent-name')?.value;
      const phone = document.getElementById('parent-phone')?.value;
      const childName = document.getElementById('child-name')?.value;

      if (!name || !phone) {
        alert('Пожалуйста, заполните обязательные поля');
        return;
      }

      // Кнопка теста не отправляет форму, поэтому required у чекбокса
      // браузер не проверит — проверяем сами.
      const consent = document.querySelector('.step.active input[name="privacy"]');
      if (consent && !consent.checked) {
        alert('Пожалуйста, подтвердите согласие на обработку персональных данных');
        consent.focus();
        return;
      }

      // name читается отправкой как имя родителя: раньше поле оставалось пустым,
      // и в письме «Имя» всегда было прочерком, а имена ехали внутри строки ответов.
      testData.name = name;
      testData.parentName = name;
      testData.phone = phone;
      testData.childName = childName;

      // Сначала показываем экран благодарности, потом ждём ответ сервиса:
      // если он откажет, плашка с телефоном появится уже на видимом экране.
      nextStep();
      await sendTest(testData);
    }

    // Добавляем обработчики на все кнопки
    document.querySelectorAll('[data-action="next"]').forEach(btn => {
      btn.addEventListener('click', nextStep);
    });

    document.querySelectorAll('[data-action="prev"]').forEach(btn => {
      btn.addEventListener('click', prevStep);
    });

    document.querySelectorAll('[data-action="submit"]').forEach(btn => {
      btn.addEventListener('click', submitTest);
    });

    updateProgress();
  });
</script>
