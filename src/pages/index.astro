  <script is:inline>
    function openVideoModal() {
      const modal = document.getElementById('videoModal');
      const video = document.getElementById('modalVideo');

      if (modal && video) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        video.volume = 0.1;
        video.play();
      }
    }

    function closeVideoModal(event) {
      if (event && event.target.id !== 'videoModal') {
        return;
      }

      const modal = document.getElementById('videoModal');
      const video = document.getElementById('modalVideo');

      if (modal && video) {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        document.body.style.overflow = '';
        video.pause();
        video.currentTime = 0;
      }
    }

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        closeVideoModal();
      }
    });
  </script>

  <!-- Раскрытие карточек с запросами -->
  <script is:inline>
    function initAccordion() {
      document.querySelectorAll('.accordion-card').forEach(function (card) {
        var head = card.querySelector('.card-head');
        var content = card.querySelector('.accordion-content');
        if (!head || !content || head.dataset.bound) return;
        head.dataset.bound = '1';

        // по тексту секции карточка кликабельна целиком, поэтому ловим клик и мимо шапки
        card.addEventListener('click', function (e) {
          if (e.target.closest('.card-head') || e.target.closest('.card-cta')) return;
          head.click();
        });

        head.addEventListener('click', function () {
          var isOpen = card.classList.contains('is-open');

          document.querySelectorAll('.accordion-card.is-open').forEach(function (other) {
            if (other === card) return;
            other.classList.remove('is-open');
            var oc = other.querySelector('.accordion-content');
            var oh = other.querySelector('.card-head');
            var oi = other.querySelector('.accordion-icon');
            if (oc) { oc.style.maxHeight = '0px'; oc.setAttribute('inert', ''); }
            if (oh) oh.setAttribute('aria-expanded', 'false');
            if (oi) oi.style.transform = 'rotate(0deg)';
          });

          var icon = card.querySelector('.accordion-icon');
          if (isOpen) {
            card.classList.remove('is-open');
            content.style.maxHeight = '0px';
            content.setAttribute('inert', '');
            head.setAttribute('aria-expanded', 'false');
            if (icon) icon.style.transform = 'rotate(0deg)';
          } else {
            card.classList.add('is-open');
            content.removeAttribute('inert');
            content.style.maxHeight = content.scrollHeight + 'px';
            head.setAttribute('aria-expanded', 'true');
            if (icon) icon.style.transform = 'rotate(180deg)';
          }
        });
      });
    }

    // при смене ширины высота раскрытой карточки пересчитывается
    var accResizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(accResizeTimer);
      accResizeTimer = setTimeout(function () {
        document.querySelectorAll('.accordion-card.is-open .accordion-content').forEach(function (c) {
          c.style.maxHeight = c.scrollHeight + 'px';
        });
      }, 150);
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAccordion);
    } else {
      initAccordion();
    }

    document.addEventListener('astro:page-load', initAccordion);
  </script>

  <ScrollAnimations />
</Layout>

