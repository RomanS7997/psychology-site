---
// Главная страница
import Layout from '../layouts/Layout.astro';
import NewHero from '../components/NewHero.astro';
import SEO from '../components/SEO.astro';
import FAQ from '../components/FAQ.astro';
import ScrollAnimations from '../components/ScrollAnimations.astro';
import { url } from '../utils/url';
import Icon from '../components/Icon.astro';

// Запросы, с которыми обращаются. Раскрываются по клику.
const requests = [
  {
    icon: 'calm',
    title: 'Тревожное расстройство',
    items: ['Панические атаки', 'Тревога', 'Навязчивые мысли и постоянное беспокойство', 'Специфические фобии'],
    text: 'Использую когнитивно-поведенческую терапию (КПТ), дыхательные техники и ДПДГ. Первые изменения обычно заметны после 3–4 встреч.',
  },
  {
    icon: 'bond',
    title: 'Проблемы в отношениях',
    items: ['Конфликты и непонимание в паре', 'Ревность, недоверие, контроль', 'Измена и восстановление доверия', 'Подготовка к разводу или его переживание'],
    text: 'Семейная терапия помогает наладить общение, восстановить близость или принять решение о расставании бережно для обеих сторон.',
    featured: true,
  },
  {
    icon: 'child',
    title: 'Поведение ребёнка',
    items: ['Истерики, непослушание, протесты', 'Агрессия, драки, конфликты', 'Проблемы с учёбой и мотивацией', 'Адаптация к садику или школе'],
    text: 'Работаю с ребёнком через игру и арт-терапию. Обязательно консультирую родителей по выстраиванию границ и воспитанию.',
  },
  {
    icon: 'worth',
    title: 'Низкая самооценка',
    items: ['Неуверенность в себе', 'Негативные мысли о себе', 'Страх оценки и критики', 'Постоянное сравнение с другими'],
    text: 'Работаем над здоровой самооценкой через выявление и изменение убеждений, которые мешают. Учу самоподдержке и принятию себя.',
  },
  {
    icon: 'compass',
    title: 'Возрастной кризис',
    items: ['Ощущение пустоты', 'Потеря смысла и цели в жизни', 'Профессиональное выгорание'],
    text: 'Помогаю найти новые смыслы, переосмыслить пройденный путь и наметить направление. Кризис — это возможность для роста.',
  },
  {
    icon: 'book',
    title: 'Развивающие программы',
    items: [
      '«Умники и умницы», 4–6 лет',
      '«Азбука общения», 5–9 лет',
      '«Подготовка к школе», 6–7 лет',
      'Малые группы, занятия ведут педагоги',
    ],
    text: 'Занятия проходят в малых группах до 8 детей. Программу подбираю под возраст и готовность ребёнка.',
  },
];

const programs = [
  {
    name: 'Умники и умницы',
    age: '4–6 лет',
    note: 'Ежедневно, будние дни',
    items: ['Чтение и развитие речи', 'Постановка руки к письму', 'Основы математики', 'Группы до 8 детей'],
    href: url('/programs/umniky'),
    photo: '/images/gallery/umniky/2.jpg',
  },
  {
    name: 'Азбука общения',
    age: '5–9 лет',
    note: 'Раз в неделю',
    items: ['Эмоциональный интеллект', 'Навыки общения', 'Уверенность в себе', 'Ролевые игры'],
    href: url('/programs/azbuka'),
    photo: '/images/gallery/azbuka/4.jpg',
    featured: true,
  },
  {
    name: 'Подготовка к школе',
    age: '6–7 лет',
    note: 'Два раза в неделю',
    items: ['Чтение и письмо', 'Математика и счёт', 'Окружающий мир', 'Концентрация внимания'],
    href: url('/services/school-prep'),
    photo: '/images/gallery/school-prep/23.jpg',
  },
];

// Первая встреча — коротко. Подробности на странице консультирования взрослых.
const firstSession = [
  { icon: 'chat', title: 'Знакомство', text: 'Расскажу о себе и о том, как строю работу. Вы поймёте, комфортно ли вам со мной.' },
  { icon: 'note', title: 'Ваш запрос', text: 'Разберём, что происходит сейчас и что вы хотите изменить.' },
  { icon: 'compass', title: 'Диагностика', text: 'Оценю состояние, при необходимости предложу пройти тестирование.' },
  { icon: 'check', title: 'План работы', text: 'Скажу, какими методами буду работать и сколько примерно встреч потребуется.' },
];

const advantages = [
  { icon: 'flask', title: 'Научный подход', text: 'Арт-терапия, КПТ, МАК, ДПДГ, расстановки, системный подход в семейной терапии.' },
  { icon: 'team', title: 'Команда', text: 'Три педагога и психолог с высшим образованием и регулярным повышением квалификации.' },
  { icon: 'lock', title: 'Конфиденциальность', text: 'Информация с сессий не передаётся третьим лицам ни при каких условиях.' },
  { icon: 'screen', title: 'Онлайн и офлайн', text: 'Консультации по видеосвязи или лично в кабинете в Лесном городке.' },
  { icon: 'clock', title: 'Удобное расписание', text: 'Будни и выходные с 9:00 до 21:00 — подберём время под вашу занятость.' },
  { icon: 'price', title: 'Понятная стоимость', text: 'Консультация 55 минут — 6000 ₽. Фиксированная цена без скрытых доплат.' },
];

const specialists = [
  {
    name: 'Юлия Ляпина',
    role: 'Психолог, монтессори-педагог',
    photo: '/images/team/julia-lyapina.jpg',
    tags: ['Психологическая помощь', 'Развивающие занятия', 'Коррекция'],
    href: url('/specialists#specialist-1'),
    lead: true,
  },
  {
    name: 'Стрижкова Наталья Петровна',
    role: 'Педагог, репетитор начальных классов',
    photo: '/images/team/specialist-2.jpg',
    tags: ['Начальная школа', 'Коррекция', 'Подготовка к школе'],
    href: url('/specialists#specialist-4'),
  },
  {
    name: 'Власихина Людмила Степановна',
    role: 'Монтессори-педагог',
    photo: '/images/team/specialist-3.jpg',
    tags: ['Развивающие занятия', 'Подготовка к школе'],
    href: url('/specialists#specialist-2'),
  },
  {
    name: 'Евграфова Наталья Викторовна',
    role: 'Логопед, учитель русского языка',
    photo: '/images/team/evgrafova-natalia.jpg',
    tags: ['Логопедия', 'Русский язык', 'ОГЭ и ЕГЭ'],
    href: url('/specialists#specialist-3'),
  },
];

const posts = [
  {
    category: 'Тревожность',
    date: '15 января 2025',
    title: 'Как справиться с паническими атаками: практические техники',
    excerpt: 'Пять проверенных техник, которые помогут остановить паническую атаку и предотвратить её в будущем.',
    image: '/images/blog/panic-attacks.jpg',
    href: url('/blog/kak-spravitsya-s-panicheskimi-atakami'),
  },
  {
    category: 'Детская психология',
    date: '12 января 2025',
    title: 'Что делать, если ребёнок не слушается: 7 стратегий для родителей',
    excerpt: 'Почему дети перестают слушаться и как восстановить контакт без криков и наказаний.',
    image: '/images/blog/child-behavior.jpg',
    href: url('/blog/chto-delat-esli-rebenok-ne-slushaetsya'),
  },
  {
    category: 'Отношения',
    date: '10 января 2025',
    title: 'Как улучшить отношения с партнёром: 5 упражнений на каждый день',
    excerpt: 'Простые, но действенные упражнения для пар, которые хотят вернуть близость и понимание.',
    image: '/images/blog/relationships.jpg',
    href: url('/blog/kak-uluchshit-otnosheniya-s-partnerom'),
  },
];
---

<SEO
  title="Психолог в Одинцово и Лесном городке | Юлия Ляпина"
  description="Кабинет психолога Ляпина Юлия в Одинцово. Консультирование взрослых и детей, развивающие программы. Записаться онлайн."
  keywords="психолог Одинцово, психолог Лесной городок, психотерапия, консультации онлайн, детский психолог"
  schema="organization"
/>

<Layout
  title="Психолог в Одинцово и Лесном городке | Юлия Ляпина"
  description="Кабинет психолога Ляпина Юлия в Одинцово. Консультирование взрослых и детей, развивающие программы."
>

  <NewHero
    title="Кабинет психолога Ляпина Юлия"
    subtitle="Профессиональная психологическая помощь взрослым и детям. Семейная терапия и консультирование. Развивающие программы для детей 4–9 лет."
  />

  <!-- ============ Запросы ============ -->
  <section id="services" class="band">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head" data-reveal>
          <p class="eyebrow mb-3">Частые запросы</p>
          <h2 class="heading mb-4">С чем ко мне приходят</h2>
          <p class="lede max-w-[56ch]">
            Найдите ситуацию, похожую на вашу, и нажмите на карточку — расскажу,
            как я с этим работаю и сколько времени это обычно занимает.
          </p>
        </div>

        <div class="cards-3">
          {requests.map((item) => (
            <article
              class={`accordion-card ${item.featured ? 'gradient-card' : 'surface'}`}
              data-reveal
            >
              <div class="card-inner">
                <h3 class="card-heading">
                  <button class="card-head" type="button" aria-expanded="false">
                    <span class="card-icon"><Icon name={item.icon} size={22} /></span>
                    <span class="card-title">{item.title}</span>
                  <svg class="accordion-icon chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                </h3>

                <ul class="card-preview">
                  {item.items.slice(0, 2).map((li) => <li>{li}</li>)}
                </ul>

                <div class="accordion-content" inert>
                  <ul class="card-list">
                    {item.items.slice(2).map((li) => <li>{li}</li>)}
                  </ul>
                  <p class="card-text">{item.text}</p>
                  <button
                    onclick="openBookingModal()"
                    class={`pill ${item.featured ? 'pill-light' : 'pill-solid'} card-cta`}
                    type="button"
                  >
                    Записаться
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Как проходит первая встреча ============ -->
  <section class="band band-taupe">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head band-head-row" data-reveal>
          <div>
            <p class="eyebrow mb-3">Первая встреча</p>
            <h2 class="heading">Как всё будет проходить</h2>
          </div>
          <a href={url('/services/adult')} class="pill pill-outline">Подробнее о консультации</a>
        </div>

        <ol class="steps">
          {firstSession.map((step, i) => (
            <li class="step" data-reveal>
              <span class="step-num">0{i + 1}</span>
              <span class="step-icon"><Icon name={step.icon} size={20} /></span>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-text">{step.text}</p>
            </li>
          ))}
        </ol>

        <p class="steps-note" data-reveal>55 минут · онлайн или в кабинете в Лесном городке · 6000 ₽</p>
      </div>
    </div>
  </section>

  <!-- ============ Видео о кабинете ============ -->
  <section class="band band-tight">
    <div class="wide">
      <div class="inner-wide">
        <div class="glow-band video-band" data-reveal>
          <div class="video-grid">
            <button class="video-preview" onclick="openVideoModal()" type="button" aria-label="Смотреть видео о кабинете">
              <img src={url('/images/services/child-therapy.jpg')} alt="Кабинет психолога" loading="lazy" decoding="async" />
              <span class="video-play" aria-hidden="true">
                <Icon name="play" size={26} />
              </span>
            </button>

            <div>
              <p class="eyebrow mb-3">Видео</p>
              <h2 class="heading-sm mb-5">Добро пожаловать!</h2>
              <ul class="check-list mb-7">
                <li>Индивидуальный подход к каждому клиенту</li>
                <li>Современные научно обоснованные методы</li>
                <li>Комфортная атмосфера и конфиденциальность</li>
                <li>Онлайн и офлайн консультации</li>
              </ul>
              <button onclick="openBookingModal()" class="pill pill-solid" type="button">
                Записаться на консультацию
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Программы ============ -->
  <section id="programs" class="band">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head" data-reveal>
          <p class="eyebrow mb-3">Для детей</p>
          <h2 class="heading mb-4">Развивающие программы</h2>
          <p class="lede max-w-[56ch]">
            Готовим к школе, развиваем эмоциональный интеллект, учим общаться.
            Занятия ведут педагоги с профильным образованием.
          </p>
        </div>

        <div class="cards-3">
          {programs.map((program) => (
            <article class={`program-card lift ${program.featured ? 'gradient-card' : 'surface'}`} data-reveal>
              {program.photo && (
                <div class="program-photo">
                  <img src={url(program.photo)} alt={`Занятия «${program.name}»`} loading="lazy" decoding="async" />
                </div>
              )}
              <div class="card-inner">
                <div class="program-meta">
                  <span class="program-age">{program.age}</span>
                  <span class="program-note">{program.note}</span>
                </div>
                <h3 class="card-title mb-4">{program.name}</h3>
                <ul class="card-list mb-6">
                  {program.items.map((li) => <li>{li}</li>)}
                </ul>
                <a href={url(program.href)} class={`pill ${program.featured ? 'pill-light' : 'pill-outline'} program-link`}>
                  Подробнее о программе
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Почему выбирают ============ -->
  <section class="band band-taupe">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="why-grid">
          <div data-reveal>
            <p class="eyebrow mb-4">О работе</p>
            <h2 class="why-quote">
              Не держу клиентов годами в терапии — учу справляться с трудностями самостоятельно.
            </h2>
            <p class="why-sign">Юлия Ляпина, психолог</p>
          </div>

          <div class="why-list">
            {advantages.map((item) => (
              <div class="why-item" data-reveal>
                <h3 class="why-title"><Icon name={item.icon} size={19} />{item.title}</h3>
                <p class="why-text">{item.text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Специалисты ============ -->
  <section id="specialists" class="band">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head band-head-row" data-reveal>
          <div>
            <p class="eyebrow mb-3">Команда</p>
            <h2 class="heading">Кто с вами работает</h2>
          </div>
          <a href={url('/specialists')} class="pill pill-outline">Вся команда</a>
        </div>

        <div class="cards-4">
          {specialists.map((person) => (
            <article class="person lift" data-reveal>
              <div class="person-photo">
                <img src={url(person.photo)} alt={person.name} loading="lazy" decoding="async" />
                {person.lead && <span class="person-badge">Основатель</span>}
              </div>
              <h3 class="person-name">{person.name}</h3>
              <p class="person-role">{person.role}</p>
              <div class="person-tags">
                {person.tags.map((tag) => <span>{tag}</span>)}
              </div>
              <div class="person-actions">
                <button onclick="openBookingModal()" class="pill pill-solid person-btn" type="button">Записаться</button>
                <a href={url(person.href)} class="pill pill-outline person-btn">Подробнее</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Статьи ============ -->
  <section class="band band-taupe">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head band-head-row" data-reveal>
          <div>
            <p class="eyebrow mb-3">Блог</p>
            <h2 class="heading">Полезные статьи</h2>
          </div>
          <a href={url('/blog')} class="pill pill-outline">Все статьи</a>
        </div>

        <div class="cards-3">
          {posts.map((post) => (
            <a href={url(post.href)} class="post lift" data-reveal>
              <div class="post-photo">
                <img src={url(post.image)} alt={post.title} loading="lazy" decoding="async" />
              </div>
              <div class="post-body">
                <div class="post-meta">
                  <span class="post-cat">{post.category}</span>
                  <span>{post.date}</span>
                </div>
                <h3 class="post-title">{post.title}</h3>
                <p class="post-excerpt">{post.excerpt}</p>
                <span class="post-more">Читать <Icon name="arrow" size={16} /></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Вопросы ============ -->
  <div data-reveal>
    <FAQ
      title="Частые вопросы"
      subtitle="Ответы на то, о чём спрашивают перед первой встречей"
      items={[
        {
          question: "Как понять, нужен ли мне психолог?",
          answer: "Если вы чувствуете, что не справляетесь с эмоциями, испытываете постоянный стресс, тревогу или проблемы в отношениях — это повод обратиться к психологу. Также стоит прийти, если вы просто хотите лучше понять себя и свои реакции."
        },
        {
          question: "Что если психолог мне не подойдёт?",
          answer: "Это нормально, и решать вам. Первая встреча ни к чему не обязывает: на ней вы посмотрите, комфортно ли вам со мной, и только потом решите, продолжать ли. Если почувствую, что ваш запрос за пределами моей специализации, скажу об этом прямо и подскажу, к какому специалисту обратиться."
        },
        {
          question: "Сколько сессий мне потребуется?",
          answer: "Это зависит от запроса. Первые изменения обычно после 3-4 встреч, работа с конкретным запросом занимает 8-12 сессий. Примерную длительность назову уже на первой консультации."
        },
        {
          question: "Чем психолог отличается от психотерапевта и психиатра?",
          answer: "Психолог работает с эмоциями и поведением здоровых людей. Психотерапевт имеет дополнительное образование для работы с более серьезными проблемами. Психиатр — врач, который может назначать лекарства. Наши специалисты подскажут, если потребуется консультация психиатра."
        },
        {
          question: "Как проходит онлайн-консультация?",
          answer: "Онлайн-консультация проходит по видеосвязи (Zoom, Skype). Вам нужны устройство с камерой, микрофоном и стабильный интернет. Эффективность онлайн-терапии доказана исследованиями и не уступает личным встречам."
        },
        {
          question: "Насколько конфиденциальна информация с сессий?",
          answer: "Абсолютно конфиденциальна. Психологи соблюдают профессиональную тайну. Информация с сессий не передается третьим лицам, включая родственников (если только вы сами не дадите на это согласие)."
        },
        {
          question: "Можно ли прийти с ребенком?",
