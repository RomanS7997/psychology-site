---
// src/pages/privacy.astro — политика конфиденциальности
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SEO from '../components/SEO.astro';
import ScrollAnimations from '../components/ScrollAnimations.astro';
import Icon from '../components/Icon.astro';
import { url } from '../utils/url';
---

<SEO
  title="Политика конфиденциальности | Кабинет психолога Ляпина Юлия"
  description="Политика конфиденциальности и обработки персональных данных на сайте кабинета психолога."
/>

<Layout
  title="Политика конфиденциальности | Кабинет психолога Ляпина Юлия"
  description="Политика конфиденциальности и обработки персональных данных"
>

  <Breadcrumbs
    items={[
      { label: 'Главная', href: url('/') },
      { label: 'Политика конфиденциальности' }
    ]}
  />

  <!-- ============ Шапка документа ============ -->
  <section class="page-hero">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="column" data-reveal>
        <p class="eyebrow mb-4">Документы</p>
        <h1 class="display mb-5">Политика конфиденциальности</h1>
        <p class="doc-date">Последнее обновление: 18 ноября 2025 года</p>
      </div>
    </div>
  </section>

  <!-- ============ Текст политики ============ -->
  <section class="band band-text">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="column">

        <div class="note" data-reveal>
          <span class="note-mark"><Icon name="lock" size={20} /></span>
          <p class="note-text">
            Настоящая Политика конфиденциальности персональных данных (далее — Политика) действует
            в отношении всей информации, которую Кабинет психолога Ляпина Юлия может получить
            о пользователе во время использования сайта julialyapina.ru.
          </p>
        </div>

        <div class="prose">

          <section data-reveal>
            <h2>1. Термины и определения</h2>

            <p><strong>Персональные данные</strong> — любая информация, относящаяся к прямо или косвенно
            определенному или определяемому физическому лицу (субъекту персональных данных).</p>

            <p><strong>Оператор персональных данных</strong> — Кабинет психолога Ляпина Юлия,
            самостоятельно или совместно с другими лицами организующий и/или осуществляющий обработку
            персональных данных.</p>

            <p><strong>Обработка персональных данных</strong> — любое действие (операция) или совокупность
            действий с персональными данными.</p>
          </section>

          <section data-reveal>
            <h2>2. Какие данные мы собираем</h2>

            <p>При использовании сайта мы можем запрашивать и собирать следующую информацию:</p>

            <ul>
              <li><strong>Имя и фамилия</strong> — для обращения к вам</li>
              <li><strong>Номер телефона</strong> — для связи и подтверждения записи</li>
              <li><strong>Адрес электронной почты</strong> — для отправки подтверждений и информации</li>
              <li><strong>Возраст ребенка</strong> (при записи на детские программы)</li>
              <li><strong>Комментарии и вопросы</strong>, которые вы оставляете в формах</li>
              <li><strong>Ответы на тестах</strong> на сайте — включая сведения о самочувствии
                  и о поведении ребёнка, если вы проходите тест для родителей</li>
              <li><strong>Имя ребёнка</strong> — если вы указали его при прохождении теста</li>
              <li><strong>IP-адрес</strong> и данные о браузере (автоматически)</li>
              <li><strong>Cookies</strong> для улучшения работы сайта</li>
            </ul>
          </section>

          <section data-reveal>
            <h2>3. Цели обработки данных</h2>

            <p>Мы используем ваши персональные данные для:</p>

            <ul>
              <li>Обработки заявок на консультации и программы</li>
              <li>Связи с вами для подтверждения записи</li>
              <li>Отправки информации об услугах и программах</li>
              <li>Улучшения качества сайта и услуг</li>
              <li>Выполнения обязательств по договору об оказании услуг</li>
              <li>Аналитики посещаемости сайта</li>
            </ul>
          </section>

          <section data-reveal>
            <h2>4. Правовые основания обработки</h2>

            <p>Обработка персональных данных осуществляется на основании:</p>

            <ul>
              <li>Федерального закона от 27.07.2006 № 152-ФЗ «О персональных данных»</li>
              <li>Вашего согласия на обработку персональных данных</li>
              <li>Договора об оказании психологических услуг</li>
            </ul>
          </section>

          <section data-reveal>
            <h2>5. Защита данных</h2>

            <p>Мы принимаем необходимые меры для защиты ваших персональных данных:</p>

            <ul>
              <li>Использование защищенного соединения (HTTPS)</li>
              <li>Сайт не хранит заявки у себя: заполненная форма сразу уходит
                  на электронную почту психолога и на сайте не остаётся</li>
              <li>Доступ к переписке есть только у психолога</li>
              <li>Мы запрашиваем минимум данных — только то, что нужно, чтобы
                  связаться с вами и подготовиться к встрече</li>
            </ul>
          </section>

          <section data-reveal>
            <h2>6. Передача данных третьим лицам</h2>

            <p>Мы не передаем ваши персональные данные третьим лицам, за исключением случаев:</p>

            <ul>
              <li>Вы дали явное согласие на передачу</li>
              <li>Передача нужна, чтобы доставить нам вашу заявку (см. ниже)</li>
              <li>Передача предусмотрена российским законодательством</li>
            </ul>

            <p><strong>Как до нас доходит заполненная форма.</strong> Все формы на сайте —
            запись на консультацию, форма на странице «Контакты» и формы в конце тестов —
            отправляются через стороннюю службу доставки писем
            <a href="https://formsubmit.co" target="_blank" rel="noopener nofollow">formsubmit.co</a>.
            Ей передаётся то, что вы ввели в форму: имя, телефон, электронная почта,
            комментарий, а для тестов — ещё и выбранные вами ответы. Служба пересылает
            это письмом на почту психолога и не использует данные для своих целей.
            Если вы не хотите, чтобы данные проходили через посредника, — просто позвоните
            нам по телефону <a href="tel:+79151955132">+7 (915) 195-51-32</a>.</p>

            <p>Мы можем использовать сервисы аналитики (Google Analytics, Яндекс.Метрика),
            которые собирают анонимные данные о посещениях сайта.</p>
          </section>

          <section data-reveal>
            <h2>7. Срок хранения данных</h2>

            <p>Ваши персональные данные хранятся в течение срока, необходимого для достижения
            целей обработки, но не более 3 лет с момента последнего взаимодействия.</p>
          </section>

          <section data-reveal>
            <h2>8. Ваши права</h2>

            <p>Вы имеете право:</p>

            <ul>
              <li>Получать информацию об обработке ваших персональных данных</li>
              <li>Требовать уточнения, блокирования или удаления данных</li>
              <li>Отозвать согласие на обработку данных</li>
              <li>Обжаловать действия оператора в Роскомнадзоре или суде</li>
            </ul>
          </section>

          <section data-reveal>
            <h2>9. Cookies</h2>

            <p>Сайт использует файлы cookies для:</p>

            <ul>
              <li>Запоминания ваших предпочтений</li>
              <li>Аналитики посещаемости</li>
              <li>Улучшения работы сайта</li>
            </ul>

            <p>Вы можете отключить cookies в настройках браузера, но это может ограничить
            функциональность сайта.</p>
          </section>

          <section data-reveal>
            <h2>10. Изменения в политике</h2>

            <p>Мы оставляем за собой право вносить изменения в настоящую Политику конфиденциальности.
            Актуальная версия всегда доступна на этой странице.</p>
          </section>

          <section data-reveal>
            <h2>11. Контактная информация</h2>

            <div class="contact-card">
              <p class="contact-lead">Если у вас есть вопросы по обработке персональных данных,
              свяжитесь с нами:</p>

              <ul class="contact-list">
                <li>
                  <span class="contact-mark"><Icon name="phone" size={18} /></span>
                  <span class="contact-label">Телефон:</span>
                  <a href="tel:+79151955132" class="contact-value">+7 (915) 195-51-32</a>
                </li>
                <li>
                  <span class="contact-mark"><Icon name="mail" size={18} /></span>
                  <span class="contact-label">Email:</span>
                  <a href="mailto:lyapina_sorokina@mail.ru" class="contact-value">lyapina_sorokina@mail.ru</a>
                </li>
                <li>
                  <span class="contact-mark"><Icon name="pin" size={18} /></span>
                  <span class="contact-label">Адрес:</span>
                  <span class="contact-value">Одинцово, Лесной городок, Московская область</span>
                </li>
              </ul>
            </div>
          </section>

        </div>

        <div class="accept" data-reveal>
          <span class="accept-mark"><Icon name="check" size={18} /></span>
          <p class="accept-text">
            Используя наш сайт, вы соглашаетесь с условиями настоящей Политики конфиденциальности
          </p>
        </div>

      </div>
    </div>
  </section>

  <ScrollAnimations />
</Layout>

<style>
  /* ---------- ритм секций ---------- */
  .band { padding: 96px 0; }
  .band-text { padding: 48px 0 96px; }

  /* Колонка чтения: одна ширина у шапки и у текста */
  .column { max-width: 780px; margin: 0 auto; }

  /* Шапка сайта закреплена (высота 96px) — крошки не должны уходить под неё */

  /* ---------- шапка документа ---------- */
  .page-hero { padding: 28px 0 0; background: var(--canvas); }
  .doc-date { font-size: 14px; color: var(--ash); }

  /* ---------- врезка ---------- */
  .note {
    display: flex; gap: 14px; margin: 0 0 44px;
    padding: 24px; background: var(--taupe);
    border: 1px solid var(--stone); border-radius: var(--r-card);
  }
  .note-mark {
    flex-shrink: 0; width: 36px; height: 36px; border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(47, 125, 150, 0.1); color: var(--spark-deep);
  }
  .note-text { font-size: 15px; line-height: 1.65; color: var(--graphite); margin: 0; }

  /* ---------- текст документа ---------- */
  /* Строка держится в районе 70 знаков: при 780px она уходила за 95,
     и глаз терял начало следующей строки. */
  .prose { color: var(--graphite); font-size: 16.5px; line-height: 1.75; }
  .prose > p,
  .prose > ul,
  .prose > ol { max-width: 68ch; }

  .prose h2 {
    font-size: clamp(21px, 2.2vw, 26px); font-weight: 300;
    line-height: 1.2; letter-spacing: -0.02em; color: var(--ink);
    margin: 0 0 18px; scroll-margin-top: 112px;
  }

  .prose > section { padding-top: 44px; border-top: 1px solid var(--stone); margin-top: 44px; }
  .prose > section:first-child { padding-top: 0; border-top: 0; margin-top: 0; }

  .prose p { margin: 0 0 18px; }
  .prose p:last-child { margin-bottom: 0; }

  .prose ul {
    list-style: none; margin: 0 0 22px; padding: 0; display: grid; gap: 10px;
  }
  .prose ul:last-child { margin-bottom: 0; }
  .prose li { position: relative; padding-left: 26px; }
  .prose ul > li::before {
    content: ""; position: absolute; left: 4px; top: 11px;
    width: 5px; height: 5px; border-radius: 50%; background: var(--spark-deep);
  }

  .prose strong { color: var(--ink); font-weight: 500; }

  /* ---------- контакты ---------- */
  .contact-card {
    padding: 26px 24px; background: var(--taupe);
    border: 1px solid var(--stone); border-radius: var(--r-card);
  }
  .contact-lead {
    font-size: 15px; line-height: 1.6; color: var(--ink);
    font-weight: 500; margin: 0 0 18px;
  }
  .contact-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .contact-list li {
    display: flex; align-items: center; flex-wrap: wrap; gap: 10px;
    padding-left: 0; font-size: 15px;
  }
  .contact-list li::before { content: none; }
  .contact-mark {
    flex-shrink: 0; width: 32px; height: 32px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    background: var(--canvas); border: 1px solid var(--stone); color: var(--spark-deep);
  }
  .contact-label { color: var(--smoke); }
  .contact-value { color: var(--ink); transition: color .2s ease; }
  a.contact-value:hover { color: var(--spark-deep); }

  /* ---------- согласие ---------- */
  .accept {
    display: flex; align-items: center; gap: 14px;
    margin-top: 48px; padding: 22px 24px;
    background: var(--canvas);
    border: 1px solid var(--stone); border-radius: var(--r-card);
  }
  .accept-mark {
    flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: rgba(47, 125, 150, 0.1); color: var(--spark-deep);
  }
  .accept-text { font-size: 15px; line-height: 1.6; color: var(--ink); margin: 0; }

  /* ---------- адаптив ---------- */
  @media (max-width: 767px) {
    .band { padding: 64px 0; }
    .band-text { padding: 36px 0 64px; }
    .page-hero { padding: 20px 0 0; }
    .prose { font-size: 16px; }
    .prose > section { padding-top: 36px; margin-top: 36px; }
    .note { padding: 20px; margin-bottom: 36px; }
    .contact-card { padding: 22px 20px; }
    .accept { padding: 20px; }
  }
</style>
