---
// src/pages/services/adult.astro — консультирование взрослых
import Layout from '../../layouts/Layout.astro';
import { HERO_SIZES, webpSet } from '../../utils/img';
import ScrollAnimations from '../../components/ScrollAnimations.astro';
import FAQ from '../../components/FAQ.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SEO from '../../components/SEO.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../utils/url';

// Как проходит первая консультация — пять шагов встречи
const steps = [
  {
    icon: 'chat',
    title: 'Знакомство',
    text: 'Расскажу о себе, своём подходе и правилах работы. Вы оцените, комфортно ли вам со мной.',
  },
  {
    icon: 'note',
    title: 'Запрос и история',
    text: 'Вы расскажете, что вас привело и какие трудности испытываете. Задам уточняющие вопросы о вашей истории.',
  },
  {
    icon: 'compass',
    title: 'Диагностика',
    text: 'Оценю ваше состояние, при необходимости предложу пройти тестирование (шкалы тревоги).',
  },
  {
    icon: 'check',
    title: 'План терапии',
    text: 'Предложу план работы: какие методы будут использоваться, сколько примерно потребуется сессий, какие результаты ожидать.',
  },
  {
    icon: 'arrow',
    title: 'Вопросы и следующие шаги',
    text: 'Вы можете задать любые вопросы о терапии. Если решите продолжить, договоримся о следующей встрече.',
  },
];

const formatItems = [
  'Работа один на один с психологом',
  'Онлайн или офлайн',
  'Полная конфиденциальность',
  'Индивидуальный план терапии',
];

const related = [
  {
    icon: 'child',
    title: 'Индивидуальные занятия с детьми',
    text: 'Помощь детям и подросткам в развитии и преодолении трудностей',
    href: url('/services/children'),
  },
  {
    icon: 'book',
    title: 'Умники и умницы',
    text: 'Комплексная подготовка к школе для детей 4–6 лет',
    href: url('/programs/umniky'),
  },
  {
    icon: 'note',
    title: 'Как справиться с паническими атаками',
    text: 'Полезная статья в моём блоге',
    href: url('/blog/kak-spravitsya-s-panicheskimi-atakami'),
  },
];
---

<SEO
  title="Психолог для взрослых в Одинцово | Очно и онлайн"
  description="Помощь психолога взрослым в Одинцово. Работа с тревогой, прокрастинацией, кризисами, отношениями. Консультации онлайн и офлайн. Запись по телефону."
  keywords="психолог для взрослых Одинцово, психотерапия, консультация психолога онлайн, работа с тревогой"
  schema="service"
/>

<Layout
  title="Психолог для взрослых в Одинцово | Очно и онлайн"
  description="Помощь психолога взрослым в Одинцово. Работа с тревогой, прокрастинацией, кризисами, отношениями."
>

  <Breadcrumbs
    items={[
      { label: 'Главная', href: url('/') },
      { label: 'Услуги', href: url('/#services') },
      { label: 'Консультирование взрослых' }
    ]}
  />

  <!-- ============ Первый экран ============ -->
  <section class="page-hero">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner hero-grid">

        <div>
          <p class="eyebrow mb-4 rise">Консультирование взрослых</p>

          <h1 class="display mb-5 rise rise-2">
            Психологическое консультирование для взрослых
          </h1>

          <p class="lede mb-8 max-w-[46ch] rise rise-3">
            Помогу разобраться в себе, преодолеть трудности и найти внутренние ресурсы
            для счастливой жизни
          </p>

          <div class="flex flex-wrap gap-3 mb-11 rise rise-4">
            <button onclick="openBookingModal('adult')" class="pill pill-solid pill-lg" type="button">
              Записаться на консультацию
            </button>
          </div>

          <div class="hairline pt-6 hero-facts rise rise-4">
            <div>
              <div class="hero-figure">55 мин</div>
              <div class="hero-label">длительность сессии</div>
            </div>
            <div>
              <div class="hero-figure">6000 ₽</div>
              <div class="hero-label">стоимость консультации</div>
            </div>
          </div>
        </div>

        <div class="hero-visual orb surface-lg rise rise-2">
          <picture>
  <source srcset={webpSet('/images/services/adult-consulting.jpg')} type="image/webp" sizes={HERO_SIZES} />
  <img src={url('/images/services/adult-consulting.jpg')} alt="Консультация психолога" class="hero-portrait" loading="eager" fetchpriority="high" decoding="async" />
</picture>
        </div>

      </div>
    </div>
  </section>

  <!-- ============ Как проходит первая консультация ============ -->
  <section class="band">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head" data-reveal>
          <p class="eyebrow mb-3">Первая встреча</p>
          <h2 class="heading mb-4">Как проходит первая консультация</h2>
          <p class="lede max-w-[56ch]">Подробный план нашей первой встречи</p>
        </div>

        <div class="timeline" data-reveal>
          <span class="timeline-track" aria-hidden="true"></span>
          <span class="timeline-line" data-progress-line style="height: 0%" aria-hidden="true"></span>

          <ol class="timeline-list">
            {steps.map((step, i) => (
              <li class="tl-item" data-reveal>
                <span class="tl-num">0{i + 1}</span>
                <div class="tl-card surface">
                  <h3 class="tl-title">
                    <span class="tl-icon"><Icon name={step.icon} size={19} /></span>
                    {step.title}
                  </h3>
                  <p class="tl-text">{step.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Формат консультации ============ -->
  <section class="band band-taupe">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="format-grid">
          <div data-reveal>
            <p class="eyebrow mb-3">Формат</p>
            <h2 class="heading mb-4">Формат консультации</h2>
            <p class="lede max-w-[42ch]">Индивидуальный подход к каждому клиенту</p>
          </div>

          <div class="format-card" data-reveal>
            <h3 class="format-title">Индивидуальная консультация</h3>
            <p class="format-note">Длительность — 55 минут</p>
            <ul class="check-list">
              {formatItems.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Вопросы ============ -->
  <div data-reveal>
    <FAQ
      title="Часто задаваемые вопросы"
      subtitle="Ответы на вопросы о консультировании взрослых"
      items={[
        {
          question: "Как понять, нужен ли мне психолог?",
          answer: "Если вы испытываете постоянный дискомфорт, трудности в отношениях, тревогу, апатию или просто хотите лучше понять себя — это уже достаточная причина обратиться к психологу. Не обязательно ждать серьезного кризиса."
        },
        {
          question: "Сколько сессий мне понадобится?",
          answer: "Это индивидуально. При работе с конкретным запросом (например, тревогой) может быть достаточно 8-12 сессий. Глубинная работа с личностными паттернами может занять 6-12 месяцев. Первые изменения вы заметите уже после 3-4 встреч."
        },
        {
          question: "В чем разница между психологом и психотерапевтом?",
          answer: "Психолог — это специалист с психологическим образованием. Психотерапевт — психолог с дополнительной подготовкой в определённом методе терапии (например, КПТ, арт-терапия). Имею дополнительную подготовку в нескольких методах психотерапии."
        },
        {
          question: "Можно ли проводить консультации онлайн?",
          answer: "Да, провожу как очные, так и онлайн-консультации. Эффективность онлайн-терапии не уступает очной, если у вас есть стабильный интернет и комфортное место для разговора."
        },
        {
          question: "Гарантируется ли конфиденциальность?",
          answer: "Абсолютно. Всё, что вы говорите на сессии, останется между вами и мной. Это зафиксировано в этическом кодексе психолога."
        },
        {
          question: "Что делать, если не подошел психолог?",
          answer: "Это нормально и случается редко. Контакт с психологом — важная часть терапии. На первичной консультации вы сможете понять, подходит ли вам мой стиль работы. Если почувствуете, что хотели бы другого специалиста — порекомендую проверенных коллег."
        }
      ]}
    />
  </div>

  <!-- ============ Финальный призыв ============ -->
  <section class="band band-tight">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="glow-band closing-band" data-reveal>
          <p class="eyebrow eyebrow-center mb-4">Запись</p>
          <h2 class="heading mb-4">Готовы начать работу над собой?</h2>
          <p class="lede mb-8">Запишитесь на консультацию прямо сейчас</p>

          <div class="cta-actions">
            <button onclick="openBookingModal('adult')" class="pill pill-solid pill-lg" type="button">
              Записаться на консультацию
            </button>
          </div>

          <p class="cta-phone">
            <Icon name="phone" size={16} />
            <span>Или позвоните: <a href="tel:+79151955132">+7 (915) 195-51-32</a></span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Смотрите также ============ -->
  <section class="band band-taupe">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head" data-reveal>
          <p class="eyebrow mb-3">Ещё по теме</p>
          <h2 class="heading">Вам также может быть интересно</h2>
        </div>

        <div class="cards-3">
          {related.map((item) => (
            <a href={url(item.href)} class="rel-card lift" data-reveal>
              <span class="rel-icon"><Icon name={item.icon} size={22} /></span>
              <h3 class="rel-title">{item.title}</h3>
              <p class="rel-text">{item.text}</p>
              <span class="rel-more">Подробнее <Icon name="arrow" size={16} /></span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <ScrollAnimations />
</Layout>

<style>
  /* ---------- ритм секций ---------- */
  .band { padding: 96px 0; }
  .band-tight { padding: 24px 0 96px; }


  /* ---------- первый экран ---------- */
  /* Крошки идут первыми, поэтому отступ под закреплённой шапкой задаём им */

  .page-hero { padding: 28px 0 88px; background: var(--canvas); }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: 64px;
    align-items: center;
  }

  /* Появление первого экрана — чистый CSS, без наблюдателя:
     что бы ни случилось со скриптами, текст будет виден */
  .rise { animation: hero-rise .6s cubic-bezier(.2, .7, .3, 1) both; }
  .rise-2 { animation-delay: .07s; }
  .rise-3 { animation-delay: .14s; }
  .rise-4 { animation-delay: .21s; }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise { animation: none; }
  }

  .hero-facts { display: flex; flex-wrap: wrap; gap: 40px; }
  .hero-figure {
    font-size: 27px;
    font-weight: 300;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    margin-bottom: 2px;
    color: var(--ink);
  }
  .hero-label { font-size: 13px; line-height: 1.45; color: var(--smoke); max-width: 15ch; }

  .hero-visual { aspect-ratio: 1 / 1.02; }

  /* Фото стоит на нижней кромке оправы, градиент светится вокруг */
  .hero-portrait {
    position: absolute;
    inset: 12% 10% 0 10%;
    z-index: 2;
    width: 80%;
    height: 88%;
    object-fit: cover;
    object-position: center top;
    border-radius: 18px 18px 0 0;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-bottom: 0;
  }

  /* ---------- таймлайн первой встречи ---------- */
  .timeline { position: relative; max-width: 880px; }

  /* Тонкая дорожка видна всегда, поверх неё нарастает цветная линия */
  .timeline-track,
  .timeline-line {
    position: absolute;
    left: 21px;
    top: 10px;
    width: 1px;
  }
  .timeline-track { bottom: 10px; background: var(--stone); }
  .timeline-line {
    height: 0;
    max-height: calc(100% - 20px);
    background: linear-gradient(180deg, var(--spark-water), var(--spark-deep-visual));
    transition: height 1.6s cubic-bezier(.2, .7, .3, 1);
  }

  .timeline-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
    position: relative;
  }

  .tl-item { display: flex; gap: 22px; align-items: flex-start; }

  .tl-num {
    flex-shrink: 0;
    width: 43px;
    height: 43px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--canvas);
    border: 1px solid var(--stone);
    color: var(--ash);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: .06em;
    font-variant-numeric: tabular-nums;
  }

  .tl-card { flex: 1; padding: 24px 26px; }

  .tl-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: -0.01em;
    margin-bottom: 10px;
  }
  .tl-icon {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(47, 125, 150, .1);
    color: var(--spark-deep);
  }
  .tl-text { font-size: 14.5px; line-height: 1.65; color: var(--smoke); }

  /* ---------- формат консультации ---------- */
  .format-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px;
    align-items: center;
  }

  .format-card {
    background: var(--canvas);
    border: 1px solid var(--stone);
    border-radius: var(--r-large);
    padding: 34px 36px;
  }
  .format-title { font-size: 20px; font-weight: 400; letter-spacing: -0.01em; margin-bottom: 6px; }
  .format-note {
    font-size: 14px;
    color: var(--ash);
    padding-bottom: 20px;
    margin-bottom: 22px;
    border-bottom: 1px solid var(--stone);
  }

  .check-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .check-list li {
    position: relative;
    padding-left: 26px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--graphite);
  }
  .check-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    width: 13px;
    height: 7px;
    border-left: 1.6px solid var(--spark-water);
    border-bottom: 1.6px solid var(--spark-water);
    transform: rotate(-45deg);
  }

  /* ---------- финальный призыв ---------- */
  .closing-band { padding: 56px 48px; text-align: center; }
  .closing-band .lede { max-width: 44ch; margin-inline: auto; }
  .cta-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .cta-phone {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 30px;
    padding-top: 22px;
    border-top: 1px solid var(--stone);
    font-size: 14px;
    color: var(--graphite);
  }
  .cta-phone :global(svg) { color: var(--graphite); flex-shrink: 0; }
  .cta-phone a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .cta-phone a:hover { text-decoration: none; }

  /* ---------- смотрите также ---------- */
  .rel-card {
    display: flex;
    flex-direction: column;
    background: var(--canvas);
    border: 1px solid var(--stone);
    border-radius: var(--r-card);
    padding: 28px;
    text-decoration: none;
    color: inherit;
    transition: transform .3s cubic-bezier(.2,.7,.3,1), border-color .25s ease;
  }
  .rel-card:hover { border-color: var(--ash); }

  .rel-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(47, 125, 150, .1);
    color: var(--spark-deep);
    margin-bottom: 18px;
  }
  .rel-title { font-size: 18px; font-weight: 400; line-height: 1.35; letter-spacing: -0.01em; margin-bottom: 9px; }
  .rel-text { font-size: 14px; line-height: 1.6; color: var(--smoke); margin-bottom: 18px; }
  .rel-more {
    margin-top: auto;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .rel-more :global(svg) { transition: transform .3s cubic-bezier(.2,.7,.3,1); }
  .rel-card:hover .rel-more :global(svg) { transform: translateX(3px); }

  /* ---------- адаптив ---------- */
  @media (max-width: 1023px) {
    .hero-grid { grid-template-columns: 1fr; gap: 44px; }
    .hero-visual { max-width: 440px; width: 100%; margin-inline: auto; }
    .format-grid { grid-template-columns: 1fr; gap: 36px; }
    .cards-3 { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 767px) {
    .band { padding: 64px 0; }
    .band-tight { padding: 8px 0 64px; }
    .page-hero { padding: 20px 0 64px; }
    .cards-3 { grid-template-columns: 1fr; }
    .hero-facts { gap: 28px; }
    .tl-item { gap: 14px; }
    .tl-card { padding: 22px; }
    .format-card { padding: 26px 24px; }
    .closing-band { padding: 32px 24px; }
  }
</style>
