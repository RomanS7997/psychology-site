---
// src/pages/services/school-prep.astro
import Layout from '../../layouts/Layout.astro';
import { HERO_SIZES, webpSet } from '../../utils/img';
import ScrollAnimations from '../../components/ScrollAnimations.astro';
import FAQ from '../../components/FAQ.astro';
import AutoGallerySlider from '../../components/AutoGallerySlider.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SEO from '../../components/SEO.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../utils/url';

// Отобранные фото для галереи (номера файлов в /images/gallery/school-prep/)
const galleryPhotos = [
  { n: 23, caption: 'Постановка руки и графомоторика' },
  { n: 32, caption: 'Учимся читать по слогам' },
  { n: 28, caption: 'Подготовка к письму' },
  { n: 38, caption: 'Складываем слова из слогов' },
  { n: 11, caption: 'Задания на внимание и логику' },
  { n: 27, caption: 'Работа в тетради' },
  { n: 21, caption: 'Конструирование' },
  { n: 34, caption: 'Развивающие игры' },
  { n: 20, caption: 'Физкультминутка' },
  { n: 6,  caption: 'Индивидуальные задания' },
];

const galleryImages = galleryPhotos.map(({ n, caption }) => ({
  src: url(`/images/gallery/school-prep/${n}.jpg`),
  alt: `Подготовка к школе — ${caption.toLowerCase()}`,
  caption
}));

// Что даёт программа — тексты заказчицы, менялось только оформление
const heroPoints = [
  'Обучение осмысленному чтению',
  'Навыки письма и постановка руки',
  'Математика',
  'Развитие логики, памяти и речи',
  'Расширение кругозора и знания об окружающем мире',
];

const programBlocks = [
  {
    icon: 'compass',
    title: 'Индивидуальная диагностика',
    text: 'Перед началом обучения проводим диагностику готовности к школе и выявляем особенности развития ребёнка',
  },
  {
    icon: 'child',
    title: 'Персональный подход',
    text: 'Учитываем индивидуальные особенности каждого ребёнка, темп развития и интересы',
  },
  {
    icon: 'note',
    title: 'Мнемотехника',
    text: 'Развитие памяти через специальные техники запоминания с помощью образов и ассоциаций',
  },
  {
    icon: 'flask',
    title: 'Нейропсихологические игры',
    text: 'Развитие межполушарного взаимодействия, внимания, концентрации и саморегуляции',
  },
  {
    icon: 'book',
    title: 'Обучение чтению',
    text: 'Освоение техники чтения, развитие речи, расширение словарного запаса',
  },
  {
    icon: 'send',
    title: 'Постановка руки к письму',
    text: 'Развитие мелкой моторики, графомоторных навыков, подготовка к письму',
  },
  {
    icon: 'check',
    title: 'Основы математики',
    text: 'Счёт, простые примеры, геометрические фигуры, логические задачи',
  },
  {
    icon: 'pin',
    title: 'Познавательные занятия',
    text: 'Еженедельные тематические занятия по окружающему миру, расширение кругозора',
  },
  {
    icon: 'calm',
    title: 'Психологическая подготовка',
    text: 'Формирование мотивации к обучению, работа со страхами, развитие уверенности',
  },
];

const results = [
  { icon: 'check', title: 'Готовность к первому классу' },
  { icon: 'book', title: 'Уверенный старт в учёбе' },
  { icon: 'calm', title: 'Лёгкая адаптация в школе' },
];

const lessonFormat = [
  { label: 'Длительность', value: '1.5 часа (90 минут)' },
  { label: 'Возраст', value: '6–7 лет' },
  { label: 'Формат', value: 'Групповые занятия' },
  { label: 'Атмосфера', value: 'Уютная, доброжелательная' },
];

const advantages = [
  { icon: 'team', title: 'Комплексный подход', text: 'Всестороннее развитие: интеллект, эмоции, социализация' },
  { icon: 'worth', title: 'Опытные педагоги', text: 'Квалифицированные специалисты с большим опытом' },
  { icon: 'flask', title: 'Проверенные методики', text: 'Современные подходы к обучению и развитию' },
];

const formatPoints = [
  'Занятия 2 раза в неделю',
  'Диагностика при записи',
  'Все материалы включены',
  'Обратная связь родителям',
  'Занятия в мини-группах до 8 человек',
];

const otherPrograms = [
  {
    icon: 'book',
    title: '«Умники и умницы»',
    age: 'Для детей 4–6 лет',
    text: 'Комплексно-развивающие занятия по подготовке к школе с акцентом на чтение, письмо и логику.',
    href: url('/programs/umniky'),
  },
  {
    icon: 'bond',
    title: '«Азбука общения»',
    age: 'Для детей 5–9 лет',
    text: 'Курс развития эмоционального интеллекта. Учим детей понимать эмоции и выстраивать отношения.',
    href: url('/programs/azbuka'),
  },
];
---

<SEO
  title="Подготовка к школе в Одинцово | Для детей 6–7 лет"
  description="Подготовка к школе в Одинцово. Комплексные занятия для детей 6–7 лет. Обучение чтению, письму, математике. Записаться онлайн."
  keywords="подготовка к школе Одинцово, занятия для дошкольников, подготовка ребенка к школе"
  schema="service"
/>

<Layout
  title="Подготовка к школе в Одинцово | Для детей 6–7 лет"
  description="Комплексная программа подготовки к школе: мнемотехника, нейропсихология, чтение, письмо, математика, психологическая готовность. Занятия вт/чт 17:30–19:00"
>

  <Breadcrumbs
    items={[
      { label: 'Главная', href: url('/') },
      { label: 'Услуги', href: url('/#services') },
      { label: 'Подготовка к школе' }
    ]}
  />

  <!-- ============ Первый экран ============ -->
  <section class="page-hero">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="hero-grid">

        <div>
          <p class="eyebrow mb-4">Для детей 6–7 лет</p>
          <h1 class="display mb-5">Подготовка к школе</h1>

          <p class="lede mb-8 max-w-[46ch]">
            Занятия два раза в неделю, дети получат все необходимые знания
            и навыки для успешного обучения в школе.
          </p>

          <ul class="check-list mb-9">
            {heroPoints.map((point) => <li>{point}</li>)}
          </ul>

          <div class="flex flex-wrap gap-3">
            <button onclick="openBookingModal('school-prep')" class="pill pill-solid pill-lg" type="button">
              Записаться на консультацию
            </button>
            <a href="#program" class="pill pill-outline pill-lg">Что входит в программу</a>
          </div>
        </div>

        <div class="hero-visual orb surface-lg">
          <picture>
  <source srcset={webpSet('/images/services/school-prep.jpg')} type="image/webp" sizes={HERO_SIZES} />
  <img src={url('/images/services/school-prep.jpg')} alt="Занятия по подготовке к школе" class="hero-photo" loading="eager" fetchpriority="high" decoding="async" />
</picture>
        </div>

      </div>
    </div>
  </section>

  <!-- ============ Что включает программа ============ -->
  <section id="program" class="band">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head" data-reveal>
          <p class="eyebrow mb-3">Программа</p>
          <h2 class="heading mb-4">Что включает программа</h2>
          <p class="lede max-w-[56ch]">
            Комплексный подход к всестороннему развитию и подготовке к школе
          </p>
        </div>

        <div class="cards-3">
          {programBlocks.map((block) => (
            <article class="feature surface lift" data-reveal>
              <span class="card-icon"><Icon name={block.icon} size={22} /></span>
              <h3 class="card-title">{block.title}</h3>
              <p class="card-text">{block.text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <AutoGallerySlider
    images={galleryImages}
    title="Как проходят наши занятия"
    subtitle="Посмотрите, как дети готовятся к школе в нашем центре"
    accentColor="blue"
    autoplayDelay={4000}
  />

  <!-- ============ Результаты выпускников ============ -->
  <section class="band">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head" data-reveal>
          <p class="eyebrow mb-3">Результат</p>
          <h2 class="heading mb-4">Что ребёнок умеет к первому классу</h2>
          <p class="lede max-w-[56ch]">Навыки, с которыми выпускники программы начинают учёбу</p>
        </div>

        <div class="cards-3">
          {results.map((item) => (
            <div class="result-card" data-reveal>
              <span class="card-icon"><Icon name={item.icon} size={22} /></span>
              <p class="result-title">{item.title}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- ============ Расписание и формат ============ -->
  <section class="band">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head" data-reveal>
          <p class="eyebrow mb-3">Расписание</p>
          <h2 class="heading">Расписание и формат занятий</h2>
        </div>

        <div class="split">

          <article class="gradient-card schedule" data-reveal>
            <div class="schedule-inner">
              <span class="card-icon"><Icon name="clock" size={22} /></span>
              <h3 class="heading-sm schedule-days">Вторник и Четверг</h3>
              <p class="schedule-time">17:30–19:00</p>

              <div class="glass-card schedule-slot">
                <h4 class="slot-title">Формат занятий:</h4>
                <ul class="slot-list">
                  {lessonFormat.map((row) => (
                    <li><strong>{row.label}:</strong> {row.value}</li>
                  ))}
                </ul>
              </div>
            </div>
          </article>

          <article class="surface why" data-reveal>
            <div class="why-inner">
              <h3 class="heading-sm mb-6">Почему выбирают нас</h3>
              <div class="why-list">
                {advantages.map((item) => (
                  <div class="why-item">
                    <h4 class="why-title"><Icon name={item.icon} size={19} />{item.title}</h4>
                    <p class="why-text">{item.text}</p>
                  </div>
                ))}
              </div>
            </div>
          </article>

        </div>
      </div>
    </div>
  </section>

  <!-- ============ Формат занятий ============ -->
  <section class="band band-taupe">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head" data-reveal>
          <p class="eyebrow mb-3">Условия</p>
          <h2 class="heading">Формат занятий</h2>
        </div>

        <div class="format-card" data-reveal>
          <ul class="check-list mb-8">
            {formatPoints.map((point) => <li>{point}</li>)}
          </ul>

          <button onclick="openBookingModal('school-prep')" class="pill pill-solid pill-lg format-cta" type="button">
            Записаться на программу
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Вопросы ============ -->
  <div data-reveal>
    <FAQ
      title="Часто задаваемые вопросы"
      subtitle="Ответы на популярные вопросы о подготовке к школе"
      items={[
        {
          question: "В каком возрасте лучше начинать подготовку?",
          answer: "Оптимальный возраст — 6–7 лет, за год до поступления в школу. В этом возрасте ребёнок готов к систематическим занятиям и хорошо усваивает новые знания."
        },
        {
          question: "Что если ребёнок пропустит занятие?",
          answer: "Пропущенное занятие можно отработать в другое время или в параллельной группе. При болезни (по справке) возможен перерасчёт абонемента."
        },
        {
          question: "Нужно ли покупать учебные материалы?",
          answer: "Нет, все учебные материалы, рабочие тетради, канцелярия предоставляются центром. Вам ничего не нужно покупать дополнительно."
        },
        {
          question: "Как я узнаю о прогрессе ребёнка?",
          answer: "Педагог регулярно даёт обратную связь родителям: рассказывает о достижениях, зонах роста и даёт рекомендации для домашних занятий. Также проводятся промежуточные диагностики."
        },
        {
          question: "Будет ли ребёнок готов к школе после программы?",
          answer: "Да. Программа даёт и академические знания, и психологическую готовность: ребёнок приходит в первый класс подготовленным и спокойным. Ребёнок приходит в первый класс с нужными навыками и спокойным отношением к учёбе."
        }
      ]}
    />
  </div>

  <!-- ============ Другие программы ============ -->
  <section class="band band-taupe">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head" data-reveal>
          <p class="eyebrow mb-3">Ещё для детей</p>
          <h2 class="heading mb-4">Другие наши программы</h2>
          <p class="lede max-w-[56ch]">
            Дополнительные занятия для комплексного развития ребёнка
          </p>
        </div>

        <div class="cards-2">
          {otherPrograms.map((program) => (
            <a href={url(program.href)} class="other-card lift" data-reveal>
              <span class="card-icon"><Icon name={program.icon} size={22} /></span>
              <h3 class="card-title">{program.title}</h3>
              <p class="other-age">{program.age}</p>
              <p class="card-text">{program.text}</p>
              <span class="other-more">Узнать подробнее <Icon name="arrow" size={16} /></span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Финальный призыв ============ -->
  <section class="band band-tight">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="glow-band closing-band" data-reveal>
          <div class="closing-inner">
            <p class="eyebrow mb-4">Запись</p>
            <h2 class="heading mb-4">Запишите ребёнка на подготовку к школе</h2>
            <p class="lede mb-8 max-w-[48ch]">
              Дайте вашему ребёнку уверенный старт в школьной жизни
            </p>

            <div class="closing-actions">
              <button onclick="openBookingModal('school-prep')" class="pill pill-solid pill-lg" type="button">
                Записаться на программу
              </button>
              <button onclick="openBookingModal('trial')" class="pill pill-outline pill-lg" type="button">
                Бесплатное пробное занятие
              </button>
            </div>

            <div class="closing-notes">
              <span>
                <Icon name="phone" size={16} />
                <a href="tel:+79151955132">+7 (915) 195-51-32</a>
              </span>
              <span><Icon name="chat" size={16} />WhatsApp / Telegram</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ScrollAnimations />
</Layout>

<style>
  /* ---------- ритм секций ---------- */
  .band { padding: 96px 0; }
  .band-tight { padding: 24px 0 96px; }

  .cards-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: stretch; }

  /* ---------- первый экран ---------- */
  .page-hero { padding: 28px 0 96px; background: var(--canvas); }
  .hero-grid {
    display: grid; grid-template-columns: 1.02fr 0.98fr; gap: 64px;
    align-items: center; max-width: 1180px; margin: 0 auto;
  }
  .hero-visual { aspect-ratio: 1 / 1.02; }
  .hero-photo {
    position: absolute; inset: 10% 9% 0 9%; z-index: 2;
    width: 82%; height: 90%; object-fit: cover; object-position: center 30%;
    border-radius: 18px 18px 0 0;
    border: 1px solid rgba(255, 255, 255, 0.55); border-bottom: 0;
  }

  /* ---------- список с галочками ---------- */
  .check-list { list-style: none; padding: 0; display: grid; gap: 11px; }
  .check-list li {
    position: relative; padding-left: 26px; font-size: 15px; line-height: 1.55; color: var(--graphite);
  }
  .check-list li::before {
    content: ""; position: absolute; left: 0; top: 8px;
    width: 13px; height: 7px;
    border-left: 1.6px solid var(--spark-water);
    border-bottom: 1.6px solid var(--spark-water);
    transform: rotate(-45deg);
  }

  /* ---------- карточки программы ---------- */
  .card-icon {
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; width: 40px; height: 40px; border-radius: 12px;
    background: rgba(47, 125, 150, .1); color: var(--spark-deep);
  }
  .gradient-card .card-icon { background: rgba(255, 255, 255, .2); color: #fff; }

  .feature { padding: 28px; }
  .feature .card-icon { margin-bottom: 18px; }
  .card-title { font-size: 18px; font-weight: 400; letter-spacing: -0.01em; line-height: 1.3; margin-bottom: 10px; }
  .card-text { font-size: 14px; line-height: 1.6; color: var(--smoke); }

  /* ---------- результат ---------- */
  .result-card {
    background: var(--canvas); border: 1px solid var(--stone); border-radius: var(--r-card);
    padding: 28px; display: flex; align-items: center; gap: 16px;
  }
  .result-title { font-size: 16px; font-weight: 500; letter-spacing: -0.01em; color: var(--ink); }
  .section-note {
    margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--stone);
    font-size: 14px; color: var(--smoke);
  }

  /* ---------- расписание ---------- */
  .schedule-inner { padding: 36px; }
  .schedule-inner .card-icon { margin-bottom: 20px; }
  .schedule-days { color: #fff; margin-bottom: 6px; }
  .schedule-time {
    font-size: clamp(26px, 3vw, 34px); font-weight: 300; letter-spacing: -0.02em;
    color: #fff; font-variant-numeric: tabular-nums; margin-bottom: 28px;
  }
  .schedule-slot { padding: 24px; }
  .slot-title { font-size: 15px; font-weight: 500; color: var(--ink); margin-bottom: 14px; }
  .slot-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .slot-list li {
    position: relative; padding-left: 20px; font-size: 14px; line-height: 1.55; color: var(--smoke);
  }
  .slot-list li strong { font-weight: 500; color: var(--ink); }
  .slot-list li::before {
    content: ""; position: absolute; left: 3px; top: 9px;
    width: 5px; height: 5px; border-radius: 50%; background: var(--spark-deep);
  }

  /* ---------- почему выбирают ---------- */
  .why-inner { padding: 36px; }
  .why-list { display: grid; }
  .why-item { padding: 20px 0; border-top: 1px solid var(--stone); }
  .why-item:last-child { padding-bottom: 0; }
  .why-title {
    font-size: 16px; font-weight: 500; letter-spacing: -0.01em; margin-bottom: 6px;
    display: flex; align-items: center; gap: 10px; color: var(--ink);
  }
  .why-title :global(svg) { color: var(--spark-deep); flex-shrink: 0; }
  .why-text { padding-left: 29px; font-size: 14px; line-height: 1.6; color: var(--smoke); }

  /* ---------- формат занятий ---------- */
  .format-card {
    max-width: 640px; margin: 0 auto;
    background: var(--canvas); border: 1px solid var(--stone); border-radius: var(--r-large);
    padding: 40px;
  }
  .format-cta { width: 100%; }

  /* ---------- другие программы ---------- */
  .other-card {
    display: flex; flex-direction: column;
    background: var(--canvas); border: 1px solid var(--stone); border-radius: var(--r-card);
    padding: 28px; text-decoration: none; color: inherit;
  }
  .other-card .card-icon { margin-bottom: 18px; }
  .other-age { font-size: 13px; color: var(--ash); margin: -4px 0 12px; }
  .other-more {
    margin-top: auto; padding-top: 18px;
    font-size: 14px; font-weight: 500; color: var(--ink);
    display: inline-flex; align-items: center; gap: 7px;
  }
  .other-more :global(svg) { transition: transform .3s cubic-bezier(.2,.7,.3,1); }
  .other-card:hover .other-more :global(svg) { transform: translateX(3px); }

  /* ---------- финальный призыв ---------- */
  .closing-band { padding: 56px 48px; }
  .closing-inner { max-width: 640px; }
