  <script is:inline>
    function initChildrenAccordion() {
      document.querySelectorAll('.accordion-card').forEach(function (card) {
        var head = card.querySelector('.card-head');
        var content = card.querySelector('.accordion-content');
        if (!head || !content || head.dataset.bound) return;
        head.dataset.bound = '1';

        // карточка кликабельна целиком, поэтому ловим клик и мимо шапки
        card.addEventListener('click', function (e) {
          if (e.target.closest('.card-head') || e.target.closest('.card-cta')) return;
          head.click();
        });

        head.addEventListener('click', function () {
          var isOpen = card.classList.contains('is-open');

          document.querySelectorAll('.accordion-card.is-open').forEach(function (other) {
            if (other === card) return;
            other.classList.remove('is-open');
            var oc = other.querySelector('.accordion-content');
            var oh = other.querySelector('.card-head');
            var oi = other.querySelector('.accordion-icon');
            if (oc) { oc.style.maxHeight = '0px'; oc.setAttribute('inert', ''); }
            if (oh) oh.setAttribute('aria-expanded', 'false');
            if (oi) oi.style.transform = 'rotate(0deg)';
          });

          var icon = card.querySelector('.accordion-icon');
          if (isOpen) {
            card.classList.remove('is-open');
            content.style.maxHeight = '0px';
            content.setAttribute('inert', '');
            head.setAttribute('aria-expanded', 'false');
            if (icon) icon.style.transform = 'rotate(0deg)';
          } else {
            card.classList.add('is-open');
            content.removeAttribute('inert');
            content.style.maxHeight = content.scrollHeight + 'px';
            head.setAttribute('aria-expanded', 'true');
            if (icon) icon.style.transform = 'rotate(180deg)';
          }
        });
      });
    }

    // при смене ширины высота раскрытой карточки пересчитывается
    var childrenAccTimer;
    window.addEventListener('resize', function () {
      clearTimeout(childrenAccTimer);
      childrenAccTimer = setTimeout(function () {
        document.querySelectorAll('.accordion-card.is-open .accordion-content').forEach(function (c) {
          c.style.maxHeight = c.scrollHeight + 'px';
        });
      }, 150);
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initChildrenAccordion);
    } else {
      initChildrenAccordion();
    }

    document.addEventListener('astro:page-load', initChildrenAccordion);
  </script>

