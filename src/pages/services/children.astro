---
// src/pages/services/children.astro
import Layout from '../../layouts/Layout.astro';
import ScrollAnimations from '../../components/ScrollAnimations.astro';
import FAQ from '../../components/FAQ.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SEO from '../../components/SEO.astro';
import Icon from '../../components/Icon.astro';
import { url } from '../../utils/url';

// Частые запросы. Карточка раскрывается по клику.
const requests = [
  {
    icon: 'calm',
    title: 'Страхи, тревожность, фобии',
    lead: 'Детские страхи бывают возрастными, ситуативными, фобиями, социальными и ночными — и подход к каждому типу я выстраиваю с учётом особенностей ребёнка.',
    items: [
      { label: 'Выяснение причины страха:', text: 'разбираю ситуацию вместе с родителями, чтобы понять, когда и в каких условиях тревога проявляется сильнее всего' },
      { label: 'Объяснение родителям, что делать:', text: 'рассказываю, где норма, а где нужна поддержка, и даю понятные ориентиры' },
      { label: 'Подбор подходящих методов:', text: 'в работе использую игры, сказки, техники дыхания и арт-терапию — ребёнок «проживает» пугающее в безопасной форме' },
      { label: 'Обучение ребёнка справляться с напряжением:', text: 'учу простым приёмам саморегуляции, которые реально работают в моменте' },
      { label: 'Рекомендации родителям:', text: 'даю чёткие, практичные советы, как вести себя в тревожных ситуациях и поддерживать ребёнка без усиления страха' },
    ],
  },
  {
    icon: 'child',
    title: 'Агрессия, истерики, непослушание',
    lead: 'Агрессия, истерики и непослушание — не просто «плохое поведение», а сигнал о перегрузке: ребёнок не справляется с эмоциями и не владеет другими способами донести своё состояние.',
    items: [
      { label: 'Выяснение причин:', text: 'определяю с родителями триггеры вспышек (усталость, страх, непонимание требований)' },
      { label: 'Объяснение родителям:', text: 'отделяем намеренную «вредность» от реакции на перегрузку, обозначаем, где нужна поддержка' },
      { label: 'Подбор методов:', text: 'использую игры, дыхательные приёмы и способы вербального выражения злости' },
      { label: 'Обучение ребёнка:', text: 'даю простые инструменты для момента — назвать чувство, сделать паузу, уйти в «уголок тишины»' },
      { label: 'Рекомендации родителям:', text: 'чёткие шаги по выстраиванию границ и поддержке без усиления конфликта' },
    ],
  },
  {
    icon: 'book',
    title: 'Проблемы в школе, с учёбой',
    lead: 'Ребёнок не хочет идти в школу, возникают конфликты с учителями и одноклассниками, неуспеваемость. Школьные трудности возникают из-за нагрузки или адаптации, а также из-за тревоги, непонимания или нехватки опоры. Работаю с ребёнком и семьёй, чтобы вернуть ощущение «я справляюсь».',
    items: [
      { label: 'Выяснение причин:', text: 'вместе с родителями определяем, что именно мешает: страх ошибки, перегруз, пробелы в материале, конфликты, сложности с вниманием' },
      { label: 'Объяснение родителям:', text: 'показываю, где это типичные этапы адаптации, а где нужны дополнительные ресурсы и щадящий режим' },
      { label: 'Подбор методов:', text: 'использую пошаговые алгоритмы для домашних заданий, визуальные опоры и чек-листы, игровые форматы отработки тем, техники снижения тревожности' },
      { label: 'Обучение ребёнка:', text: 'даю простые инструменты для самоорганизации и самоконтроля' },
      { label: 'Рекомендации родителям:', text: 'чёткие способы поддержки без выполнения заданий за ребёнка, правила «тихой зоны» для уроков, формулировки обратной связи, которые сохраняют мотивацию' },
    ],
  },
  {
    icon: 'bond',
    title: 'Замкнутость, трудности в общении',
    lead: 'Ребёнок избегает общения, не играет с другими детьми, стесняется, предпочитает одиночество, боится оценки. Помогаю ребёнку почувствовать себя увереннее в общении и найти простые способы вступать в контакт.',
    items: [
      { label: 'Выяснение причин:', text: 'определяем, где и когда ребёнку тяжелее и какие сигналы тревоги он испытывает' },
      { label: 'Объяснение родителям:', text: 'разбираем, где застенчивость, а где социальная тревога, и какие шаги сейчас уместны' },
      { label: 'Подбор методов:', text: 'ролевые сценки, карточки с фразами, «лестница смелости», техники дыхания, игры на коммуникацию' },
      { label: 'Обучение ребёнка:', text: 'фразы для знакомства, правило «одного шага», техники саморегуляции' },
      { label: 'Рекомендации родителям:', text: 'поддерживать без давления, не отвечать за ребёнка, хвалить малейшие попытки контакта' },
    ],
  },
  {
    icon: 'worth',
    title: 'Низкая самооценка, неуверенность',
    lead: '«Я плохой», «У меня не получится» — ребёнок боится пробовать новое, считает себя хуже других. Помогу ребёнку вернуть опору в себе: увидеть свои сильные стороны и научиться не обесценивать успехи.',
    items: [
      { label: 'Выяснение причин:', text: 'разбираем, где и когда появляется неуверенность и какие мысли её усиливают' },
      { label: 'Объяснение родителям:', text: 'показываю, как привычные фразы и ожидания могут незаметно снижать самооценку, как правильно поддерживать и давать опору' },
      { label: 'Подбор методов:', text: 'использую дневник, шкалу уверенности, работу с «мыслями-ловушками», упражнения на формулирование сильных качеств и безопасные пробы нового' },
      { label: 'Обучение ребёнка:', text: 'даю простые инструменты — фраза «я учусь, а не должен сразу уметь», правило «одной попытки», способ замечать 1–2 своих успеха в день; учу верить в себя и справляться с неудачами' },
      { label: 'Рекомендации родителям:', text: 'как давать обратную связь, которая укрепляет, а не ранит; как делить большие задачи на шаги и хвалить процесс, а не только результат; как избегать сравнений и поддерживать право на ошибку' },
    ],
  },
  {
    icon: 'compass',
    title: 'Развод родителей, семейные кризисы',
    lead: 'Помощь ребёнку в переживании развода, адаптация к новым условиям, работа с виной и тревогой. Помогаю сохранить чувство безопасности.',
    items: [
      { label: 'Выяснение напряжения:', text: 'определяем, что сильнее всего тревожит ребёнка — чувство вины, страх потерять контакт с родителем, ссоры, переезд, новые правила' },
      { label: 'Объяснение родителям:', text: 'показываю, как слова и конфликты взрослых усиливают тревогу ребёнка, и как дать ему единое спокойное послание («мы оба тебя любим»)' },
      { label: 'Подбор методов:', text: 'сказкотерапия, «книга перемен» с ответами на частые вопросы, арт- и игровая терапия, ритуалы перехода между домами, техники снижения напряжения' },
      { label: 'Обучение ребёнка:', text: 'даю простые слова для тяжёлых чувств и способы самопомощи (дыхание, «коробка грусти», безопасное место), учу отделять «взрослые проблемы» от своих переживаний' },
      { label: 'Рекомендации родителям:', text: 'как говорить о переменах по возрасту, не втягивать ребёнка в конфликт, сохранять рутину, выстраивать понятный график встреч и замечать признаки перегрузки' },
    ],
  },
];

// Методы работы
const methods = [
  {
    icon: 'play',
    title: 'Игротерапия',
    text: 'Ребёнок проигрывает свои переживания через игру. Это помогает ему выразить и отреагировать то, что сложно сказать словами.',
    items: ['Страхах и тревоге', 'Агрессии', 'Травмах', 'Проблемах в семье'],
  },
  {
    icon: 'note',
    title: 'Арт-терапия',
    text: 'Рисование, лепка, создание коллажей. Через творчество ребенок выражает свои эмоции и учится с ними справляться.',
    items: ['Эмоциональных проблемах', 'Низкой самооценке', 'Замкнутости', 'Психосоматике'],
  },
  {
    icon: 'book',
    title: 'Сказкотерапия',
    text: 'Работа через сказки и истории. Ребёнок учится решать проблемы вместе с героями, находит выход из сложных ситуаций.',
    items: ['Страхах и тревоге', 'Низкой самооценке', 'Проблемах в общении', 'Развитии воображения'],
  },
  {
    icon: 'compass',
    title: 'МАК (метафорические карты)',
    text: 'Работа с картинками-образами. Ребёнку проще рассказать о себе через картинку, чем прямым вопросом — так мы находим то, что тревожит на самом деле.',
    items: ['Трудностях с выражением чувств', 'Скрытых переживаниях', 'Работе с подростками', 'Семейных конфликтах'],
  },
  {
    icon: 'calm',
    title: 'Песочная терапия',
    text: 'Ребёнок строит свой мир в песочнице. Через фигурки и сюжеты он проживает то, что его волнует, и снимает внутреннее напряжение.',
    items: ['Тревоге и напряжении', 'Переживании перемен', 'Страхах', 'Работе с младшими детьми'],
  },
];

// Авторские программы
const programs = [
  {
    name: 'Умники и умницы',
    age: 'Для детей 5-7 лет',
    text: 'Комплексно-развивающие занятия по подготовке к школе. С помощью современных методик ребенок легко учится читать, писать, считать, развивает память, речь и расширяет кругозор.',
    listTitle: 'Что включено:',
    list: [
      { label: 'Мнемотехника', text: ' — обучение легко и быстро запоминать' },
      { label: 'Нейропсихологические игры', text: ' — развитие межполушарного взаимодействия' },
      { label: 'Тренировка чтения и письма', text: ' правильной техники' },
      { label: 'Расширение кругозора', text: ' на ежедневных занятиях' },
      { label: 'Творческие занятия', text: ' — развитие воображения, фантазии, мелкой моторики' },
      { label: 'Занятия с логопедом', text: ' — становление речи' },
      { label: 'Работа с психологом', text: ' — развитие эмоциональной сферы и подготовка к школе' },
    ],
    formatTitle: 'Формат занятий:',
    format: [
      'Малые группы до 8 детей',
      'Индивидуальный подход к каждому',
      'Возрастная диагностика при записи',
      'С детьми работают: педагог, логопед, психолог',
    ],
    result: 'Готовность к школе и уверенность ребенка',
    href: url('/programs/umniky'),
  },
  {
    name: 'Азбука общения',
    age: 'Для детей 5-9 лет',
    badge: 'Набор открыт',
    featured: true,
    text: 'Психологический курс, который знакомит детей со сложным миром человеческих эмоций. Дети учатся понимать, проявлять и реагировать на свои и чужие эмоции.',
    listTitle: 'Что ребенок развивает:',
    list: [
      { label: 'Уверенность в себе', text: ' и самостоятельность' },
      { label: 'Позитивное отношение', text: ' к себе и сверстникам' },
      { label: 'Эмпатию и сопереживание', text: ' — понимание чувств других' },
      { label: 'Выстраивание границ', text: ' и умение чувствовать их у других' },
      { label: 'Работу со страхами', text: ', тревогами и обидами' },
      { label: 'Игра по правилам', text: ' — умение достойно проигрывать и выигрывать' },
      { label: 'Работу в команде', text: ' и лидерство' },
    ],
    formatTitle: 'Особенности курса:',
    format: [
      'Знакомство с релаксацией и саморегуляцией',
      'Управление эмоциональным состоянием',
      'Повышение эмоциональной устойчивости',
      'Формирование высокого EQ (эмоционального интеллекта)',
    ],
    result: 'Развитый эмоциональный интеллект и навыки общения',
    href: url('/programs/azbuka'),
  },
];

// Как проходит консультация
const steps = [
  {
    title: 'Беседа с родителями',
    text: 'Психолог беседует с вами без ребенка: узнает запрос, историю, особенности развития. Вы можете задать все вопросы.',
  },
  {
    title: 'Знакомство с ребенком',
    text: 'Психолог показывает ребенку игровую комнату, рассказывает о правилах. Важно, чтобы ребенок почувствовал себя в безопасности.',
  },
  {
    title: 'Игра и диагностика',
    text: 'Психолог играет с ребенком, предлагает порисовать или полепить. В процессе оценивает эмоциональное состояние и особенности.',
  },
  {
    title: 'Обратная связь родителям',
    text: 'Психолог делится первыми впечатлениями, предлагает план работы, отвечает на вопросы. Вы решаете, продолжать ли терапию.',
  },
];

// Форматы работы
const formats = [
  {
    title: 'Разовая консультация',
    items: ['Обсуждение запроса', 'Диагностика при необходимости', 'Рекомендации родителям', 'Онлайн или офлайн'],
    cta: 'Записаться',
    mode: 'single',
  },
  {
    title: 'Системная работа',
    note: 'Серия встреч по плану терапии',
    badge: 'Рекомендуем',
    featured: true,
    items: ['Глубокая проработка запроса', 'Индивидуальный план', 'Видимый результат'],
    cta: 'Записаться',
    mode: 'package',
  },
  {
    title: 'Групповые занятия',
    items: ['Группы до 8 человек', 'Развитие социальных навыков', 'Игровые программы', '1 раз в неделю'],
    cta: 'Записаться в группу',
    mode: 'group',
  },
];

// Перелинковка
const related = [
  { icon: 'book', title: 'Умники и умницы', text: 'Комплексная подготовка к школе для детей 5-7 лет', href: url('/programs/umniky') },
  { icon: 'chat', title: 'Азбука общения', text: 'Развитие эмоционального интеллекта для детей 5-9 лет', href: url('/programs/azbuka') },
  { icon: 'note', title: 'Подготовка к школе', text: 'Знания и навыки для успешного старта в школе', href: url('/services/school-prep') },
];
---

<SEO
  title="Детский психолог в Одинцово и Лесном городке | Консультации онлайн"
  description="Детский психолог в Одинцово. Помощь детям и подросткам. Работа с истериками, агрессией, страхами, школьными проблемами. Запись онлайн."
  keywords="детский психолог Одинцово, психолог для ребенка, детская психология"
  schema="service"
/>

<Layout
  title="Детский психолог в Одинцово и Лесном городке | Консультации онлайн"
  description="Детский психолог в Одинцово. Помощь детям и подросткам."
>

  <Breadcrumbs
    items={[
      { label: 'Главная', href: url('/') },
      { label: 'Услуги', href: url('/#services') },
      { label: 'Занятия с детьми' }
    ]}
  />

  <!-- ============ Первый экран ============ -->
  <section class="page-hero">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="hero-grid">

        <div>
          <p class="eyebrow mb-4 rise">Для родителей</p>

          <h1 class="display mb-5 rise">Индивидуальные занятия с детьми</h1>

          <p class="lede mb-8 max-w-[46ch] rise rise-2">
            Помогу ребенку понять свои эмоции, справиться со страхами и наладить отношения с окружающими
          </p>

          <div class="flex flex-wrap gap-3 mb-11 rise rise-3">
            <button onclick="openBookingModal()" class="pill pill-solid pill-lg" type="button">
              Записаться на консультацию
            </button>
            <a href="#what-we-help" class="pill pill-outline pill-lg">Частые запросы</a>
          </div>

          <div class="hairline pt-6 flex flex-wrap gap-10 rise rise-4">
            <div>
              <div class="hero-figure">5–18</div>
              <div class="text-[13px] muted">возраст детей</div>
            </div>
            <div>
              <div class="hero-figure">55 мин</div>
              <div class="text-[13px] muted">длительность сессии</div>
            </div>
          </div>
        </div>

        <div class="hero-visual rise rise-2">
          <img
            src={url('/images/services/child-therapy.jpg')}
            alt="Консультация детского психолога"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

      </div>
    </div>
  </section>

  <!-- ============ Частые запросы ============ -->
  <section id="what-we-help" class="band">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head" data-reveal>
          <p class="eyebrow mb-3">С чем работаю</p>
          <h2 class="heading mb-4">Частые запросы</h2>
          <p class="lede max-w-[56ch]">Возможно, среди них ваш</p>
        </div>

        <div class="cards-2">
          {requests.map((item) => (
            <article class="accordion-card surface" data-reveal>
              <div class="card-inner">
                <h3 class="card-heading">
                  <button class="card-head" type="button" aria-expanded="false">
                    <span class="card-icon"><Icon name={item.icon} size={22} /></span>
                    <span class="card-title">{item.title}</span>
                    <svg class="accordion-icon chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                </h3>

                <p class="card-lead">{item.lead}</p>

                <div class="accordion-content" inert>
                  <ul class="card-list">
                    {item.items.map((li) => (
                      <li><strong>{li.label}</strong> {li.text}</li>
                    ))}
                  </ul>
                  <button onclick="openBookingModal()" class="pill pill-solid card-cta" type="button">
                    Записаться
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Методы и авторские программы ============ -->
  <section class="band band-taupe">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="band-head" data-reveal>
          <p class="eyebrow mb-3">Методы</p>
          <h2 class="heading mb-4">Как я работаю с детьми</h2>
        </div>

        <div class="cards-3">
          {methods.map((method) => (
            <article class="method" data-reveal>
              <span class="method-icon"><Icon name={method.icon} size={22} /></span>
