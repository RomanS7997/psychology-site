---
// src/pages/blog/index.astro
import Layout from '../../layouts/Layout.astro';
import { webp, dims } from '../../utils/img';
import ScrollAnimations from '../../components/ScrollAnimations.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SEO from '../../components/SEO.astro';
import Icon from '../../components/Icon.astro';
import RelatedCards from '../../components/RelatedCards.astro';
import { url } from '../../utils/url';
// Статьи — из общего списка: тот же, что на главной и в разметке.
// Обложка: если фотографии для статьи нет, ставим тихую плашку с линейной иконкой.
// Первый ряд обложек виден сразу — грузим без отсрочки, первую — раньше всех.
import { posts, postPath } from '../../data/posts';
import { serviceCard } from '../../data/services';

// Кнопки фильтра собираем из самих статей — список не разъезжается с сеткой.
const categories = Array.from(new Set(posts.map((post) => post.category)));
---

<Layout
  title="Блог психолога о тревоге, детях и отношениях | Юлия Ляпина"
  description="Разбираю то, с чем приходят на приём: панические атаки, поведение ребёнка, отношения в паре. Пишу то же, что говорю на консультации. Читайте и пишите мне."
>
  <SEO
    slot="head"
    title="Блог психолога о тревоге, детях и отношениях | Юлия Ляпина"
    description="Разбираю то, с чем приходят на приём: панические атаки, поведение ребёнка, отношения в паре. Пишу то же, что говорю на консультации. Читайте и пишите мне."
    type="website"
    schema="blog"
  />

  <Breadcrumbs
    items={[
      { label: 'Главная', href: url('/') },
      { label: 'Блог' }
    ]}
  />

  <!-- ============ Шапка страницы ============ -->
  <section class="page-hero">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="hero-head" data-reveal>
          <p class="eyebrow mb-3">Блог</p>
          <h1 class="display mb-5">Блог о психологии</h1>
          <p class="lede max-w-[56ch]">
            Разбираю вопросы, с которыми чаще всего приходят ко мне на приём:
            тревога и панические атаки, поведение ребёнка, отношения в паре.
          </p>
          <p class="hero-note max-w-[62ch]">
            Пишу то же, что говорю на консультации, — без общих слов и без
            обещаний, что одна статья заменит работу со специалистом. Если
            после прочтения хочется разобраться в своей ситуации, приходите:
            я принимаю в Одинцово,
            <a href={url('/contact#map')}>в кабинете в Лесном городке</a>, и онлайн.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Категории / Фильтры ============ -->
  <section class="filter-band">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="filters" role="group" aria-label="Фильтр статей по темам" data-reveal>
          <button class="category-filter active" type="button" data-category="all" aria-pressed="true">
            Все статьи
          </button>
          {categories.map((category) => (
            <button class="category-filter" type="button" data-category={category} aria-pressed="false">
              {category}
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Сетка статей ============ -->
  <section class="band band-taupe">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">

        <div class="cards-3" id="posts-grid">
          {posts.map((post, i) => (
            <article class="post-card" data-category={post.category} data-reveal>
              <a class="post lift" href={url(postPath(post))}>
                {post.image ? (
                  <div class="post-photo">
                    <picture>
  {webp(post.image) && <source srcset={webp(post.image)} type="image/webp" />}
  <img src={url(post.image)} {...dims(post.image)} alt={post.alt} loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
</picture>
                  </div>
                ) : (
                  <div class="post-photo post-photo-mark">
                    <span class="post-mark"><Icon name={post.icon} size={40} /></span>
                  </div>
                )}

                <div class="post-body">
                  <div class="post-meta">
                    <span class="post-cat">{post.category}</span>
                    <span>{post.readTime}</span>
                  </div>

                  <h2 class="post-title">{post.title}</h2>
                  <p class="post-excerpt">{post.excerpt}</p>

                  <div class="post-foot">
                    <span class="post-date">{post.dateText}</span>
                    <span class="post-more">Читать <Icon name="go-to" size={16} /></span>
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>

        <!-- Пустое состояние при фильтрации -->
        <div id="empty-state" class="empty hidden">
          <span class="empty-icon"><Icon name="articles" size={24} /></span>
          <p class="heading-sm empty-title">Статей в этой категории пока нет</p>
          <p class="muted">Попробуйте выбрать другую категорию</p>
        </div>

      </div>
    </div>
  </section>

  <RelatedCards items={[serviceCard('/services/adult'), serviceCard('/services/children')]} tone="plain" />

  <ScrollAnimations />
</Layout>

<style>
  .hero-note { margin-top: 14px; font-size: 15px; line-height: 1.75; color: var(--smoke); }
  .hero-note a { color: var(--spark-deep); text-decoration: underline; text-underline-offset: 3px; }
  .hero-note a:hover { color: var(--ink); }

  /* ---------- ритм страницы ---------- */
  .page-hero { padding: 28px 0 56px; background: var(--canvas); }
  .hero-head { max-width: 760px; }
  .band { padding: 72px 0 96px; }

  /* ---------- фильтр по темам ---------- */
  .filter-band {
    padding: 0 0 32px;
    background: var(--canvas);
    border-bottom: 1px solid var(--stone);
  }
  .filters { display: flex; flex-wrap: wrap; gap: 10px; }

  .category-filter {
    border-radius: var(--r-pill);
    border: 1px solid var(--stone);
    background: transparent;
    color: var(--graphite);
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.01em;
    padding: 11px 20px;
    cursor: pointer;
    transition: background-color .25s ease, color .25s ease, border-color .25s ease;
  }
  .category-filter:hover {
    color: var(--ink);
    border-color: var(--graphite);
    background: rgba(20, 24, 28, .04);
  }
  .category-filter.active {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .category-filter:focus-visible {
    outline: 2px solid var(--spark-deep);
    outline-offset: 3px;
  }

  /* ---------- карточка статьи ---------- */
  /* На .post-card не задаём display: иначе утилита hidden не сможет её спрятать */
  .post-card { min-width: 0; }

  .post {
    display: flex; flex-direction: column; height: 100%;
    background: var(--canvas);
    border: 1px solid var(--stone);
    border-radius: var(--r-card);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }
  .post-photo { aspect-ratio: 16 / 10; overflow: hidden; border-bottom: 1px solid var(--stone); }
  .post-photo img {
    width: 100%; height: 100%; object-fit: cover; display: block;
    transition: transform .5s cubic-bezier(.2, .7, .3, 1);
  }
  .post:hover .post-photo img { transform: scale(1.03); }

  /* Обложка без фотографии: тихая плашка с иконкой темы */
  .post-photo-mark {
    position: relative;
    background: var(--taupe);
    display: flex; align-items: center; justify-content: center;
  }
  .post-photo-mark::after {
    content: "";
    position: absolute; inset: 0;
    background:
      radial-gradient(44% 60% at 22% 20%, rgba(127, 196, 192, .28), transparent 72%),
      radial-gradient(46% 62% at 82% 84%, rgba(169, 163, 214, .24), transparent 74%);
  }
  .post-mark { position: relative; z-index: 1; color: var(--spark-deep); }

  .post-body { padding: 24px; display: flex; flex-direction: column; flex: 1; }
  .post-meta {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; font-size: 12px; color: var(--ash); margin-bottom: 12px;
  }
  .post-cat { color: var(--spark-deep); font-weight: 500; }
  .post-title {
    font-size: 17px; font-weight: 400; line-height: 1.35;
    letter-spacing: -0.01em; margin-bottom: 10px;
  }
  .post-excerpt { font-size: 14px; line-height: 1.6; color: var(--smoke); margin-bottom: 18px; }
  .post-foot {
    margin-top: auto; padding-top: 16px; border-top: 1px solid var(--stone);
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
  }
  .post-date { font-size: 12px; color: var(--ash); }
  .post-more {
    font-size: 14px; font-weight: 500; color: var(--ink);
    display: inline-flex; align-items: center; gap: 7px;
  }
  .post-more :global(svg) { transition: transform .3s cubic-bezier(.2, .7, .3, 1); }
  .post:hover .post-more :global(svg) { transform: translateX(3px); }

  /* ---------- пустое состояние ---------- */
  /* display тоже не задаём — прячет утилита hidden */
  .empty { text-align: center; padding: 72px 0 8px; }
  .empty-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 52px; height: 52px; border-radius: 16px;
    background: var(--canvas); border: 1px solid var(--stone);
    color: var(--spark-deep); margin-bottom: 20px;
  }
  /* Это абзац, а не заголовок: то, что h2 получал от базового правила, задаём сами */
  .empty-title {
    margin-bottom: 8px;
    font-weight: 300; letter-spacing: -0.02em; text-wrap: balance; color: var(--ink);
  }

  /* ---------- адаптив ---------- */
  @media (max-width: 1023px) {
    .cards-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 767px) {
    .page-hero { padding: 20px 0 40px; }
    .band { padding: 56px 0 72px; }
    .cards-3 { grid-template-columns: 1fr; }
    .filters { gap: 8px; }
    .category-filter { padding: 10px 16px; font-size: 13px; }
  }
</style>

<script>
  // Фильтрация по категориям
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.category-filter');
  const posts = document.querySelectorAll<HTMLElement>('.post-card');
  const emptyState = document.getElementById('empty-state');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      // Активная кнопка всегда одна
      filterButtons.forEach((btn) => {
        btn.classList.remove('active');
        btn.setAttribute('aria-pressed', 'false');
      });
      button.classList.add('active');
      button.setAttribute('aria-pressed', 'true');

      const category = button.dataset.category;
      let visibleCount = 0;

      posts.forEach((post) => {
        if (category === 'all' || post.dataset.category === category) {
          post.classList.remove('hidden');
          visibleCount++;
        } else {
          post.classList.add('hidden');
        }
      });

      // Показать/скрыть пустое состояние
      if (visibleCount === 0) {
        emptyState?.classList.remove('hidden');
      } else {
        emptyState?.classList.add('hidden');
      }
    });
  });
</script>
