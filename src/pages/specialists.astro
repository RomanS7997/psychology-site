---
// src/pages/specialists.astro
import Layout from '../layouts/Layout.astro';
import { webp, dims, altOf } from '../utils/img';
import ScrollAnimations from '../components/ScrollAnimations.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SEO from '../components/SEO.astro';
import Icon from '../components/Icon.astro';
import RelatedCards from '../components/RelatedCards.astro';
import { url } from '../utils/url';
import { serviceCard } from '../data/services';
import { specialists } from '../data/specialists';

// Разметка команды. Юлия — тот же узел, что автор статей и хозяйка кабинета
// (#julia); остальные трое описаны здесь: имя, роль и фото — как в карточках.
const siteRoot = new URL(url('/'), Astro.site).href;
const pageUrl = new URL(url('/specialists'), Astro.site).href;
const teamSchema = [{
  '@type': 'ItemList',
  '@id': `${pageUrl}#team`,
  name: 'Специалисты кабинета',
  numberOfItems: specialists.length,
  itemListElement: specialists.map((person, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: index === 0
      ? { '@id': `${siteRoot}#julia` }
      : {
          '@type': 'Person',
          '@id': `${pageUrl}#${person.id}`,
          name: person.name,
          jobTitle: person.role,
          image: new URL(url(person.photo), Astro.site).href,
          url: `${pageUrl}#${person.id}`,
          worksFor: { '@id': `${siteRoot}#business` },
        },
  })),
}];
---

<Layout
  title="Логопед, монтессори-педагог, репетитор | Лесной городок"
  description="Нас четверо: психолог, монтессори-педагог, логопед и педагог-репетитор. О каждом — образование и направления работы. Не знаете, кого выбрать, — напишите мне."
>
  <SEO
    slot="head"
    title="Логопед, монтессори-педагог, репетитор | Лесной городок"
    description="Нас четверо: психолог, монтессори-педагог, логопед и педагог-репетитор. О каждом — образование и направления работы. Не знаете, кого выбрать, — напишите мне."
    schema="person"
    extraSchema={teamSchema}
  />

  <Breadcrumbs
    items={[
      { label: 'Главная', href: url('/') },
      { label: 'Специалисты' }
    ]}
  />

  <!-- ============ Шапка страницы ============ -->
  <section class="page-hero">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="hero-head" data-reveal>
          <p class="eyebrow mb-3">Психолог, логопед, педагоги</p>
          <h1 class="display mb-5">Моя команда профессионалов</h1>
          <p class="lede max-w-[58ch]">
            Познакомьтесь со мной и моей командой педагогов: опытные специалисты
            кабинета в Лесном городке, которые помогут вам и вашим детям
          </p>

          <div class="hero-figures hairline">
            <div>
              <div class="figure-value">4</div>
              <div class="figure-label">специалиста</div>
            </div>
            <div>
              <div class="figure-value" data-counter>15+</div>
              <div class="figure-label">лет опыта</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Специалисты ============ -->
  <section class="band band-taupe">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="specialists-stack">
          {specialists.map((person, index) => (
            <article
              id={person.id}
              class="specialist-card"
              data-categories={person.categories}
              data-reveal
            >
              <div class="specialist-grid">

                <!-- Фото и бейджи -->
                <div class="specialist-aside">
                  <div class="specialist-photo">
                    <picture>
  {webp(person.photo) && <source srcset={webp(person.photo)} type="image/webp" />}
  <img src={url(person.photo)} {...dims(person.photo)} alt={altOf(person.photo, person.name)} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : undefined} decoding="async" />
</picture>
                  </div>
                  <div class="specialist-badges">
                    <span class="badge badge-accent">{person.badges[0]}</span>
                    <span class="badge badge-plain">{person.badges[1]}</span>
                  </div>
                </div>

                <!-- Описание -->
                <div class="specialist-body">
                  <h2 class="heading-sm mb-2">{person.name}</h2>
                  <p class="specialist-role">{person.role}</p>

                  {person.blocks.map((block) => (
                    <div class="block">
                      {block.title && (
                        <h3 class="block-title">
                          {block.icon && <Icon name={block.icon} size={18} />}
                          {block.title}
                        </h3>
                      )}

                      {block.type === 'list' && (
                        <ul class="dot-list">
                          {block.items.map((li) => <li>{li}</li>)}
                        </ul>
                      )}

                      {block.type === 'checks' && (
                        <ul class="check-list">
                          {block.items.map((li) => <li>{li}</li>)}
                        </ul>
                      )}

                      {block.type === 'tags' && (
                        <div class="tag-row">
                          {block.items.map((tag) => <span class="tag">{tag}</span>)}
                        </div>
                      )}

                      {block.type === 'figures' && (
                        <div class="figure-row hairline">
                          {block.items.map((fig) => (
                            <div>
                              <div class="figure-value">{fig.value}</div>
                              <div class="figure-label">{fig.label}</div>
                            </div>
                          ))}
                        </div>
                      )}

                      {block.type === 'text' && (
                        <div class="block-text">
                          {block.items.map((p) => <p>{p}</p>)}
                        </div>
                      )}

                      {block.more && (
                        <p class="block-more">
                          <a href={url(block.more.href)}>{block.more.label}</a>
                        </p>
                      )}
                    </div>
                  ))}

                  <button
                    onclick={`openBookingModal('specialist:${person.name}:${person.role}:${person.categories.includes('children') ? 'kids' : 'adult'}')`}
                    class="pill pill-solid specialist-cta"
                    type="button"
                  >
                    {person.cta}
                  </button>
                </div>

              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Финальный призыв ============ -->
  <section class="band band-tight">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="glow-band closing-band" data-reveal>
          <p class="eyebrow eyebrow-center mb-4">Запись</p>
          <h2 class="heading mb-4">Не знаете, какой специалист вам подойдёт?</h2>
          <p class="lede mb-8">
            Оставьте заявку, и я помогу подобрать специалиста под ваш запрос
          </p>
          <div class="closing-actions">
            <button onclick="openBookingModal('default')" class="pill pill-solid pill-lg" type="button">
              Записаться на консультацию
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Смотрите также ============ -->
  <RelatedCards
    items={[
      serviceCard('/services/adult'),
      serviceCard('/services/children'),
      serviceCard('/services/school-prep'),
    ]}
    tone="taupe"
  />

  <ScrollAnimations />
</Layout>

<style>
  /* ---------- ритм страницы ---------- */
  .band { padding: 96px 0; }
  .band-tight { padding: 24px 0 96px; }

  .page-hero { padding: 28px 0 72px; background: var(--canvas); }
  .hero-head { max-width: 760px; }

  /* ---------- цифры опыта ---------- */
  .hero-figures {
    display: flex; flex-wrap: wrap; gap: 40px;
    margin-top: 36px; padding-top: 24px;
  }
  .figure-value {
    font-size: 27px; font-weight: 300; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums; color: var(--ink); margin-bottom: 2px;
  }
  .figure-label { font-size: 13px; color: var(--smoke); }

  .figure-row {
    display: flex; flex-wrap: wrap; gap: 40px; padding-top: 18px;
  }
  .figure-row .figure-value { font-size: 24px; }

  /* ---------- карточка специалиста ---------- */
  .specialists-stack { display: grid; gap: 24px; }

  .specialist-card {
    background: var(--canvas);
    border: 1px solid var(--stone);
    border-radius: var(--r-large);
    overflow: hidden;
  }

  .specialist-grid {
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    gap: 0;
  }

  .specialist-aside {
    display: flex; flex-direction: column;
    background: var(--taupe);
    border-right: 1px solid var(--stone);
  }

  .specialist-photo { aspect-ratio: 3 / 4; overflow: hidden; }
  .specialist-photo img {
    width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block;
  }

  /* Бейджи стоят сразу под фото, а не плавают в середине пустой колонки */
  .specialist-badges {
    display: flex; flex-direction: column; align-items: center;
    gap: 10px; padding: 22px 20px 26px;
  }

  .badge {
    font-size: 13px; font-weight: 500; letter-spacing: 0.01em;
    padding: 8px 16px; border-radius: var(--r-pill);
    text-align: center;
  }
  .badge-accent { background: rgba(47, 125, 150, 0.1); color: var(--spark-deep); }
  .badge-plain { border: 1px solid var(--stone); color: var(--graphite); }

  .specialist-body { padding: 40px 44px; }
  .specialist-role { font-size: 15px; color: var(--smoke); margin-bottom: 32px; }

  /* ---------- блоки внутри карточки ---------- */
  .block { margin-bottom: 30px; }
  .block:last-of-type { margin-bottom: 34px; }

  .block-title {
    display: flex; align-items: center; gap: 9px;
    font-size: 15px; font-weight: 500; letter-spacing: -0.01em;
    color: var(--ink); margin-bottom: 14px;
  }
  .block-title :global(svg) { color: var(--spark-deep); flex-shrink: 0; }

  /* Строка не должна разъезжаться на всю ширину карточки — читать тяжело */
  .dot-list, .check-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; max-width: 64ch; }

  .dot-list li {
    position: relative; padding-left: 20px;
    font-size: 14.5px; line-height: 1.6; color: var(--smoke);
  }
  .dot-list li::before {
    content: ""; position: absolute; left: 3px; top: 9px;
    width: 5px; height: 5px; border-radius: 50%; background: var(--spark-deep);
  }

  .check-list li {
    position: relative; padding-left: 26px;
    font-size: 14.5px; line-height: 1.6; color: var(--smoke);
  }
  .check-list li::before {
    content: ""; position: absolute; left: 0; top: 7px;
    width: 12px; height: 6px;
    border-left: 1.6px solid var(--spark-water);
    border-bottom: 1.6px solid var(--spark-water);
    transform: rotate(-45deg);
  }

  .tag-row { display: flex; flex-wrap: wrap; gap: 7px; }
  .tag {
    font-size: 12.5px; padding: 6px 13px; border-radius: var(--r-pill);
    background: rgba(47, 125, 150, 0.09); color: var(--spark-deep);
  }

  .block-text { max-width: 64ch; }
  .block-text p { font-size: 14.5px; line-height: 1.7; color: var(--smoke); }
  .block-text p + p { margin-top: 12px; }

  /* Тихая ссылка под абзацами «О себе» */
  .block-more { margin-top: 12px; font-size: 14.5px; line-height: 1.7; }
  .block-more a { color: var(--spark-deep); text-decoration: underline; text-underline-offset: 3px; }
  .block-more a:hover { color: var(--ink); }

  .specialist-cta { align-self: flex-start; }

  /* ---------- финальный призыв ---------- */
  .closing-band { padding: 56px 48px; text-align: center; }
  .closing-band .lede { max-width: 48ch; margin-inline: auto; }
  .closing-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }

  /* ---------- адаптив ---------- */
  @media (max-width: 1023px) {
    .specialist-grid { grid-template-columns: 280px minmax(0, 1fr); }
    .specialist-body { padding: 32px; }
  }

  @media (max-width: 767px) {
    .band { padding: 64px 0; }
    .band-tight { padding: 8px 0 64px; }
    .page-hero { padding: 20px 0 56px; }
    .specialist-grid { grid-template-columns: 1fr; }
    .specialist-aside { border-right: 0; border-bottom: 1px solid var(--stone); }
    .specialist-photo { aspect-ratio: 4 / 3; }
    .specialist-body { padding: 28px 24px; }
    .specialist-cta { width: 100%; }
    .hero-figures { gap: 28px; }
    .closing-band { padding: 32px 24px; }
  }
</style>
