---
// src/pages/specialists.astro
import Layout from '../layouts/Layout.astro';
import { webp } from '../utils/img';
import ScrollAnimations from '../components/ScrollAnimations.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SEO from '../components/SEO.astro';
import Icon from '../components/Icon.astro';
import { url } from '../utils/url';

// Карточки специалистов. Блоки идут в том же порядке, что и раньше:
// list — перечисление с точкой, checks — с галочкой, tags — пилюли,
// figures — цифры опыта, text — абзацы.
const specialists = [
  {
    id: 'specialist-1',
    categories: 'adult family',
    name: 'Юлия Ляпина',
    role: 'Психолог, монтессори-педагог, работа с детьми и взрослыми',
    photo: '/images/specialists/julia-lyapina.jpg',
    badges: ['Психолог', '15+ лет опыта'],
    cta: 'Записаться к Юлии Ляпиной',
    blocks: [
      {
        type: 'list',
        icon: 'book',
        title: 'Образование:',
        items: [
          'СГУ им. Н.Г. Чернышевского, факультет психологии',
          'Факультет коррекционной педагогики и специальной психологии',
          'Ассоциация монтессори-педагогов',
          'Ассоциация сказкотерапевтов России',
          'Институт психотерапии и клинической психологии',
        ],
      },
      {
        type: 'tags',
        title: 'Специализация:',
        items: ['Психолог-консультант', 'Семейный психолог', 'Детский психолог', 'Коррекционный педагог'],
      },
      {
        type: 'checks',
        title: 'Методы работы:',
        items: [
          'Арт-терапия',
          'Когнитивно-поведенческая терапия (КПТ)',
          'МАК (метафорические ассоциативные карты)',
          'ДПДГ, расстановки',
          'Системный подход в семейной терапии',
        ],
      },
      {
        type: 'figures',
        items: [{ value: '15', label: 'лет практики' }],
      },
      {
        type: 'text',
        title: 'О себе:',
        items: [
          'Я работаю с клиентами более 15 лет. Использую научно обоснованные методы. Моя задача — не держать клиентов годами в терапии, а научить самостоятельно справляться с трудностями.',
        ],
      },
    ],
  },
  {
    id: 'specialist-2',
    categories: 'children',
    name: 'Власихина Людмила Степановна',
    role: 'Монтессори-педагог, 3–6 лет',
    photo: '/images/specialists/vlasihina-lyudmila.jpg',
    badges: ['Монтессори-педагог', '20+ лет опыта'],
    cta: 'Записать ребёнка',
    blocks: [
      {
        type: 'list',
        icon: 'book',
        title: 'Образование:',
        items: ['Ассоциация Монтессори-педагогов России'],
      },
      {
        type: 'tags',
        title: 'Специализация:',
        items: ['Дети 3–6 лет', 'Монтессори-методика', 'Подготовка к школе', 'Дошкольное развитие'],
      },
      {
        type: 'checks',
        title: 'Направления работы:',
        items: [
          'Математика и обучение чтению',
          'Сенсорика и развитие логики',
          'Творческие навыки',
          'Подготовка к школе',
        ],
      },
      {
        type: 'checks',
        title: 'Методы работы:',
        items: ['Методика Монтессори', 'Кубики Зайцева', 'Авторские наработки из личного опыта'],
      },
      {
        type: 'text',
        title: 'О себе:',
        items: [
          'Работаю с детьми дошкольного возраста. Готовлю детей к школе: математика, чтение, сенсорика, развитие логики и творческие навыки. Применяю методику кубиков Зайцева, Монтессори и личный опыт.',
        ],
      },
    ],
  },
  {
    id: 'specialist-3',
    categories: 'children',
    name: 'Евграфова Наталья Викторовна',
    role: 'Учитель-логопед, учитель русского языка и литературы',
    photo: '/images/specialists/evgrafova-natalia.jpg',
    badges: ['Логопед', 'Учитель русского языка'],
    cta: 'Записать ребёнка',
    blocks: [
      {
        type: 'list',
        icon: 'book',
        title: 'Образование:',
        items: [
          'РГПУ им. А.И. Герцена — высшее, филологический факультет',
          'ФГБНУ «ИСиО РАО» — высшее, логопедический факультет',
        ],
      },
      {
        type: 'list',
        icon: 'note',
        title: 'Дополнительное образование:',
        items: [
          'Курсы Пятибратовой Н.В. по инновационным методикам',
          'Курсы Поневежской Т.Ю. — нейропсихологический подход к пониманию и преодолению школьных трудностей',
          'АНО ДПО «Северо-Западная академия профессионального образования и профессионального обучения» — «Нарушение письма у школьников»',
          'Учебный центр «Профи» — «Педагог по скорочтению и развитию памяти у младших школьников»',
          'Курсы Светланы Томилиной «Логопедический массаж»',
          'Курсы Ангелины Сыщенко «Запуск речи и ССС»',
        ],
      },
      {
        type: 'tags',
        title: 'Специализация:',
        items: [
          'Дети 4–18 лет',
          'Логопедия',
          'Русский язык и литература',
          'Подготовка к ВПР, ОГЭ, ЕГЭ',
          'Скорочтение и развитие памяти',
        ],
      },
      {
        type: 'checks',
        title: 'Направления работы логопеда:',
        items: [
          'Постановка звуков и коррекция произношения',
          'Развитие речи и грамматики',
          'Артикуляционная моторика',
          'Развитие фонематического слуха',
        ],
      },
      {
        type: 'text',
        title: 'Навыки:',
        items: [
          'Владение грамотной речью и современными методами подачи знаний, навыки репетиторства, умение организовать учебный процесс, индивидуальный подход к учащимся. Опыт работы с детьми от 4 до 18 лет. Многолетний опыт подготовки учащихся к ВПР, ОГЭ и ЕГЭ.',
        ],
      },
    ],
  },
  {
    id: 'specialist-4',
    categories: 'children',
    name: 'Стрижкова Наталья Петровна',
    role: 'Педагог, репетитор',
    photo: '/images/specialists/strizhkova-natalia.jpg',
    badges: ['Педагог, репетитор', '26+ лет опыта'],
    cta: 'Записать ребёнка',
    blocks: [
      {
        type: 'list',
        icon: 'book',
        title: 'Образование:',
        items: ['Оренбургский государственный университет — высшее (1999)'],
      },
      {
        type: 'tags',
        title: 'Специализация:',
        items: [
          'Дети 4–6 лет',
          'Школьники 1–6 класса',
          'Подготовка к школе',
          'Домашние задания',
          'Коррекционная работа',
        ],
      },
      {
        type: 'checks',
        title: 'Направления работы:',
        items: [
          'Подготовка детей 4–6 лет к школе',
          'Помощь в освоении учебного материала (1–6 класс)',
          'Выполнение домашних заданий',
          'Нейрогимнастика и упражнения для развития личности',
        ],
      },
      {
        type: 'figures',
        items: [
          { value: '18', label: 'лет в школе' },
          { value: '8', label: 'лет репетитором' },
        ],
      },
      {
        type: 'text',
        title: 'О себе:',
        items: [
          'Активная и позитивная, доброжелательная, но строгая. Нахожу контакт и с детьми, и с их родителями. В группах работаю с применением современных технологий, нейрогимнастики и различных упражнений для развития личности. Применяю индивидуальный подход в освоении учебного материала — в зависимости от способностей ребёнка.',
          'Есть печатные работы по обучению коррекционных детей, по этике, эстетике и нравственному воспитанию. Проводила обучающие семинары для учителей.',
        ],
      },
    ],
  },
];
---

<SEO
  title="Моя команда - Специалисты в Одинцово | Кабинет психолога"
  description="Психолог и педагоги в Одинцово. Квалифицированная помощь взрослым и детям. Познакомьтесь с моей командой."
  keywords="психолог Одинцово, специалисты, команда педагогов"
  schema="person"
/>

<Layout
  title="Моя команда - Специалисты в Одинцово | Кабинет психолога"
  description="Психолог и педагоги в Одинцово."
>

  <Breadcrumbs
    items={[
      { label: 'Главная', href: url('/') },
      { label: 'Специалисты' }
    ]}
  />

  <!-- ============ Шапка страницы ============ -->
  <section class="page-hero">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="hero-head" data-reveal>
          <p class="eyebrow mb-3">Команда</p>
          <h1 class="display mb-5">Моя команда профессионалов</h1>
          <p class="lede max-w-[58ch]">
            Познакомьтесь со мной и моей командой педагогов — опытными специалистами,
            которые помогут вам и вашим детям
          </p>

          <div class="hero-figures hairline">
            <div>
              <div class="figure-value">4</div>
              <div class="figure-label">специалиста</div>
            </div>
            <div>
              <div class="figure-value" data-counter="15" data-suffix="+">0</div>
              <div class="figure-label">лет опыта</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Специалисты ============ -->
  <section class="band band-taupe">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="specialists-stack">
          {specialists.map((person) => (
            <article
              id={person.id}
              class="specialist-card"
              data-categories={person.categories}
              data-reveal
            >
              <div class="specialist-grid">

                <!-- Фото и бейджи -->
                <div class="specialist-aside">
                  <div class="specialist-photo">
                    <picture>
  {webp(person.photo) && <source srcset={webp(person.photo)} type="image/webp" />}
  <img src={url(person.photo)} alt={person.name} loading="lazy" decoding="async" />
</picture>
                  </div>
                  <div class="specialist-badges">
                    <span class="badge badge-accent">{person.badges[0]}</span>
                    <span class="badge badge-plain">{person.badges[1]}</span>
                  </div>
                </div>

                <!-- Описание -->
                <div class="specialist-body">
                  <h2 class="heading-sm mb-2">{person.name}</h2>
                  <p class="specialist-role">{person.role}</p>

                  {person.blocks.map((block) => (
                    <div class="block">
                      {block.title && (
                        <h3 class="block-title">
                          {block.icon && <Icon name={block.icon} size={18} />}
                          {block.title}
                        </h3>
                      )}

                      {block.type === 'list' && (
                        <ul class="dot-list">
                          {block.items.map((li) => <li>{li}</li>)}
                        </ul>
                      )}

                      {block.type === 'checks' && (
                        <ul class="check-list">
                          {block.items.map((li) => <li>{li}</li>)}
                        </ul>
                      )}

                      {block.type === 'tags' && (
                        <div class="tag-row">
                          {block.items.map((tag) => <span class="tag">{tag}</span>)}
                        </div>
                      )}

                      {block.type === 'figures' && (
                        <div class="figure-row hairline">
                          {block.items.map((fig) => (
                            <div>
                              <div class="figure-value">{fig.value}</div>
                              <div class="figure-label">{fig.label}</div>
                            </div>
                          ))}
                        </div>
                      )}

                      {block.type === 'text' && (
                        <div class="block-text">
                          {block.items.map((p) => <p>{p}</p>)}
                        </div>
                      )}
                    </div>
                  ))}

                  <button
                    onclick={`openBookingModal('specialist:${person.name}:${person.role}:${person.categories.includes('children') ? 'kids' : 'adult'}')`}
                    class="pill pill-solid specialist-cta"
                    type="button"
                  >
                    {person.cta}
                  </button>
                </div>

              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Финальный призыв ============ -->
  <section class="band band-tight">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner">
        <div class="glow-band closing-band" data-reveal>
          <p class="eyebrow eyebrow-center mb-4">Запись</p>
          <h2 class="heading mb-4">Не знаете, какой специалист вам подойдёт?</h2>
          <p class="lede mb-8">
            Оставьте заявку, и я помогу подобрать специалиста под ваш запрос
          </p>
          <div class="closing-actions">
            <button onclick="openBookingModal('default')" class="pill pill-solid pill-lg" type="button">
              Записаться на консультацию
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
  <ScrollAnimations />
</Layout>

<style>
  /* ---------- ритм страницы ---------- */
  .band { padding: 96px 0; }
  .band-tight { padding: 24px 0 96px; }

  .page-hero { padding: 28px 0 72px; background: var(--canvas); }
  .hero-head { max-width: 760px; }

  /* ---------- цифры опыта ---------- */
  .hero-figures {
    display: flex; flex-wrap: wrap; gap: 40px;
    margin-top: 36px; padding-top: 24px;
  }
  .figure-value {
    font-size: 27px; font-weight: 300; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums; color: var(--ink); margin-bottom: 2px;
  }
  .figure-label { font-size: 13px; color: var(--smoke); }

  .figure-row {
    display: flex; flex-wrap: wrap; gap: 40px; padding-top: 18px;
  }
  .figure-row .figure-value { font-size: 24px; }

  /* ---------- карточка специалиста ---------- */
  .specialists-stack { display: grid; gap: 24px; }

  .specialist-card {
    background: var(--canvas);
    border: 1px solid var(--stone);
    border-radius: var(--r-large);
    overflow: hidden;
  }

  .specialist-grid {
    display: grid;
    grid-template-columns: 360px minmax(0, 1fr);
    gap: 0;
  }

  .specialist-aside {
    display: flex; flex-direction: column;
    background: var(--taupe);
    border-right: 1px solid var(--stone);
  }

  .specialist-photo { aspect-ratio: 3 / 4; overflow: hidden; }
  .specialist-photo img {
    width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block;
  }

  /* Бейджи стоят сразу под фото, а не плавают в середине пустой колонки */
  .specialist-badges {
    display: flex; flex-direction: column; align-items: center;
    gap: 10px; padding: 22px 20px 26px;
  }

  .badge {
    font-size: 13px; font-weight: 500; letter-spacing: 0.01em;
    padding: 8px 16px; border-radius: var(--r-pill);
    text-align: center;
  }
  .badge-accent { background: rgba(47, 125, 150, 0.1); color: var(--spark-deep); }
  .badge-plain { border: 1px solid var(--stone); color: var(--graphite); }

  .specialist-body { padding: 40px 44px; }
  .specialist-role { font-size: 15px; color: var(--smoke); margin-bottom: 32px; }

  /* ---------- блоки внутри карточки ---------- */
  .block { margin-bottom: 30px; }
  .block:last-of-type { margin-bottom: 34px; }

  .block-title {
    display: flex; align-items: center; gap: 9px;
    font-size: 15px; font-weight: 500; letter-spacing: -0.01em;
    color: var(--ink); margin-bottom: 14px;
  }
  .block-title :global(svg) { color: var(--spark-deep); flex-shrink: 0; }

  /* Строка не должна разъезжаться на всю ширину карточки — читать тяжело */
  .dot-list, .check-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 9px; max-width: 64ch; }

  .dot-list li {
    position: relative; padding-left: 20px;
    font-size: 14.5px; line-height: 1.6; color: var(--smoke);
  }
  .dot-list li::before {
    content: ""; position: absolute; left: 3px; top: 9px;
    width: 5px; height: 5px; border-radius: 50%; background: var(--spark-deep);
  }

  .check-list li {
    position: relative; padding-left: 26px;
    font-size: 14.5px; line-height: 1.6; color: var(--smoke);
  }
  .check-list li::before {
    content: ""; position: absolute; left: 0; top: 7px;
    width: 12px; height: 6px;
    border-left: 1.6px solid var(--spark-water);
    border-bottom: 1.6px solid var(--spark-water);
    transform: rotate(-45deg);
  }

  .tag-row { display: flex; flex-wrap: wrap; gap: 7px; }
  .tag {
    font-size: 12.5px; padding: 6px 13px; border-radius: var(--r-pill);
    background: rgba(47, 125, 150, 0.09); color: var(--spark-deep);
  }

  .block-text { max-width: 64ch; }
  .block-text p { font-size: 14.5px; line-height: 1.7; color: var(--smoke); }
  .block-text p + p { margin-top: 12px; }

  .specialist-cta { align-self: flex-start; }

  /* ---------- финальный призыв ---------- */
  .closing-band { padding: 56px 48px; text-align: center; }
  .closing-band .lede { max-width: 48ch; margin-inline: auto; }
  .closing-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }

  /* ---------- адаптив ---------- */
  @media (max-width: 1023px) {
    .specialist-grid { grid-template-columns: 280px minmax(0, 1fr); }
    .specialist-body { padding: 32px; }
  }

  @media (max-width: 767px) {
    .band { padding: 64px 0; }
    .band-tight { padding: 8px 0 64px; }
    .page-hero { padding: 20px 0 56px; }
    .specialist-grid { grid-template-columns: 1fr; }
    .specialist-aside { border-right: 0; border-bottom: 1px solid var(--stone); }
    .specialist-photo { aspect-ratio: 4 / 3; }
    .specialist-body { padding: 28px 24px; }
    .specialist-cta { width: 100%; }
    .hero-figures { gap: 28px; }
    .closing-band { padding: 32px 24px; }
  }
</style>
