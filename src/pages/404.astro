---
// src/pages/404.astro — страница «не найдено»
import Layout from '../layouts/Layout.astro';
import ScrollAnimations from '../components/ScrollAnimations.astro';
import Icon from '../components/Icon.astro';
import { url } from '../utils/url';

// Куда можно уйти со страницы ошибки
const suggestions = [
  {
    title: 'Консультирование взрослых',
    text: 'Помощь психолога при тревоге, отношениях, развитии детей',
    href: url('/services/adult'),
  },
  {
    title: 'Консультирование детей',
    text: 'Детский психолог для детей и подростков',
    href: url('/services/children'),
  },
  {
    title: 'Умники и умницы',
    text: 'Программа подготовки к школе для детей 4-7 лет',
    href: url('/programs/umniky'),
  },
  {
    title: 'Азбука общения',
    text: 'Развитие эмоционального интеллекта для детей 5-9 лет',
    href: url('/programs/azbuka'),
  },
  {
    title: 'Блог',
    text: 'Полезные статьи о психологии',
    href: url('/blog'),
  },
];
---

<Layout
  title="Страница не найдена | Кабинет психолога Ляпина Юлия"
  description="Запрашиваемая страница не найдена"
>

  <section class="band notfound">
    <div class="container mx-auto px-4 lg:px-8">
      <div class="inner-narrow">

        <!-- Большая 404 -->
        <div class="code" data-reveal aria-hidden="true">404</div>

        <!-- Текст ошибки -->
        <div class="intro" data-reveal>
          <p class="eyebrow eyebrow-center mb-4">Ошибка</p>
          <h1 class="display mb-4">Страница не найдена</h1>
          <p class="lede mb-2">
            К сожалению, запрашиваемая страница не существует или была удалена
          </p>
          <p class="muted-note">
            Возможно, вы перешли по устаревшей ссылке или ошиблись в адресе
          </p>
        </div>

        <!-- Кнопки навигации -->
        <div class="actions" data-reveal>
          <a href={url('/')} class="pill pill-solid pill-lg">На главную</a>
          <a href={url('/contact')} class="pill pill-outline pill-lg">Связаться с нами</a>
        </div>

        <!-- Популярные страницы -->
        <div class="suggest" data-reveal>
          <h2 class="suggest-title">Возможно, вас заинтересует:</h2>

          <div class="suggest-list">
            {suggestions.map((item) => (
              <a href={url(item.href)} class="suggest-item">
                <span class="suggest-body">
                  <span class="suggest-name">{item.title}</span>
                  <span class="suggest-text">{item.text}</span>
                </span>
                <span class="suggest-arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
              </a>
            ))}
          </div>
        </div>

        <!-- Контакты -->
        <div class="contacts" data-reveal>
          <p class="contacts-lead">Нужна помощь? Свяжитесь с нами:</p>
          <div class="contacts-row">
            <a href="tel:+79151955132" class="contact-link">
              <Icon name="phone" size={17} />+7 (915) 195-51-32
            </a>
            <a href="mailto:lyapina_sorokina@mail.ru" class="contact-link">
              <Icon name="mail" size={17} />lyapina_sorokina@mail.ru
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <ScrollAnimations />
</Layout>

<style>
  /* ---------- ритм секции ---------- */
  .band { padding: 96px 0; background: var(--canvas); }
  .notfound { padding-top: 152px; }
  .inner-narrow-unused { max-width: 640px; margin: 0 auto; text-align: center; }

  /* ---------- крупный номер ошибки ---------- */
  .code {
    font-size: clamp(88px, 17vw, 168px);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--stone);
    font-variant-numeric: tabular-nums;
    margin-bottom: 28px;
  }

  /* ---------- текст ошибки ---------- */
  .intro { margin-bottom: 36px; }
  .intro .lede { max-width: 46ch; margin-inline: auto; }
  .muted-note { font-size: 15px; line-height: 1.6; color: var(--ash); }

  /* ---------- кнопки ---------- */
  .actions {
    display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;
    margin-bottom: 56px;
  }

  /* ---------- подборка страниц ---------- */
  .suggest {
    text-align: left;
    background: var(--taupe);
    border: 1px solid var(--stone);
    border-radius: var(--r-large);
    padding: 32px;
  }
  .suggest-title {
    font-size: 18px; font-weight: 400; line-height: 1.3;
    letter-spacing: -0.01em; color: var(--ink); margin-bottom: 20px;
  }
  .suggest-list { display: grid; gap: 10px; }
  .suggest-item {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 16px 18px;
    background: var(--canvas);
    border: 1px solid var(--stone);
    border-radius: var(--r-card);
    transition: border-color .25s ease, transform .25s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .suggest-item:hover { border-color: var(--graphite); transform: translateY(-2px); }
  .suggest-body { display: grid; gap: 4px; }
  .suggest-name {
    font-size: 15.5px; font-weight: 500; line-height: 1.35;
    letter-spacing: -0.01em; color: var(--ink);
  }
  .suggest-text { font-size: 14px; line-height: 1.5; color: var(--smoke); }
  .suggest-arrow {
    flex-shrink: 0; color: var(--ash);
    transition: color .25s ease, transform .25s ease;
  }
  .suggest-item:hover .suggest-arrow { color: var(--spark-deep); transform: translateX(3px); }

  /* ---------- контакты ---------- */
  .contacts { margin-top: 48px; }
  .contacts-lead { font-size: 15px; color: var(--smoke); margin-bottom: 14px; }
  .contacts-row {
    display: flex; align-items: center; justify-content: center;
    gap: 12px 26px; flex-wrap: wrap;
  }
  .contact-link {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 15px; color: var(--ink); transition: color .2s ease;
  }
  .contact-link :global(svg) { color: var(--spark-deep); }
  .contact-link:hover { color: var(--spark-deep); }

  /* ---------- адаптив ---------- */
  @media (max-width: 767px) {
    .band { padding: 64px 0; }
    .notfound { padding-top: 128px; }
    .code { margin-bottom: 20px; }
    .actions { margin-bottom: 44px; }
    .suggest { padding: 24px 20px; }
    .suggest-item { padding: 14px 16px; }
  }
</style>
