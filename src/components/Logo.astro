---
// Знак и подпись кабинета.
interface Props {
  compact?: boolean;
  class?: string;
}

const { compact = false, class: className = '' } = Astro.props;
import { url } from '../utils/url';
---

<span class={`logo ${className}`}>
  <img
    class="logo-mark"
    src={url('/images/logo-256.png')}
    srcset={`${url('/images/logo-256.png')} 1x, ${url('/images/logo.png')} 2x`}
    alt=""
    width="44"
    height="44"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />

  {!compact && (
    <span class="logo-text">
      <span class="logo-name">Юлия Ляпина</span>
      <span class="logo-role">кабинет психолога</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--ink);
    text-decoration: none;
  }

  .logo-mark {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    display: block;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .logo:hover .logo-mark {
    transform: scale(1.04);
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .logo-name {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .logo-role {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ash);
    margin-top: 2px;
  }

  @media (max-width: 340px) {
    .logo-text { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-mark { transition: none; }
  }
</style>
