---
// src/components/Breadcrumbs.astro
// Крошки всегда стоят первым блоком страницы, поэтому отступ под закреплённую
// шапку живёт здесь — страницам его добавлять не нужно.
interface Props {
  items: {
    label: string;
    href?: string;
  }[];
}

const { items } = Astro.props;

// Поисковику цепочка нужна разметкой, а не только глазами: так в выдаче
// вместо голого адреса показывают путь «Главная → Услуги → Страница».
const absolute = (href: string) => new URL(href, Astro.site).href;
const crumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: absolute(item.href) } : {}),
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(crumbSchema)} is:inline />

<nav aria-label="Хлебные крошки" class="crumbs">
  <div class="container mx-auto px-4 lg:px-8">
    <ol class="crumb-list">
      {items.map((item, index) => (
        <li class="crumb-item">
          {index > 0 && (
            <svg class="crumb-sep" width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
            </svg>
          )}

          {item.href ? (
            <a href={item.href} class="crumb-link">{item.label}</a>
          ) : (
            <span class="crumb-current" aria-current="page">{item.label}</span>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  .crumbs {
    padding-top: 120px;
    background: var(--canvas);
  }

  .crumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 13px;
  }

  .crumb-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .crumb-sep {
    color: var(--stone);
    flex-shrink: 0;
  }

  .crumb-link {
    color: var(--smoke);
    transition: color .2s ease;
  }
  .crumb-link:hover { color: var(--ink); }

  .crumb-current { color: var(--graphite); }

  @media (max-width: 768px) {
    .crumbs { padding-top: 104px; }
  }
</style>
