---
// src/components/Header.astro
// Все тексты и пункты меню — в src/data/global.json
import global from '../data/global.json';
import { url } from '../utils/url';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const { site, contacts, menu } = global;
---

<header class="site-header">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="flex items-center justify-between h-24">

      <!-- Logo -->
      <div class="flex items-center gap-3">
        <a href={url('/')} class="flex items-center" aria-label={site.name}>
          <Logo />
        </a>
      </div>

      <!-- Navigation + Contacts -->
      <div class="hidden lg:flex items-center gap-6">

        <!-- Navigation Links -->
        <nav class="flex items-center gap-6">
          <!-- Выпадающее меню Услуги -->
          <div class="relative group">
            <button
              id="services-toggle"
              class="nav-link flex items-center gap-1"
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="services-menu"
            >
              {menu.servicesLabel}
              <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>

            <!-- Dropdown -->
            <div
              id="services-menu"
              class="nav-dropdown absolute left-0 top-full mt-2 w-96 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200"
            >
              <div class="py-2">
                {menu.services.map((item, i) => (
                  <a
                    href={url(item.href)}
                    class={`nav-drop-item block px-6 py-3${i > 0 ? ' nav-drop-sep' : ''}`}
                  >
                    <div class="nav-drop-title">{item.title}</div>
                    <div class="nav-drop-note">{item.note}</div>
                  </a>
                ))}
              </div>
            </div>
          </div>

          {menu.links.map((link) => (
            <a href={url(link.href)} class="nav-link">{link.title}</a>
          ))}
        </nav>

        <!-- Divider -->
        <div class="nav-divider"></div>

        <!-- Contacts -->
        <div class="flex items-center gap-4">
          <!-- Phone -->
          <a
            href={`tel:${contacts.phoneRaw}`}
            class="nav-phone flex items-center gap-2"
          >
            <Icon name="phone" size={18} />
            <span class="hidden xl:inline">{contacts.phone}</span>
          </a>

          <!-- Messengers -->
          <div class="flex items-center gap-2">
            <!-- WhatsApp -->
            <a
              href={contacts.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="nav-messenger"
              title="Написать в WhatsApp"
              aria-label="Написать в WhatsApp"
            >
              <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- CTA Button -->
        <button
          onclick="openBookingModal()"
          class="pill pill-solid"
        >
          {menu.bookButton}
        </button>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 nav-link" aria-label="Меню"
              aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden mobile-menu">
    <div class="container mx-auto px-4 py-4">

      <!-- Mobile Contacts First -->
      <div class="mb-6 pb-6 mobile-contacts">
        <a
          href={`tel:${contacts.phoneRaw}`}
          class="nav-phone flex items-center gap-3 text-lg mb-4"
        >
          <Icon name="phone" size={20} />
          {contacts.phone}
        </a>

        <div class="flex gap-3">
          <a
            href={contacts.whatsapp}
            target="_blank"
            class="pill pill-outline flex-1"
          >
            WhatsApp
          </a>
          <a
            href={contacts.telegram}
            target="_blank"
            class="pill pill-outline flex-1"
          >
            Telegram
          </a>
        </div>
      </div>

      <nav class="flex flex-col gap-4">
        <!-- Mobile Services Dropdown -->
        <div>
          <button id="mobile-services-toggle" class="w-full text-left nav-link font-medium flex items-center justify-between"
                  aria-expanded="false" aria-controls="mobile-services-menu">
            {menu.servicesLabel}
            <svg class="w-4 h-4 transition-transform" id="mobile-services-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
          <div id="mobile-services-menu" class="hidden pl-4 mt-2 space-y-2">
            {menu.services.map((item) => (
              <a href={url(item.href)} class="nav-link block">{item.title}</a>
            ))}
          </div>
        </div>

        {menu.links.map((link) => (
          <a href={url(link.href)} class="nav-link">{link.title}</a>
        ))}

        <button
          onclick="openBookingModal()"
          class="pill pill-solid w-full mt-4"
        >
          {menu.bookButton}
        </button>
      </nav>
    </div>
  </div>
</header>

<script>
  // Выпадающее меню «Услуги»: наведение работало и раньше,
  // здесь добавлена работа с клавиатуры
  const servicesToggle = document.getElementById('services-toggle');
  const servicesMenu = document.getElementById('services-menu');
  const servicesGroup = servicesToggle?.closest('.group');

  function setServicesOpen(open) {
    if (!servicesGroup || !servicesToggle || !servicesMenu) return;
    servicesGroup.classList.toggle('is-open', open);
    servicesMenu.classList.toggle('opacity-0', !open);
    servicesMenu.classList.toggle('invisible', !open);
    servicesToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  servicesToggle?.addEventListener('click', () => {
    setServicesOpen(servicesToggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (servicesToggle?.getAttribute('aria-expanded') === 'true') {
      setServicesOpen(false);
      servicesToggle.focus();
    }
  });

  document.addEventListener('click', (e) => {
    if (!servicesGroup || !(e.target instanceof Node)) return;
    if (!servicesGroup.contains(e.target)) setServicesOpen(false);
  });

  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    // Кнопка должна сообщать своё состояние, а не только менять картинку
    const open = !mobileMenu?.classList.contains('hidden');
    mobileMenuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  const mobileServicesToggle = document.getElementById('mobile-services-toggle');
  const mobileServicesMenu = document.getElementById('mobile-services-menu');
  const mobileServicesArrow = document.getElementById('mobile-services-arrow');

  mobileServicesToggle?.addEventListener('click', () => {
    mobileServicesMenu?.classList.toggle('hidden');
    mobileServicesArrow?.classList.toggle('rotate-180');
    const open = !mobileServicesMenu?.classList.contains('hidden');
    mobileServicesToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    background: rgba(251, 250, 248, 0.86);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--stone);
  }

  .nav-link {
    font-size: 14px;
    color: var(--graphite);
    transition: color 0.2s ease;
  }
  .nav-link:hover { color: var(--ink); }

  .nav-phone {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    transition: opacity 0.2s ease;
  }
  .nav-phone:hover { opacity: 0.7; }

  .nav-divider { width: 1px; height: 32px; background: var(--stone); }

  .group.is-open .nav-dropdown {
    opacity: 1;
    visibility: visible;
  }

  .nav-dropdown {
    background: var(--canvas);
    border: 1px solid var(--stone);
    border-radius: var(--r-card);
    box-shadow: var(--whisper);
    overflow: hidden;
  }
  .nav-drop-item { color: var(--graphite); transition: background-color 0.2s ease, color 0.2s ease; }
  .nav-drop-item:hover { background: var(--taupe); color: var(--ink); }
  .nav-drop-sep { border-top: 1px solid var(--stone); }

  .nav-drop-title { font-weight: 500; font-size: 14.5px; color: var(--ink); }
  .nav-drop-note { font-size: 12.5px; color: var(--ash); margin-top: 2px; }

  .nav-messenger {
    width: 38px; height: 38px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--canvas);
    color: var(--graphite);
    border: 1px solid var(--stone);
    transition: background-color .2s ease, color .2s ease, transform .2s ease;
  }
  .nav-messenger:hover { background: var(--ink); color: #fff; transform: translateY(-1px); }

  .mobile-menu {
    background: var(--canvas);
    border-top: 1px solid var(--stone);
    /* Меню лежит внутри закреплённой шапки: без этого всё, что не влезло
       в высоту экрана, оказывалось за краем и доскроллить было нельзя. */
    max-height: calc(100vh - 96px);
    max-height: calc(100dvh - 96px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* Зона касания в мобильном меню и в раскрытом списке услуг */
  .mobile-menu .nav-link {
    display: flex;
    align-items: center;
    min-height: 44px;
  }
  .mobile-menu nav { gap: 2px; }
  #mobile-services-menu { margin-top: 0; }
  .mobile-contacts { border-bottom: 1px solid var(--stone); }
</style>
