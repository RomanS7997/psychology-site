---
// src/components/SEO.astro
// Мета-теги и разметка Schema.org.
// Все адреса собираются из настроек Astro (astro.config.mjs), а не пишутся строкой:
// при переезде на julialyapina.ru достаточно поменять SITE_URL — здесь править нечего.
import { url } from '../utils/url';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article' | 'service';
  schema?: 'organization' | 'service' | 'person' | 'localbusiness' | 'article' | 'blog';
  /** Цена услуги в рублях — ставится в разметку только там, где она названа на странице. */
  price?: number;
  /** Название услуги для разметки. По умолчанию — заголовок страницы. */
  serviceName?: string;
  keywords?: string;
  image?: string;
  url?: string;
  /** Дата публикации статьи в виде 2025-01-15. Только для schema="article". */
  published?: string;
  /** Дата последней правки статьи. Если не задана — берётся дата публикации. */
  modified?: string;
}

const {
  title,
  description,
  type = 'website',
  schema,
  keywords,
  image = '/images/og-image.jpg',
  url: urlProp,
  published,
  modified,
  price,
  serviceName,
} = Astro.props;

// Полный адрес страницы и картинки — с учётом домена и базового пути
const absolute = (path: string) => new URL(url(path), Astro.site).href;

// Главная приходит как /psychology-site без косой черты на конце, а живёт по адресу
// с чертой — канонический адрес должен совпадать с настоящим, иначе это два адреса.
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = urlProp || new URL(pathname, Astro.site).href;
const imageURL = absolute(image);
// Размеры объявляем только для общей картинки: у статей свои пропорции,
// а соцсети верят заявленным числам и режут превью по ним.
const isDefaultImage = image === '/images/og-image.jpg';
const imageAlt = isDefaultImage
  ? 'Юлия Ляпина — кабинет психолога в Одинцово'
  : title.split('|')[0].trim();
const logoURL = absolute('/images/logo.png');
const siteURL = new URL(url('/'), Astro.site).href;

const fullTitle = title.includes('|') ? title : `${title} | Кабинет психолога Ляпина Юлия`;

const ORG_NAME = 'Кабинет психолога Ляпина Юлия';
const PHONE = '+7-915-195-51-32';
const EMAIL = 'lyapina_sorokina@mail.ru';

// Один и тот же кабинет упоминается на разных страницах. Чтобы поисковик
// видел одну организацию, а не несколько, у неё постоянный @id.
const BUSINESS_ID = `${siteURL}#business`;
const PERSON_ID = `${siteURL}#julia`;
// Профили, на которые ведёт действующий сайт julialyapina.ru: поисковику они
// подтверждают, что сайт и аккаунты — один и тот же человек.
const SAME_AS = ['https://t.me/lyapinajuliya', 'https://vk.com/id220663769'];
const HOURS = {
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
  opens: '09:00',
  closes: '21:00',
};
const GEO = { '@type': 'GeoCoordinates', latitude: '55.634', longitude: '37.193' };

// Адрес указан ровно с той точностью, что и на странице контактов:
// точное место кабинета сообщается при записи, поэтому улицы и индекса здесь нет.
const ADDRESS = {
  '@type': 'PostalAddress',
  addressLocality: 'Одинцово, Лесной городок',
  addressRegion: 'Московская область',
  addressCountry: 'RU',
};

let schemaData: Record<string, unknown> | null = null;

// Главная представляет кабинет как местное предприятие: по простому Organization
// поисковик не понимает, что сюда можно прийти, и не показывает карточку с картой.
if (schema === 'organization') {
  schemaData = {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': BUSINESS_ID,
    name: ORG_NAME,
    description: 'Профессиональная психологическая помощь в Одинцово и Лесном городке',
    url: siteURL,
    logo: logoURL,
    image: imageURL,
    telephone: PHONE,
    email: EMAIL,
    address: ADDRESS,
    geo: GEO,
    areaServed: [
      { '@type': 'Place', name: 'Одинцово' },
      { '@type': 'Place', name: 'Лесной городок' },
      { '@type': 'Place', name: 'Одинцовский городской округ' },
    ],
    openingHoursSpecification: HOURS,
    priceRange: '₽₽',
    currenciesAccepted: 'RUB',
    inLanguage: 'ru-RU',
    founder: { '@id': PERSON_ID },
    knowsAbout: [
      'Детская психология',
      'Семейная терапия',
      'Когнитивно-поведенческая терапия',
      'Арт-терапия',
      'Подготовка к школе',
    ],
    sameAs: SAME_AS,
  };
}

if (schema === 'localbusiness') {
  schemaData = {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': BUSINESS_ID,
    name: ORG_NAME,
    image: imageURL,
    logo: logoURL,
    telephone: PHONE,
    email: EMAIL,
    address: ADDRESS,
    geo: GEO,
    priceRange: '₽₽',
    currenciesAccepted: 'RUB',
    sameAs: SAME_AS,
    url: siteURL,
    // Часы совпадают с тем, что написано человеку на странице контактов
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: [
        'Monday',
        'Tuesday',
        'Wednesday',
        'Thursday',
        'Friday',
        'Saturday',
        'Sunday',
      ],
      opens: '09:00',
      closes: '21:00',
    },
  };
}

if (schema === 'service') {
  schemaData = {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: serviceName || title.split('|')[0].trim(),
    description,
    serviceType: 'Психологическое консультирование',
    provider: {
      '@type': 'ProfessionalService',
      '@id': BUSINESS_ID,
      name: ORG_NAME,
      telephone: PHONE,
      address: ADDRESS,
    },
    areaServed: [
      { '@type': 'Place', name: 'Одинцово' },
      { '@type': 'Place', name: 'Лесной городок' },
    ],
    // Цену ставим только там, где она названа на самой странице:
    // расходиться разметка и текст не должны.
    ...(price
      ? {
          offers: {
            '@type': 'Offer',
            price: String(price),
            priceCurrency: 'RUB',
            availability: 'https://schema.org/InStock',
            url: canonicalURL,
          },
        }
      : {}),
    availableChannel: {
      '@type': 'ServiceChannel',
      serviceUrl: canonicalURL,
      availableLanguage: { '@type': 'Language', name: 'Russian' },
    },
  };
}

if (schema === 'person') {
  schemaData = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Юлия Ляпина',
    // Ровно та формулировка, что стоит в карточке на странице специалистов
    jobTitle: 'Психолог, специалист по работе с детьми и взрослыми',
    worksFor: {
      '@type': 'ProfessionalService',
      '@id': BUSINESS_ID,
      name: ORG_NAME,
    },
    address: ADDRESS,
    telephone: PHONE,
    email: EMAIL,
    url: absolute('/about'),
    knowsAbout: ['Детская психология', 'Семейная терапия', 'Арт-терапия', 'Подготовка к школе'],
  };
}

if (schema === 'blog') {
  schemaData = {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Блог о психологии',
    description,
    url: canonicalURL,
    inLanguage: 'ru-RU',
    publisher: { '@type': 'ProfessionalService', '@id': BUSINESS_ID, name: ORG_NAME },
  };
}

if (schema === 'article') {
  schemaData = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    image: imageURL,
    mainEntityOfPage: canonicalURL,
    // Автор — человек: у текстов о здоровье поисковик смотрит, кто их написал.
    author: {
      '@type': 'Person',
      '@id': PERSON_ID,
      name: 'Юлия Ляпина',
      jobTitle: 'Психолог',
      url: absolute('/about'),
    },
    publisher: {
      '@type': 'ProfessionalService',
      '@id': BUSINESS_ID,
      name: ORG_NAME,
      logo: {
        '@type': 'ImageObject',
        url: logoURL,
      },
    },
    inLanguage: 'ru-RU',
    // Дату передаёт сама статья. Без неё поля нет вовсе — иначе при каждой
    // пересборке все статьи объявляли бы себя опубликованными сегодня.
    ...(published ? { datePublished: published } : {}),
    ...(published ? { dateModified: modified || published } : {}),
  };
}
---

<!-- Основные теги -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{isDefaultImage && <meta property="og:image:width" content="1200" />}
{isDefaultImage && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content={ORG_NAME} />
<meta property="og:locale" content="ru_RU" />

<!-- Карточка ссылки в X: спецификация требует name, а не property -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<!-- Schema.org -->
{schemaData && (
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
)}
