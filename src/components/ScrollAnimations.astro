---
// Компонент для добавления scroll анимаций на всех страницах
---

<script is:inline>
  // Функция для инициализации анимаций
  function initScrollAnimations() {
    // Настройка Intersection Observer
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animate-in', 'shown');
          
          // Для stagger эффекта (элементы появляются по очереди)
          if (entry.target.hasAttribute('data-stagger')) {
            const children = entry.target.children;
            Array.from(children).forEach((child, index) => {
              setTimeout(() => {
                child.classList.add('animate-in');
              }, index * 70); // короткий каскад: 70 мс между соседями
            });
          }
          
          // Для счетчиков внутри элемента
          const counters = entry.target.querySelectorAll('[data-counter]');
          counters.forEach(counter => {
            animateCounter(counter);
          });
          
          // Если сам элемент - счетчик
          if (entry.target.hasAttribute('data-counter')) {
            animateCounter(entry.target);
          }
          
          // Для прогресс-баров
          const progressBars = entry.target.querySelectorAll('[data-progress-bar]');
          progressBars.forEach(bar => {
            animateProgressBar(bar);
          });
          
          // Для линий прогресса (timeline)
          const progressLines = entry.target.querySelectorAll('[data-progress-line]');
          progressLines.forEach(line => {
            animateProgressLine(line);
          });
          
          // Отключаем наблюдение после анимации
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // Находим все элементы для анимации
    const animatedElements = document.querySelectorAll('[data-animate], [data-stagger], [data-reveal], [data-counter]');
    animatedElements.forEach(el => observer.observe(el));

    // Предохранитель: если наблюдатель почему-то молчит (вкладка была скрыта,
    // фоновая отрисовка, старый браузер) — через полторы секунды показываем всё,
    // что уже находится в пределах экрана. Страница не должна остаться пустой.
    setTimeout(function () {
      document.querySelectorAll('[data-reveal]:not(.shown), [data-animate]:not(.animate-in)').forEach(function (el) {
        if (el.getBoundingClientRect().top < window.innerHeight * 1.5) {
          el.classList.add('animate-in', 'shown');
        }
      });
      document.querySelectorAll('[data-counter]').forEach(function (el) {
        if (el.textContent.trim() === '0' && el.getBoundingClientRect().top < window.innerHeight * 1.5) {
          el.textContent = el.getAttribute('data-counter') + (el.getAttribute('data-suffix') || '');
        }
      });
    }, 1500);

    // Вкладка могла быть открыта в фоне — наблюдатель и таймеры там заморожены.
    // Когда её наконец показали, проверяем ещё раз.
    document.addEventListener('visibilitychange', function onShow() {
      if (document.visibilityState !== 'visible') return;
      document.removeEventListener('visibilitychange', onShow);
      setTimeout(function () {
        document.querySelectorAll('[data-reveal]:not(.shown)').forEach(function (el) {
          if (el.getBoundingClientRect().top < window.innerHeight * 1.5) {
            el.classList.add('animate-in', 'shown');
          }
        });
      }, 200);
    });
  }

  // Без поддержки наблюдателя или при отключённом движении показываем сразу
  function revealEverything() {
    document.querySelectorAll('[data-reveal], [data-animate]').forEach(function (el) {
      el.classList.add('animate-in', 'shown');
    });
    document.querySelectorAll('[data-stagger] > *').forEach(function (el) {
      el.classList.add('animate-in');
    });
    document.querySelectorAll('[data-counter]').forEach(function (el) {
      el.textContent = el.getAttribute('data-counter') + (el.getAttribute('data-suffix') || '');
    });
  }

  // Анимация прогресс-баров
  function animateProgressBar(element) {
    const targetWidth = element.getAttribute('data-progress-bar');
    setTimeout(() => {
      element.style.width = targetWidth + '%';
    }, 100);
  }

  // Анимация линии прогресса (для timeline)
  function animateProgressLine(element) {
    setTimeout(() => {
      element.style.height = '100%';
    }, 200);
  }

  // Анимация счетчиков
  function animateCounter(element) {
    const targetStr = element.getAttribute('data-counter');
    const isDecimal = targetStr.includes('.');
    const target = parseFloat(targetStr);
    const duration = 1200;
    const start = 0;
    const increment = target / (duration / 16); // 60 FPS
    let current = start;

    const timer = setInterval(() => {
      current += increment;
      if (current >= target) {
        if (isDecimal) {
          element.textContent = target.toFixed(1) + (element.getAttribute('data-suffix') || '');
        } else {
          element.textContent = Math.floor(target) + (element.getAttribute('data-suffix') || '');
        }
        clearInterval(timer);
      } else {
        if (isDecimal) {
          element.textContent = current.toFixed(1) + (element.getAttribute('data-suffix') || '');
        } else {
          element.textContent = Math.floor(current) + (element.getAttribute('data-suffix') || '');
        }
      }
    }, 16);
  }

  // Инициализация при загрузке страницы
  function bootAnimations() {
    var noMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!('IntersectionObserver' in window) || noMotion) {
      revealEverything();
      return;
    }
    initScrollAnimations();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootAnimations);
  } else {
    bootAnimations();
  }

  // Реинициализация для SPA navigation (если используется)
  document.addEventListener('astro:page-load', bootAnimations);
</script>

<style is:global>
  /* Появление блоков: короткое и мягкое */
  [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity .55s ease-out, transform .55s cubic-bezier(.2, .7, .3, 1);
  }

  [data-reveal].shown,
  [data-reveal].animate-in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    [data-animate],
    [data-stagger] > * {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }

  /* Fade in */
  [data-animate="fade"] {
    opacity: 0;
    transition: opacity .5s ease-out;
  }
  
  [data-animate="fade"].animate-in {
    opacity: 1;
  }

  /* Slide up */
  [data-animate="slide-up"] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .55s ease-out, transform .55s cubic-bezier(.2,.7,.3,1);
  }
  
  [data-animate="slide-up"].animate-in {
    opacity: 1;
    transform: translateY(0);
  }

  /* Slide left */
  [data-animate="slide-left"] {
    opacity: 0;
    transform: translateX(30px);
    transition: opacity .55s ease-out, transform .55s cubic-bezier(.2,.7,.3,1);
  }
  
  [data-animate="slide-left"].animate-in {
    opacity: 1;
    transform: translateX(0);
  }

  /* Slide right */
  [data-animate="slide-right"] {
    opacity: 0;
    transform: translateX(-30px);
    transition: opacity .55s ease-out, transform .55s cubic-bezier(.2,.7,.3,1);
  }
  
  [data-animate="slide-right"].animate-in {
    opacity: 1;
    transform: translateX(0);
  }

  /* Scale */
  [data-animate="scale"] {
    opacity: 0;
    transform: scale(0.95);
    transition: opacity .55s ease-out, transform .55s cubic-bezier(.2,.7,.3,1);
  }
  
  [data-animate="scale"].animate-in {
    opacity: 1;
    transform: scale(1);
  }

  /* Stagger - контейнер видим, дети скрыты */
  [data-stagger] {
    opacity: 1;
  }

  [data-stagger] > * {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .55s ease-out, transform .55s cubic-bezier(.2,.7,.3,1);
  }

  [data-stagger] > *.animate-in {
    opacity: 1;
    transform: translateY(0);
  }

  /* Задержки для разных элементов */
  [data-delay="100"] {
    transition-delay: 0.07s;
  }
  
  [data-delay="200"] {
    transition-delay: 0.14s;
  }
  
  [data-delay="300"] {
    transition-delay: 0.21s;
  }
  
  [data-delay="400"] {
    transition-delay: 0.28s;
  }
</style>
