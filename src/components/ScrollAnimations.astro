---
// Компонент для добавления scroll анимаций на всех страницах
---

<script is:inline>
  // Функция для инициализации анимаций
  function initScrollAnimations() {
    // Настройка Intersection Observer
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    var observerFired = false;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          observerFired = true;
          // Соседи внутри одной сетки выходят по очереди.
          // Считаем только среди таких же анимируемых и снимаем задержку после показа,
          // иначе она остаётся на элементе и тормозит наведение.
          var el = entry.target;
          if (!el.style.transitionDelay && el.parentElement) {
            var siblings = Array.prototype.filter.call(
              el.parentElement.children,
              function (n) { return n.hasAttribute('data-reveal') || n.hasAttribute('data-animate'); }
            );
            var idx = siblings.indexOf(el);
            if (idx > 0 && idx < 8) {
              el.style.transitionDelay = (idx * 70) + 'ms';
              el.addEventListener('transitionend', function clear() {
                el.style.transitionDelay = '';
              }, { once: true });
            }
          }
          el.classList.add('animate-in', 'shown');
          
          // Для stagger эффекта (элементы появляются по очереди)
          if (entry.target.hasAttribute('data-stagger')) {
            const children = entry.target.children;
            Array.from(children).forEach((child, index) => {
              setTimeout(() => {
                child.classList.add('animate-in');
              }, index * 70); // короткий каскад: 70 мс между соседями
            });
          }
          
          // Для счетчиков внутри элемента
          const counters = entry.target.querySelectorAll('[data-counter]');
          counters.forEach(counter => {
            animateCounter(counter);
          });
          
          // Если сам элемент - счетчик
          if (entry.target.hasAttribute('data-counter')) {
            animateCounter(entry.target);
          }
          
          // Для прогресс-баров
          const progressBars = entry.target.querySelectorAll('[data-progress-bar]');
          progressBars.forEach(bar => {
            animateProgressBar(bar);
          });
          
          // Для линий прогресса (timeline)
          const progressLines = entry.target.querySelectorAll('[data-progress-line]');
          progressLines.forEach(line => {
            animateProgressLine(line);
          });
          
          // Отключаем наблюдение после анимации
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // Находим все элементы для анимации
    const animatedElements = document.querySelectorAll('[data-animate], [data-stagger], [data-reveal], [data-counter]');
    animatedElements.forEach(el => observer.observe(el));

    // Предохранитель: если наблюдатель почему-то молчит (вкладка была скрыта,
    // фоновая отрисовка, старый браузер) — через полторы секунды показываем всё,
    // что уже находится в пределах экрана. Страница не должна остаться пустой.
    setTimeout(function () {
      if (observerFired) return;
      document.querySelectorAll('[data-reveal]:not(.shown), [data-animate]:not(.animate-in)').forEach(function (el) {
        if (el.getBoundingClientRect().top < window.innerHeight * 1.5) {
          el.classList.add('animate-in', 'shown');
        }
      });
      document.querySelectorAll('[data-counter]:not(.counter-ready)').forEach(function (el) {
        if (el.getBoundingClientRect().top < window.innerHeight * 1.5) showCounterFinal(el);
      });
    }, 1500);

    // Вкладка могла быть открыта в фоне — наблюдатель и таймеры там заморожены.
    // Когда её наконец показали, проверяем ещё раз.
    document.addEventListener('visibilitychange', function onShow() {
      if (document.visibilityState !== 'visible') return;
      document.removeEventListener('visibilitychange', onShow);
      setTimeout(function () {
        document.querySelectorAll('[data-reveal]:not(.shown)').forEach(function (el) {
          if (el.getBoundingClientRect().top < window.innerHeight * 1.5) {
            el.classList.add('animate-in', 'shown');
          }
        });
      }, 200);
    });
  }

  // Без поддержки наблюдателя или при отключённом движении показываем сразу
  function revealEverything() {
    document.querySelectorAll('[data-reveal], [data-animate]').forEach(function (el) {
      el.classList.add('animate-in', 'shown');
    });
    document.querySelectorAll('[data-stagger] > *').forEach(function (el) {
      el.classList.add('animate-in');
    });
    document.querySelectorAll('[data-counter]').forEach(showCounterFinal);
    // полоски и линии прогресса тоже должны оказаться в конечном состоянии
    document.querySelectorAll('[data-progress-bar]').forEach(function (el) {
      el.style.width = el.getAttribute('data-progress-bar') + '%';
    });
    document.querySelectorAll('[data-progress-line]').forEach(function (el) {
      el.style.height = '100%';
    });
  }

  // Анимация прогресс-баров
  function animateProgressBar(element) {
    const targetWidth = element.getAttribute('data-progress-bar');
    setTimeout(() => {
      element.style.width = targetWidth + '%';
    }, 100);
  }

  // Анимация линии прогресса (для timeline)
  function animateProgressLine(element) {
    setTimeout(() => {
      element.style.height = '100%';
    }, 200);
  }

  // Счётчики.
  //
  // Настоящее число стоит прямо в разметке: <div data-counter>15+</div>.
  // Раньше там был «0», а число дописывала анимация — и всё, что читает
  // страницу без JavaScript (поисковики, превью ссылок в мессенджерах),
  // видело «0 лет практики, 0 клиентов».
  //
  // Число и приставку берём из самого текста, а не из отдельного атрибута:
  // один источник. Поменяли «500+» на «600+» в разметке — анимация сама
  // досчитает до 600, второго места для правки нет.
  //
  // До старта анимации число скрыто стилем (visibility, место под него
  // держится), иначе на первом экране было бы видно «15+», потом сброс на
  // ноль и счёт заново.
  function counterFinal(el) {
    if (!el.dataset.final) el.dataset.final = el.textContent.trim();
    return el.dataset.final;
  }

  function showCounterFinal(el) {
    el.textContent = counterFinal(el);
    el.classList.add('counter-ready');
  }

  function animateCounter(element) {
    // Счётчик может попасть сюда дважды — сам по себе и через родителя.
    // И его мог уже показать страховочный таймер: сайт открыли в фоновой
    // вкладке, таймер выставил готовое число, а при переходе на вкладку
    // наблюдатель проснулся. Запустись анимация тогда — человек увидел бы
    // «15+», сброс на ноль и счёт заново.
    if (element.dataset.counting || element.classList.contains('counter-ready')) return;
    element.dataset.counting = '1';

    var final = counterFinal(element);
    var m = final.match(/^(\d+(?:\.\d+)?)(.*)$/);
    if (!m) { showCounterFinal(element); return; }

    var target = parseFloat(m[1]);
    var suffix = m[2];
    var isDecimal = m[1].indexOf('.') !== -1;
    var duration = 1200;
    var startedAt = null;

    element.textContent = (isDecimal ? '0.0' : '0') + suffix;
    element.classList.add('counter-ready');

    function frame(now) {
      if (startedAt === null) startedAt = now;
      var t = Math.min(1, (now - startedAt) / duration);
      var eased = 1 - Math.pow(1 - t, 3);
      var value = target * eased;
      element.textContent = (isDecimal ? value.toFixed(1) : Math.floor(value)) + suffix;
      if (t < 1) requestAnimationFrame(frame);
      else element.textContent = final;
    }
    requestAnimationFrame(frame);
  }

  // Инициализация при загрузке страницы
  function bootAnimations() {
    var noMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!('IntersectionObserver' in window) || noMotion) {
      revealEverything();
      return;
    }
    initScrollAnimations();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootAnimations);
  } else {
    bootAnimations();
  }

  // Реинициализация для SPA navigation (если используется)
  document.addEventListener('astro:page-load', bootAnimations);
</script>

<style is:global>
  /* Счётчик скрыт, пока не началась анимация: иначе на первом экране мелькнуло
     бы готовое число, потом ноль и счёт заново. visibility, а не display —
     место под число держится, вёрстка не прыгает. Без JavaScript его
     показывает <noscript> в Layout.astro. */
  [data-counter]:not(.counter-ready) { visibility: hidden; }

  /* Появление блоков: короткое и мягкое */
  [data-reveal] {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity .55s ease-out, transform .55s cubic-bezier(.2, .7, .3, 1);
  }

  [data-reveal].shown,
  [data-reveal].animate-in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal],
    [data-animate],
    [data-stagger] > * {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    [data-counter] { visibility: visible !important; }
  }

  /* Fade in */
  [data-animate="fade"] {
    opacity: 0;
    transition: opacity .5s ease-out;
  }
  
  [data-animate="fade"].animate-in {
    opacity: 1;
  }

  /* Slide up */
  [data-animate="slide-up"] {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .55s ease-out, transform .55s cubic-bezier(.2,.7,.3,1);
  }
  
  [data-animate="slide-up"].animate-in {
    opacity: 1;
    transform: translateY(0);
  }

  /* Slide left */
  [data-animate="slide-left"] {
    opacity: 0;
    transform: translateX(30px);
    transition: opacity .55s ease-out, transform .55s cubic-bezier(.2,.7,.3,1);
  }
  
  [data-animate="slide-left"].animate-in {
    opacity: 1;
    transform: translateX(0);
  }

  /* Slide right */
  [data-animate="slide-right"] {
    opacity: 0;
    transform: translateX(-30px);
    transition: opacity .55s ease-out, transform .55s cubic-bezier(.2,.7,.3,1);
  }
  
  [data-animate="slide-right"].animate-in {
    opacity: 1;
    transform: translateX(0);
  }

  /* Scale */
  [data-animate="scale"] {
    opacity: 0;
    transform: scale(0.95);
    transition: opacity .55s ease-out, transform .55s cubic-bezier(.2,.7,.3,1);
  }
  
  [data-animate="scale"].animate-in {
    opacity: 1;
    transform: scale(1);
  }

  /* Stagger - контейнер видим, дети скрыты */
  [data-stagger] {
    opacity: 1;
  }

  [data-stagger] > * {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity .55s ease-out, transform .55s cubic-bezier(.2,.7,.3,1);
  }

  [data-stagger] > *.animate-in {
    opacity: 1;
    transform: translateY(0);
  }

  /* Задержки для разных элементов */
  [data-delay="100"] {
    transition-delay: 0.07s;
  }
  
  [data-delay="200"] {
    transition-delay: 0.14s;
  }
  
  [data-delay="300"] {
    transition-delay: 0.21s;
  }
  
  [data-delay="400"] {
    transition-delay: 0.28s;
  }
</style>
