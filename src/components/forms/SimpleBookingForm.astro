---
// src/components/forms/SimpleBookingForm.astro
// Окно записи. Форма знает, откуда её открыли: кнопка передаёт контекст
// (услуга, программа, специалист), и окно под него подстраивается —
// заголовок, карточка с условиями и набор полей. Реестр — src/data/booking.ts
import { url } from '../../utils/url';
import Icon from '../Icon.astro';
import { BOOKING_CONTEXTS, FIELD_LABELS } from '../../data/booking';

// Все возможные поля лежат в разметке, а контекст показывает нужные:
// сайт статический, второго экземпляра окна заводить не хочется.
const ALL_FIELDS = ['name', 'phone', 'childName', 'childAge', 'email', 'comment'] as const;
---

<div class="booking-overlay" id="booking-modal" role="dialog" aria-modal="true" aria-labelledby="booking-title">
  <div class="booking-panel">

    <button class="modal-close" onclick="closeBookingModal()" aria-label="Закрыть" type="button">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Левая карточка: во что человек записывается -->
    <aside class="booking-aside gradient-card">
      <div class="aside-inner">
        <p class="aside-eyebrow" id="booking-eyebrow">Запись</p>
        <h3 class="aside-name" id="booking-service">Приём</h3>

        <dl class="aside-facts" id="booking-facts">
          <div class="fact" style="--i:0"><dt data-fact-label></dt><dd data-fact-value></dd></div>
          <div class="fact" style="--i:1"><dt data-fact-label></dt><dd data-fact-value></dd></div>
          <div class="fact" style="--i:2"><dt data-fact-label></dt><dd data-fact-value></dd></div>
        </dl>

        <p class="aside-note">
          <Icon name="lock" size={15} />
          <span>Данные видит только психолог</span>
        </p>
      </div>
    </aside>

    <!-- Правая часть: форма -->
    <div class="booking-main">
      <div class="booking-head">
        <h2 id="booking-title" class="heading-sm">Записаться на приём</h2>
        <p class="booking-lede muted" id="booking-lede">
          Оставьте контакты — свяжусь, чтобы подобрать удобное время.
        </p>
      </div>

      <!-- Экран успеха -->
      <div id="booking-success" class="booking-success hidden" role="status" aria-live="polite" aria-hidden="true">
        <div class="success-confetti" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="success-icon">
          <svg viewBox="0 0 80 80" width="72" height="72" aria-hidden="true">
            <circle class="success-ring" cx="40" cy="40" r="36" fill="none" stroke="currentColor" stroke-width="3"/>
            <path class="success-check" d="M24 42 L36 54 L58 30" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="success-title">Заявка отправлена</h3>
        <p class="success-text">Спасибо! Свяжусь с вами, чтобы подтвердить запись и подобрать время.</p>
        <button type="button" onclick="closeBookingModal()" class="pill pill-solid success-btn">Хорошо</button>
      </div>

      <!-- Ошибка отправки -->
      <div id="booking-error" class="booking-error hidden" role="alert" aria-hidden="true">
        <svg class="error-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"></path>
        </svg>
        <span>Не удалось отправить заявку. Позвоните: <a href="tel:+79151955132" class="error-phone">+7 (915) 195-51-32</a></span>
      </div>

      <form id="booking-form" novalidate>
        <div class="fields">
          {ALL_FIELDS.map((key, i) => {
            const f = FIELD_LABELS[key];
            return (
              <div class="field" data-field={key} style={`--i:${i}`}>
                <label class="field-label" for={`booking-${key}`}>
                  {f.label}
                  <span class="field-req" data-req>*</span>
                </label>
                {f.type === 'textarea' ? (
                  <textarea
                    id={`booking-${key}`}
                    name={key}
                    rows="3"
                    class="form-field"
                    placeholder={f.placeholder}
                  ></textarea>
                ) : (
                  <input
                    type={f.type}
                    id={`booking-${key}`}
                    name={key}
                    class="form-field"
                    placeholder={f.placeholder}
                    autocomplete={key === 'phone' ? 'tel' : key === 'email' ? 'email' : key === 'name' ? 'name' : 'off'}
                  />
                )}
                <p class="field-error" data-error></p>
              </div>
            );
          })}
        </div>

        <div class="consent-box">
          <label>
            <input type="checkbox" name="privacy" id="booking-privacy" required>
            <span class="consent-text">
              Я согласен(а) на обработку персональных данных в соответствии с
              <a href={url('/privacy')} target="_blank" rel="noopener">Политикой конфиденциальности</a>
            </span>
          </label>
        </div>

        <div class="booking-actions">
          <button type="submit" class="pill pill-solid submit-btn" id="booking-submit">
            <span class="submit-label">Отправить заявку</span>
            <span class="submit-spinner" aria-hidden="true"></span>
          </button>
          <button type="button" onclick="closeBookingModal()" class="pill pill-outline">Отмена</button>
        </div>

        <p class="form-note">Перезвоню, чтобы подтвердить запись — в рабочее время, с 9:00 до 21:00</p>
      </form>
    </div>
  </div>
</div>

<script>
  import { BOOKING_CONTEXTS as CONTEXTS, FIELD_LABELS as LABELS, contextForPath } from '../../data/booking';

  (function () {
    const modal = document.getElementById('booking-modal');
    if (!modal) return;

    const panel = modal.querySelector('.booking-panel');
    const form = document.getElementById('booking-form');
    const successBox = document.getElementById('booking-success');
    const errorBox = document.getElementById('booking-error');
    const submitBtn = document.getElementById('booking-submit');
    const submitLabel = submitBtn.querySelector('.submit-label');

    let returnFocus = null;
    let current = CONTEXTS.default;

    function setError(wrap, text) {
      wrap.classList.add('has-error');
      wrap.querySelector('[data-error]').textContent = text;
      wrap.querySelector('input, textarea').setAttribute('aria-invalid', 'true');
    }

    function clearError(wrap) {
      wrap.classList.remove('has-error');
      wrap.querySelector('[data-error]').textContent = '';
      wrap.querySelector('input, textarea').removeAttribute('aria-invalid');
    }

    // ---------- Подстановка контекста ----------
    function applyContext(key) {
      // Специалист приходит строкой вида specialist:Имя:Роль:kids
      if (typeof key === 'string' && key.indexOf('specialist:') === 0) {
        const parts = key.split(':');
        const name = parts[1] || 'Специалист';
        const role = parts[2] || '';
        const kids = parts[3] === 'kids';
        current = {
          eyebrow: 'Специалист',
          title: 'Запись к специалисту',
          lede: (role ? role + '. ' : '') + 'Оставьте контакты — согласуем удобное время.',
          facts: [
            { label: 'Специалист', value: name },
            { label: 'Направление', value: role || 'Психологическая помощь' },
            { label: 'Формат', value: kids ? 'Занятия с ребёнком' : 'Онлайн или в кабинете' },
          ],
          fields: kids
            ? ['name', 'phone', 'childName', 'childAge', 'email', 'comment']
            : ['name', 'phone', 'email', 'comment'],
          subject: 'Заявка: запись к специалисту — ' + name,
          submit: 'Записаться',
          service: name,
        };
      } else {
        current = CONTEXTS[key] || CONTEXTS.default;
      }

      document.getElementById('booking-eyebrow').textContent = current.eyebrow;
      document.getElementById('booking-service').textContent = current.service;
      document.getElementById('booking-title').textContent = current.title;
      document.getElementById('booking-lede').textContent = current.lede;
      submitLabel.textContent = current.submit;

      const slots = modal.querySelectorAll('#booking-facts .fact');
      slots.forEach(function (slot, i) {
        const fact = current.facts[i];
        slot.hidden = !fact;
        if (!fact) return;
        slot.querySelector('[data-fact-label]').textContent = fact.label;
        slot.querySelector('[data-fact-value]').textContent = fact.value;
      });

      // Показываем только поля этого контекста; спрятанные отключаем,
      // иначе они уедут в письмо пустыми строками.
      let shown = 0;
      modal.querySelectorAll('[data-field]').forEach(function (wrap) {
        const name = wrap.dataset.field;
        const on = current.fields.indexOf(name) !== -1;
        wrap.hidden = !on;
        if (on) wrap.style.setProperty('--i', shown++);

        const input = wrap.querySelector('input, textarea');
        const meta = LABELS[name];
        input.disabled = !on;
        input.required = on && meta.required;
        wrap.querySelector('[data-req]').hidden = !meta.required;
        clearError(wrap);
      });
    }

    // ---------- Открытие и закрытие ----------
    window.openBookingModal = function (context) {
      returnFocus = document.activeElement;
      // Кнопка не назвала контекст (шапка, плавающая кнопка) —
      // берём его по разделу, в котором человек сейчас находится
      applyContext(context || contextForPath(location.pathname));

      form.classList.remove('hidden');
      successBox.classList.add('hidden');
      successBox.setAttribute('aria-hidden', 'true');
      errorBox.classList.add('hidden');
      errorBox.setAttribute('aria-hidden', 'true');

      modal.classList.add('is-open');
      document.body.style.overflow = 'hidden';

      // Фокус на первое видимое поле — человек сразу может печатать
      const first = modal.querySelector('[data-field]:not([hidden]) input');
      window.setTimeout(function () {
        (first || modal.querySelector('.modal-close')).focus();
      }, 260);
    };

    window.closeBookingModal = function () {
      if (!modal.classList.contains('is-open')) return;
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
      if (returnFocus && returnFocus.focus) returnFocus.focus();
      returnFocus = null;
    };

    modal.addEventListener('click', function (e) {
      if (e.target === modal) window.closeBookingModal();
    });

    document.addEventListener('keydown', function (e) {
      if (!modal.classList.contains('is-open')) return;

      if (e.key === 'Escape') {
        window.closeBookingModal();
        return;
      }
      if (e.key !== 'Tab') return;

      const items = [].slice.call(panel.querySelectorAll('button, input, textarea, a[href]'))
        .filter(function (el) { return !el.disabled && el.offsetParent !== null; });
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      } else if (!panel.contains(document.activeElement)) {
        e.preventDefault();
        first.focus();
      }
    });

    // ---------- Проверка полей ----------
    function validate() {
      let firstBad = null;

      modal.querySelectorAll('[data-field]:not([hidden])').forEach(function (wrap) {
        const input = wrap.querySelector('input, textarea');
        const value = input.value.trim();
        clearError(wrap);

        if (input.required && !value) {
          setError(wrap, 'Заполните это поле');
          firstBad = firstBad || input;
          return;
        }
        if (wrap.dataset.field === 'phone' && value && value.replace(/\D/g, '').length < 10) {
          setError(wrap, 'Похоже, в номере не хватает цифр');
          firstBad = firstBad || input;
          return;
        }
        if (wrap.dataset.field === 'email' && value && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(value)) {
          setError(wrap, 'Проверьте адрес почты');
          firstBad = firstBad || input;
        }
      });

      const consent = document.getElementById('booking-privacy');
      const box = consent.closest('.consent-box');
      box.classList.remove('has-error');
      if (!consent.checked) {
        box.classList.add('has-error');
        firstBad = firstBad || consent;
      }

      return firstBad;
    }

    // Ошибку снимаем, как только человек начал править поле
    modal.querySelectorAll('[data-field] input, [data-field] textarea').forEach(function (el) {
      el.addEventListener('input', function () { clearError(el.closest('[data-field]')); });
    });
    document.getElementById('booking-privacy').addEventListener('change', function (e) {
      if (e.target.checked) e.target.closest('.consent-box').classList.remove('has-error');
    });

    // ---------- Отправка ----------
    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      const bad = validate();
      if (bad) {
        panel.classList.remove('shake');
        void panel.offsetWidth;
        panel.classList.add('shake');
        bad.focus();
        return;
      }

      const data = new FormData(form);
      const payload = {
        _subject: current.subject,
        _template: 'table',
        _captcha: 'false',
        'Услуга': current.service,
        'Имя': data.get('name') || '—',
        'Телефон': data.get('phone') || '—',
      };
      if (current.fields.indexOf('childName') !== -1) payload['Имя ребёнка'] = data.get('childName') || '—';
      if (current.fields.indexOf('childAge') !== -1) payload['Возраст ребёнка'] = data.get('childAge') || '—';
      payload['Email'] = data.get('email') || '—';
      payload['Комментарий'] = data.get('comment') || '—';
      payload['Страница'] = location.pathname;

      errorBox.classList.add('hidden');
      errorBox.setAttribute('aria-hidden', 'true');
      submitBtn.disabled = true;
      submitBtn.classList.add('is-loading');

      try {
        const response = await fetch('https://formsubmit.co/ajax/lyapina_sorokina@mail.ru', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });

        // formsubmit отвечает 200 и при отказе — судить по статусу нельзя,
        // иначе человек видит «заявка отправлена», а письмо никуда не ушло.
        const body = await response.json().catch(function () { return null; });
        if (!response.ok || !body || String(body.success) !== 'true') {
          throw new Error('Заявка не принята сервисом отправки');
        }

        form.reset();
        form.classList.add('hidden');
        successBox.classList.remove('hidden');
        successBox.setAttribute('aria-hidden', 'false');
        successBox.style.animation = 'none';
        void successBox.offsetWidth;
        successBox.style.animation = '';
        const ok = successBox.querySelector('.success-btn');
        if (ok) ok.focus();
      } catch (err) {
        errorBox.classList.remove('hidden');
        errorBox.setAttribute('aria-hidden', 'false');
        errorBox.style.animation = 'none';
        void errorBox.offsetWidth;
        errorBox.style.animation = '';
      } finally {
        submitBtn.disabled = false;
        submitBtn.classList.remove('is-loading');
      }
    });

    applyContext('default');
  })();
</script>

<style>
  /* ---------- Подложка и панель ---------- */
  .booking-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    overflow-y: auto;
    background: rgba(16, 20, 24, 0);
    backdrop-filter: blur(0px);
    visibility: hidden;
    transition: background .32s ease, backdrop-filter .32s ease, visibility 0s .32s;
  }

  .booking-overlay.is-open {
    visibility: visible;
    background: rgba(16, 20, 24, 0.55);
    backdrop-filter: blur(6px);
    transition: background .32s ease, backdrop-filter .32s ease, visibility 0s;
  }

  .booking-panel {
    position: relative;
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    width: 100%;
    max-width: 880px;
    margin: auto;
    background: var(--canvas);
    border: 1px solid var(--stone);
    border-radius: var(--r-large);
    overflow: hidden;
    box-shadow: 0 32px 80px -32px rgba(16, 20, 24, 0.42);
    opacity: 0;
    transform: translateY(22px) scale(0.975);
    transition: opacity .34s ease, transform .44s cubic-bezier(.16, .84, .28, 1);
  }

  .booking-overlay.is-open .booking-panel {
    opacity: 1;
    transform: none;
  }

  .booking-panel.shake { animation: panel-shake .42s ease; }

  @keyframes panel-shake {
    0%, 100% { transform: translateX(0); }
    18% { transform: translateX(-7px); }
    38% { transform: translateX(7px); }
    58% { transform: translateX(-4px); }
    78% { transform: translateX(4px); }
  }

  /* ---------- Левая карточка ---------- */
  .booking-aside {
    border-radius: 0;
    display: flex;
    /* .gradient-card рассчитан на широкую карточку: в узкой колонке его
       диагональ вырождается в плоский тон. Здесь свой, вертикальный. */
    background: linear-gradient(168deg, #1b4f60 0%, #24657c 46%, #3c4f77 100%);
  }

  .booking-aside::before {
    background:
      radial-gradient(52% 30% at 78% 6%, rgba(233, 168, 140, .16), transparent 70%),
      radial-gradient(60% 34% at 10% 96%, rgba(127, 196, 192, .16), transparent 72%);
  }

  .aside-inner {
    display: flex;
    flex-direction: column;
    padding: 38px 30px 30px;
    width: 100%;
  }

  .aside-eyebrow {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #fff;
    opacity: .92;
    margin-bottom: 12px;
  }

  .aside-name {
    font-size: 25px;
    font-weight: 300;
    letter-spacing: -.02em;
    line-height: 1.16;
    color: #fff;
    margin-bottom: 28px;
  }

  .aside-facts {
    display: grid;
    gap: 0;
    margin-bottom: auto;
  }

  .fact[hidden] { display: none; }

  .aside-facts dt {
    font-size: 12px;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: #fff;
    opacity: .92;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, .2);
  }

  .aside-facts dd {
    font-size: 15.5px;
    line-height: 1.35;
    color: #fff;
    margin: 5px 0 16px;
  }

  .is-open .fact {
    animation: fact-in .5s cubic-bezier(.2, .7, .3, 1) both;
    animation-delay: calc(160ms + var(--i, 0) * 70ms);
  }

  @keyframes fact-in {
    from { opacity: 0; transform: translateX(-10px); }
    to { opacity: 1; transform: none; }
  }

  .aside-note {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 26px;
    padding-top: 18px;
    border-top: 1px solid rgba(255, 255, 255, .2);
    font-size: 13px;
    color: #fff;
  }

  /* ---------- Правая часть ---------- */
  .booking-main {
    position: relative;
    padding: 38px 36px 32px;
  }

  .booking-head { margin-bottom: 26px; }
  .booking-lede { font-size: 14.5px; line-height: 1.6; margin-top: 8px; max-width: 44ch; }

  .modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    z-index: 3;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--taupe);
    border: 1px solid var(--stone);
    color: var(--smoke);
    transition: background .2s ease, color .2s ease, transform .3s cubic-bezier(.2, .7, .3, 1);
  }
  .modal-close:hover {
    background: var(--stone);
    color: var(--ink);
    transform: rotate(90deg);
  }

  /* ---------- Поля ---------- */
  .fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px 14px;
    margin-bottom: 20px;
  }

  .field[data-field='comment'],
  .field[data-field='email'] { grid-column: 1 / -1; }
  .field[hidden] { display: none; }

  .is-open .field:not([hidden]) {
    animation: field-in .45s cubic-bezier(.2, .7, .3, 1) both;
    animation-delay: calc(150ms + var(--i, 0) * 55ms);
  }

  @keyframes field-in {
    from { opacity: 0; transform: translateY(9px); }
    to { opacity: 1; transform: none; }
  }

  .field-label {
    display: block;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--graphite);
    margin-bottom: 7px;
  }

  .field-req { color: var(--spark-deep); }
  .field-req[hidden] { display: none; }

  .form-field {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid var(--stone);
    border-radius: 12px;
    background: var(--canvas);
    color: var(--ink);
    font-size: 16px;  /* меньше 16px — и Safari на iPhone зумит страницу */
    font-family: inherit;
    transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;
  }

  .form-field::placeholder { color: var(--ash); opacity: .75; }

  .form-field:hover { border-color: var(--ash); }

  .form-field:focus {
    outline: none;
    border-color: var(--spark-deep);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(39, 101, 121, .12);
  }

  textarea.form-field { resize: vertical; min-height: 84px; }

  .field-error {
    font-size: 12px;
    color: var(--spark-deep);
    margin-top: 6px;
  }
  .field-error:empty { display: none; }

  .has-error .form-field {
    border-color: var(--spark-deep);
    background: rgba(39, 101, 121, .04);
  }

  /* ---------- Согласие ---------- */
  .consent-box {
    padding: 14px 16px;
    margin-bottom: 22px;
    border-radius: 14px;
    background: var(--taupe);
    border: 1px solid var(--stone);
    transition: border-color .2s ease, background .2s ease;
  }
  .consent-box.has-error {
    border-color: var(--spark-deep);
    background: rgba(39, 101, 121, .05);
  }
  .consent-box label {
