---
// src/components/global/FloatingCTA.astro
// Кнопка записи в правом нижнем углу
import Icon from '../Icon.astro';
---

<div class="floating-cta-container">
  <!-- Главная кнопка -->
  <button 
    class="floating-cta-btn"
    onclick="openBookingModal()"
    aria-label="Записаться на консультацию"
  >
    <span class="cta-icon"><Icon name="note" size={22} /></span>
  </button>
  
  <!-- Тултип -->
  <div class="cta-tooltip">
    Записаться на консультацию
  </div>
  
 
</div>

<style>
  .floating-cta-container {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 90;
  }
  
  .floating-cta-btn {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--ink);
    border: none;
    border: 1px solid rgba(255, 255, 255, .16);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    animation: cta-appear .5s cubic-bezier(.2,.7,.3,1) both;
    position: relative;
  }
  
  .floating-cta-btn:hover {
    transform: scale(1.06);
    border-color: rgba(255, 255, 255, .3);
  }
  
  .cta-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
  }
  
  /* Пульсация */
  @keyframes cta-appear {
    from { opacity: 0; transform: scale(.9) translateY(8px); }
    to   { opacity: 1; transform: none; }
  }
  
  /* Тултип */
  .cta-tooltip {
    position: absolute;
    bottom: 100%;
    right: 0;
    margin-bottom: 0.75rem;
    background: rgba(15, 23, 42, 0.95);
    color: white;
    padding: 0.625rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    backdrop-filter: blur(8px);
  }
  
  .cta-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    right: 1rem;
    border: 6px solid transparent;
    border-top-color: rgba(15, 23, 42, 0.95);
  }
  
  .floating-cta-btn:hover + .cta-tooltip {
    opacity: 1;
  }
  
  /* Адаптив для мобильных */
  @media (max-width: 768px) {
    .floating-cta-container {
      bottom: 1.5rem;
      right: 1.5rem;
    }
    
    .floating-cta-btn {
      width: 3.5rem;
      height: 3.5rem;
    }
    
    .cta-icon {
      font-size: 1.5rem;
    }
    
    .cta-tooltip {
      font-size: 0.75rem;
      padding: 0.5rem 0.75rem;
    }
  }
  
  @media (max-height: 500px) and (orientation: landscape) {
    .floating-cta-container {
      bottom: 1rem;
      right: 1rem;
    }
    
    .floating-cta-btn {
      width: 3rem;
      height: 3rem;
    }
    
    .cta-icon {
      font-size: 1.25rem;
    }
  }
</style>
