---
// src/components/global/ExitIntentPopup.astro
// Exit-intent popup - показывается когда пользователь хочет уйти с сайта
import Icon from '../Icon.astro';
import { url } from '../../utils/url';
---

<div class="exit-popup-overlay" role="dialog" aria-modal="true"
     aria-labelledby="exit-popup-title" id="exit-popup">
  <div class="exit-popup-content">
    <button class="exit-popup-close" onclick="closeExitPopup()" aria-label="Закрыть">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    
    <div class="exit-popup-header">
      <div class="exit-popup-icon" aria-hidden="true"><Icon name="clock" size={26} /></div>
      <h2 class="exit-popup-title" id="exit-popup-title">Уходите?</h2>
      <p class="exit-popup-subtitle">
        Запишитесь на <strong>первичную консультацию</strong>
      </p>
    </div>
    
    <!-- Экран успеха: лежит в разметке, иначе scoped-стили до него не доходят -->
    <div class="exit-success hidden" id="exit-success" role="status" aria-live="polite">
      <div class="exit-confetti" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="exit-success-icon">
        <svg viewBox="0 0 80 80" width="72" height="72" aria-hidden="true">
          <circle class="exit-ring" cx="40" cy="40" r="36" fill="none" stroke="currentColor" stroke-width="3"></circle>
          <path class="exit-check" d="M24 42 L36 54 L58 30" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
      <h3 class="exit-success-title">Заявка принята</h3>
      <p class="exit-success-text">Отвечу вам в ближайшее время для подтверждения записи.</p>
      <button type="button" data-exit-close class="exit-success-btn">Хорошо</button>
    </div>

    <form class="exit-popup-form" id="exit-form">
      <div class="exit-error hidden" id="exit-error" role="alert">
        <svg class="error-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"></path>
        </svg>
        <span>Не удалось отправить. Позвоните: <a href="tel:+79151955132" class="exit-error-phone">+7 (915) 195-51-32</a></span>
      </div>
      <div class="form-group">
        <label class="visually-hidden" for="exit-name">Ваше имя</label>
        <input
          type="text"
          id="exit-name"
          name="name"
          placeholder="Ваше имя"
          required
          class="form-input"
        >
      </div>
      
      <div class="form-group">
        <label class="visually-hidden" for="exit-phone">Ваш телефон</label>
        <input
          type="tel"
          id="exit-phone"
          name="phone"
          placeholder="Ваш телефон"
          required
          class="form-input"
          inputmode="tel"
        >
      </div>
      
      <div class="consent-box">
        <label>
          <input type="checkbox" name="privacy" id="exit-privacy" required>
          <span class="consent-text">
            Согласен(а) на обработку персональных данных —
            <a href={url('/privacy')} target="_blank" rel="noopener">политика</a>
          </span>
        </label>
      </div>

      <button type="submit" class="form-submit">
        Получить консультацию
      </button>
      
      <p class="form-note">
        Отвечу в <strong>ближайшее время</strong>
      </p>
    </form>
    
    <div class="exit-popup-guarantees">
      <div class="guarantee-item">
        <span class="guarantee-icon"><Icon name="lock" size={18} /></span>
        <span class="guarantee-text">Конфиденциально</span>
      </div>
      <div class="guarantee-item">
        <span class="guarantee-icon"><Icon name="check" size={18} /></span>
        <span class="guarantee-text">Без обязательств</span>
      </div>
    </div>
  </div>
</div>

<style>
  .consent-box {
    padding: 14px 16px;
    margin-bottom: 20px;
    border-radius: 14px;
    background: var(--taupe);
    border: 1px solid var(--stone);
  }
  .consent-box label {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
  }
  .consent-box input { margin-top: 3px; width: 18px; height: 18px; flex-shrink: 0; accent-color: var(--spark-deep); }
  .consent-text { font-size: 13px; line-height: 1.55; color: var(--smoke); }
  .consent-text a { color: var(--spark-deep); text-decoration: underline; }


  .exit-popup-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    padding: 1rem;
    visibility: hidden;
  }
  
  .exit-popup-overlay.active {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }
  
  .exit-popup-content {
    background: white;
    border-radius: 1.5rem;
    padding: 2.5rem;
    max-width: 500px;
    width: 100%;
    position: relative;
    transform: scale(0.9);
    transition: transform 0.3s ease;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }
  
  .exit-popup-overlay.active .exit-popup-content {
    transform: scale(1);
  }
  
  .exit-popup-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 44px;
    height: 44px;
    border: none;
    background: transparent;
    font-size: 1.5rem;
    color: var(--smoke);
    cursor: pointer;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
  }
  
  .exit-popup-close:hover {
    color: var(--graphite);
    background: var(--taupe);
  }
  
  .exit-popup-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  
  .exit-popup-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: var(--taupe);
    border: 1px solid var(--stone);
    color: var(--spark-deep);
  }
  
  .exit-popup-title {
    font-size: 1.7rem;
    font-weight: 300;
    letter-spacing: -.02em;
    color: var(--ink);
    margin-bottom: 0.75rem;
  }
  
  .exit-popup-subtitle {
    font-size: 1.125rem;
    color: var(--graphite);
    line-height: 1.6;
  }
  
  .exit-popup-subtitle strong {
    color: var(--ink);
    font-weight: 500;
  }
  
  .exit-popup-form {
    margin-bottom: 1.5rem;
  }
  
  .form-group {
    margin-bottom: 1rem;
  }
  
  .form-input {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid var(--stone);
    border-radius: 12px;
    background: var(--canvas);
    color: var(--ink);
    font-size: 16px;  /* меньше 16px — и Safari на iPhone зумит страницу */
    font-family: inherit;
    transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;
  }

  .form-input::placeholder { color: var(--ash); opacity: .75; }
  .form-input:hover { border-color: var(--ash); }

  .form-input:focus {
    outline: none;
    border-color: var(--spark-deep);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(39, 101, 121, .12);
  }
  
  .form-submit {
    width: 100%;
    padding: 14px 24px;
    background: var(--ink);
    color: #fff;
    border: none;
    border-radius: var(--r-pill);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: .01em;
    cursor: pointer;
    transition: transform .25s cubic-bezier(.2,.7,.3,1), background .25s ease;
  }

  .form-submit:hover {
    transform: translateY(-1px);
    background: #000;
  }
  
  .form-note {
    text-align: center;
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--smoke);
  }
  
  .form-note strong {
    color: var(--spark-deep);
  }
  
  .exit-popup-guarantees {
    display: flex;
    justify-content: center;
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--stone);
  }
  
  .guarantee-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--smoke);
  }
  
  .guarantee-icon {
    display: inline-flex;
    align-items: center;
    color: var(--spark-deep);
    font-size: 1.25rem;
  }
  
  @media (max-width: 640px) {
    .exit-popup-content {
      padding: 2rem 1.5rem;
    }

    .exit-popup-title {
      font-size: 1.5rem;
    }

    .exit-popup-subtitle {
      font-size: 1rem;
    }

    .exit-popup-icon {
      font-size: 3rem;
    }

    .exit-popup-guarantees {
      flex-direction: column;
      gap: 0.75rem;
    }
  }

  /* ---------- Экран успеха ---------- */
  .exit-success {
    position: relative;
    text-align: center;
    padding: 1rem 0.5rem 0.5rem;
    animation: exitSuccessFadeIn 0.5s ease-out both;
  }

  @keyframes exitSuccessFadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .exit-success-icon {
    display: inline-flex;
    color: var(--spark-deep);
    margin-bottom: 1.25rem;
    filter: drop-shadow(0 8px 20px rgba(72, 148, 178, 0.35));
  }

  .exit-success-icon svg { overflow: visible; }

  .exit-ring {
    stroke-dasharray: 226;
    stroke-dashoffset: 226;
    animation: exitDrawRing 0.55s 0.05s ease-out forwards;
  }

  .exit-check {
    stroke-dasharray: 60;
    stroke-dashoffset: 60;
    animation: exitDrawCheck 0.35s 0.55s ease-out forwards;
  }

  @keyframes exitDrawRing { to { stroke-dashoffset: 0; } }
  @keyframes exitDrawCheck { to { stroke-dashoffset: 0; } }

  .exit-success-title {
    font-size: 1.55rem;
    font-weight: 300;
    letter-spacing: -.02em;
    color: var(--ink);
    margin-bottom: 0.75rem;
    animation: exitSuccessPop 0.4s 0.65s ease-out both;
  }

  .exit-success-text {
    color: var(--graphite);
    line-height: 1.6;
    margin-bottom: 1.75rem;
    animation: exitSuccessPop 0.4s 0.8s ease-out both;
  }

  @keyframes exitSuccessPop {
    from { opacity: 0; transform: scale(0.92); }
    to   { opacity: 1; transform: scale(1); }
  }

  .exit-success-btn {
    padding: 13px 30px;
    background: var(--ink);
    color: #fff;
    border: none;
    border-radius: var(--r-pill);
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    transition: transform .2s ease, background .2s ease;
    animation: exitSuccessPop 0.4s 0.95s ease-out both;
  }

  .exit-success-btn:hover {
    transform: translateY(-1px);
    background: #000;
  }

  .exit-confetti {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
  }

  .exit-confetti span {
    position: absolute;
    left: 50%;
    top: 50px;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    opacity: 0;
    animation: exitConfettiBurst 1.1s 0.6s ease-out forwards;
  }

  .exit-confetti span:nth-child(1)  { background: var(--spark-water); --tx:  -160px; --ty: -120px; --r: -40deg; }
  .exit-confetti span:nth-child(2)  { background: var(--spark-powder); --tx:   140px; --ty: -140px; --r:  50deg; }
  .exit-confetti span:nth-child(3)  { background: #f2b134; --tx:  -220px; --ty:  -40px; --r: -80deg; }
  .exit-confetti span:nth-child(4)  { background: #7fb685; --tx:   220px; --ty:  -20px; --r:  90deg; }
  .exit-confetti span:nth-child(5)  { background: var(--spark-water); --tx:   -80px; --ty: -180px; --r: -20deg; border-radius: 50%; }
  .exit-confetti span:nth-child(6)  { background: var(--spark-powder); --tx:    80px; --ty: -180px; --r:  20deg; border-radius: 50%; }
  .exit-confetti span:nth-child(7)  { background: var(--spark-lilac); --tx:  -260px; --ty:   40px; --r: -110deg; }
  .exit-confetti span:nth-child(8)  { background: #f2b134; --tx:   260px; --ty:   60px; --r:  110deg; }
  .exit-confetti span:nth-child(9)  { background: #7fb685; --tx:  -120px; --ty:  -80px; --r: -60deg; border-radius: 50%; }
  .exit-confetti span:nth-child(10) { background: var(--spark-water); --tx:   120px; --ty:  -90px; --r:  60deg; border-radius: 50%; }
  .exit-confetti span:nth-child(11) { background: var(--spark-powder); --tx:  -200px; --ty:  120px; --r: -140deg; }
  .exit-confetti span:nth-child(12) { background: var(--spark-lilac); --tx:   200px; --ty:  140px; --r:  140deg; }
  .exit-confetti span:nth-child(13) { background: #f2b134; --tx:   -40px; --ty: -220px; --r:   10deg; border-radius: 50%; }
  .exit-confetti span:nth-child(14) { background: #7fb685; --tx:    40px; --ty: -220px; --r:  -10deg; border-radius: 50%; }
  .exit-confetti span:nth-child(15) { background: var(--spark-water); --tx:     0px; --ty: -260px; --r:   30deg; }

  @keyframes exitConfettiBurst {
    0% {
      opacity: 0;
      transform: translate(-50%, 0) rotate(0deg) scale(0.6);
    }
    15% { opacity: 1; }
    100% {
      opacity: 0;
      transform: translate(calc(-50% + var(--tx)), var(--ty)) rotate(var(--r)) scale(1);
    }
  }

  /* Inline-ошибка */
  .hidden { display: none; }
  .exit-error-phone { color: var(--spark-deep); text-decoration: underline; }

  .exit-error {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--taupe);
    border: 1px solid var(--stone);
    color: var(--ink);
    padding: 0.875rem 1rem;
    border-radius: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.925rem;
    animation: exitErrorShake 0.5s ease-out;
  }

  .exit-error.hidden { display: none; }

  .exit-error .error-icon { font-size: 1.125rem; flex-shrink: 0; }

  @keyframes exitErrorShake {
    0%, 100% { transform: translateX(0); }
    20%      { transform: translateX(-6px); }
    40%      { transform: translateX(6px); }
    60%      { transform: translateX(-4px); }
    80%      { transform: translateX(4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .exit-success,
    .exit-ring,
    .exit-check,
    .exit-success-title,
    .exit-success-text,
    .exit-success-btn,
    .exit-confetti span,
    .exit-error {
      animation: none !important;
    }
    .exit-ring, .exit-check { stroke-dashoffset: 0; }
  }
</style>

<script is:inline>
  (function () {
    let exitPopupShown = false;

    let exitReturnFocus = null;

    function exitFocusables(popup) {
      return [...popup.querySelectorAll('button, [href], input, select, textarea')]
        .filter((el) => !el.disabled && el.offsetParent !== null);
    }

    function showExitPopup() {
      const popup = document.getElementById('exit-popup');
      if (popup && !exitPopupShown) {
        exitReturnFocus = document.activeElement;
        popup.classList.add('active');
        exitPopupShown = true;
        localStorage.setItem('exitPopupShown', 'true');

        // Окно перекрывает страницу целиком: без этого мышью выйти можно,
        // а с клавиатуры — нет, и страница под ним продолжала прокручиваться.
        document.body.style.overflow = 'hidden';
        popup.querySelector('.exit-popup-close')?.focus();
      }
    }

    function closeExitPopup() {
      const popup = document.getElementById('exit-popup');
      if (popup) {
        popup.classList.remove('active');
        document.body.style.overflow = '';
        if (exitReturnFocus && exitReturnFocus.focus) exitReturnFocus.focus();
        exitReturnFocus = null;
      }
    }

    document.addEventListener('keydown', function (e) {
      const popup = document.getElementById('exit-popup');
      if (!popup || !popup.classList.contains('active')) return;

      if (e.key === 'Escape') {
        closeExitPopup();
        return;
      }

      if (e.key !== 'Tab') return;

      // Держим фокус внутри окна, иначе Tab уводит на страницу под затемнением
      const items = exitFocusables(popup);
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      } else if (!popup.contains(document.activeElement)) {
        e.preventDefault();
        first.focus();
      }
    });

    window.closeExitPopup = closeExitPopup;
    window.showExitPopup = showExitPopup;

    document.getElementById('exit-popup')?.addEventListener('click', function (e) {
      if (e.target && e.target.id === 'exit-popup') {
        closeExitPopup();
      }
    });

    document.querySelectorAll('[data-exit-close]').forEach(function (btn) {
      btn.addEventListener('click', closeExitPopup);
    });

    document.getElementById('exit-form')?.addEventListener('submit', async function (e) {
      e.preventDefault();

      const form = e.target;
      const formData = new FormData(form);
      const submitBtn = form.querySelector('.form-submit');
      const originalText = submitBtn ? submitBtn.textContent : '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Отправка...';
      }

      const payload = {
        _subject: 'Новая заявка с сайта — всплывающая форма',
        _template: 'table',
        _captcha: 'false',
        Имя: formData.get('name') || '—',
        Телефон: formData.get('phone') || '—',
        Источник: 'Exit-intent попап (julialyapina.ru)'
      };

      try {
        const response = await fetch('https://formsubmit.co/ajax/lyapina_sorokina@mail.ru', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        // formsubmit отвечает 200 и при отказе — судить по статусу нельзя,
      // иначе человек видит «заявка отправлена», а письмо никуда не ушло.
      const data = await response.json().catch(() => null);
      if (!response.ok || !data || String(data.success) !== 'true') {
        throw new Error('Заявка не принята сервисом отправки');
      }

        const form = document.getElementById('exit-form');
        const success = document.getElementById('exit-success');
        const header = document.querySelector('.exit-popup-header');
        if (form) form.classList.add('hidden');
        // «Уходите?» над «Заявка принята» читается странно
        if (header) header.classList.add('hidden');
        if (success) {
          success.classList.remove('hidden');
          success.style.animation = 'none';
          void success.offsetWidth;
          success.style.animation = '';
          const ok = success.querySelector('.exit-success-btn');
          if (ok) ok.focus();
        }
      } catch (err) {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalText;
        }
        const errorBox = document.getElementById('exit-error');
        if (errorBox) {
          errorBox.classList.remove('hidden');
          errorBox.style.animation = 'none';
          void errorBox.offsetWidth;
          errorBox.style.animation = '';
        }
      }
    });

    if (localStorage.getItem('exitPopupShown') === 'true') {
      exitPopupShown = true;
    }

    document.addEventListener('mouseleave', function (e) {
      if (e.clientY <= 0 && !exitPopupShown) {
        showExitPopup();
      }
    });

    let lastScrollTop = 0;
    let scrollUpCount = 0;

    window.addEventListener('scroll', function () {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (scrollTop < lastScrollTop && scrollTop < 100) {
        scrollUpCount++;
        if (scrollUpCount >= 3 && !exitPopupShown) {
          showExitPopup();
        }
      } else {
        scrollUpCount = 0;
      }
      lastScrollTop = scrollTop;
    });

    setTimeout(function () {
      if (!exitPopupShown && document.visibilityState === 'visible') {
        showExitPopup();
      }
    }, 30000);
  })();
</script>
