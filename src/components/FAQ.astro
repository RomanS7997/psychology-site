---
// src/components/FAQ.astro
interface Props {
  items: Array<{
    question: string;
    answer: string;
  }>;
  title?: string;
  subtitle?: string;
}

const { items, title = "Часто задаваемые вопросы", subtitle = "Ответы на популярные вопросы" } = Astro.props;
const uniqueId = `faq-${Math.random().toString(36).substr(2, 9)}`;
---

<section id="faq" class="faq-section">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <h2 class="heading text-center mb-4">
        {title}
      </h2>
      <p class="lede text-center mb-12">
        {subtitle}
      </p>
      
      <div class="space-y-4" id={uniqueId}>
        {items.map((item, index) => (
          <div class="faq-item" data-index={index}>
            <button class="faq-button w-full text-left p-6 flex items-center justify-between" aria-expanded="false">
              <span class="faq-question">{item.question}</span>
              <svg class="faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="faq-content overflow-hidden transition-all duration-300 ease-in-out" style="max-height: 0;">
              <div class="px-6 pb-6">
                <p class="faq-answer">{item.answer}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script define:vars={{ uniqueId }}>
  // FAQ accordion functionality
  document.addEventListener('DOMContentLoaded', () => {
    const faqContainer = document.getElementById(uniqueId);
    if (!faqContainer) return;
    
    const faqItems = faqContainer.querySelectorAll('.faq-item');
    
    faqItems.forEach(item => {
      const button = item.querySelector('.faq-button');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon');
      
      if (!button || !content || !icon) return;
      
      button.addEventListener('click', () => {
        const isOpen = button.getAttribute('aria-expanded') === 'true';
        
        // Закрыть все остальные FAQ
        faqItems.forEach(otherItem => {
          if (otherItem !== item) {
            const otherButton = otherItem.querySelector('.faq-button');
            const otherContent = otherItem.querySelector('.faq-content');
            const otherIcon = otherItem.querySelector('.faq-icon');
            
            if (otherButton && otherContent && otherIcon) {
              otherButton.setAttribute('aria-expanded', 'false');
              otherContent.style.maxHeight = '0';
              otherIcon.style.transform = 'rotate(0deg)';
              otherItem.classList.remove('is-open');
            }
          }
        });
        
        // Переключить текущий FAQ
        if (isOpen) {
          button.setAttribute('aria-expanded', 'false');
          content.style.maxHeight = '0';
          icon.style.transform = 'rotate(0deg)';
          item.classList.remove('is-open');
        } else {
          button.setAttribute('aria-expanded', 'true');
          content.style.maxHeight = content.scrollHeight + 'px';
          icon.style.transform = 'rotate(180deg)';
          item.classList.add('is-open');
        }
      });
    });
  });
</script>

<style>
  .faq-section { padding: 96px 0; background: var(--canvas); }

  .faq-item {
    background: var(--taupe);
    border-radius: var(--r-card);
    overflow: hidden;
    cursor: pointer;
    transition: background-color .25s ease;
  }
  .faq-item:hover { background: var(--stone); }

  .faq-question {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -.01em;
    color: var(--ink);
    padding-right: 16px;
  }

  .faq-icon {
    width: 20px; height: 20px; flex-shrink: 0;
    color: var(--ash);
    transition: transform .3s cubic-bezier(.2,.7,.3,1);
  }

  .faq-answer { font-size: 15px; line-height: 1.65; color: var(--smoke); }

  @media (max-width: 767px) {
    .faq-section { padding: 64px 0; }
  }

  .faq-item.is-open { background: var(--stone); }

  .faq-content { transition: max-height .3s ease-in-out; }

  .faq-button:focus-visible {
    outline: 2px solid var(--spark-deep);
    outline-offset: -2px;
    border-radius: var(--r-card);
  }
</style>
