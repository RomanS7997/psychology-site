---
// src/components/AutoGallerySlider.astro
// Галерея занятий: автослайдер с лайтбоксом
import Icon from './Icon.astro';

interface Props {
  images: {
    src: string;
    alt: string;
    caption?: string;
  }[];
  title?: string;
  subtitle?: string;
  eyebrow?: string;
  autoplayDelay?: number; // в миллисекундах
  accentColor?: string;   // оставлен для совместимости, на оформление не влияет
}

const {
  images,
  title = 'Как проходят занятия',
  subtitle = 'Фотографии с наших занятий',
  eyebrow = 'Галерея',
  autoplayDelay = 4000,
} = Astro.props;

const sliderId = `slider-${Math.random().toString(36).slice(2, 11)}`;
---

<section class="band band-taupe">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="inner">

      <div class="band-head" data-reveal>
        <p class="eyebrow mb-3">{eyebrow}</p>
        <h2 class="heading mb-4">{title}</h2>
        <p class="lede max-w-[56ch]">{subtitle}</p>
      </div>

      <div class="gallery-frame" data-reveal>
        <div id={sliderId} class="stage">

          <div class="slides">
            {images.map((image, index) => (
              <div
                class={`slide ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
                data-slide={index}
                inert={index === 0 ? undefined : true}
                aria-hidden={index === 0 ? undefined : 'true'}
              >
                <button
                  type="button"
                  class="slide-btn"
                  onclick={`openLightbox('${sliderId}', ${index})`}
                  aria-label={`Открыть фото ${index + 1} во весь экран`}
                >
                  <img
                    src={image.src}
                    alt={image.alt}
                    class="slide-img"
                    loading={index < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </button>

                <div class="slide-veil"></div>

                {image.caption && (
                  <p class="slide-caption">{image.caption}</p>
                )}
              </div>
            ))}
          </div>

          <button
            class="nav-btn nav-prev"
            onclick={`navigateSlide('${sliderId}', -1)`}
            aria-label="Предыдущий слайд"
            type="button"
          >
            <Icon name="arrow" size={18} />
          </button>

          <button
            class="nav-btn nav-next"
            onclick={`navigateSlide('${sliderId}', 1)`}
            aria-label="Следующий слайд"
            type="button"
          >
            <Icon name="arrow" size={18} />
          </button>

          <div class="dots">
            {images.map((_, index) => (
              <button
                class={`dot ${index === 0 ? 'is-active' : ''}`}
                onclick={`goToSlide('${sliderId}', ${index})`}
                data-indicator={index}
                aria-label={`Перейти к слайду ${index + 1}`}
                type="button"
              ></button>
            ))}
          </div>

          <p class="counter">
            <span data-current-slide>1</span> / <span>{images.length}</span>
          </p>

          <button
            class="pill pill-light expand-btn"
            onclick={`openLightbox('${sliderId}', getCurrentSlide('${sliderId}'))`}
            type="button"
          >
            <Icon name="screen" size={16} />
            Открыть галерею
          </button>
        </div>

        <p class="gallery-hint">
          Нажмите на фото, чтобы рассмотреть его целиком — листать можно стрелками
        </p>
      </div>

    </div>
  </div>
</section>

<!-- Лайтбокс -->
<div id={`lightbox-${sliderId}`} class="lightbox hidden" role="dialog" aria-modal="true" aria-label="Просмотр фотографии">
  <button
    class="lb-btn lb-close"
    onclick={`closeLightbox('${sliderId}')`}
    aria-label="Закрыть галерею"
    type="button"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>

  <div class="lb-stage">
    <img id={`lightbox-image-${sliderId}`} src="" alt="" class="lb-img" />
    <div id={`lightbox-caption-${sliderId}`} class="lb-caption"><p></p></div>
  </div>

  <button
    class="lb-btn lb-prev"
    onclick={`navigateLightbox('${sliderId}', -1)`}
    aria-label="Предыдущее фото"
    type="button"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path>
    </svg>
  </button>

  <button
    class="lb-btn lb-next"
    onclick={`navigateLightbox('${sliderId}', 1)`}
    aria-label="Следующее фото"
    type="button"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
    </svg>
  </button>

  <p class="lb-counter">
    <span id={`lightbox-counter-${sliderId}`}>1</span> / {images.length}
  </p>
</div>

<script define:vars={{ sliderId, images, autoplayDelay }}>
  (function () {
    let currentSlide = 0;
    let autoplayInterval;
    let lightboxIndex = 0;
    let returnFocus = null;
    const totalSlides = images.length;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    window.getCurrentSlide = function (id) {
      if (id === sliderId) return currentSlide;
      return 0;
    };

    function showSlide(index) {
      const slides = document.querySelectorAll(`#${sliderId} [data-slide]`);
      const indicators = document.querySelectorAll(`#${sliderId} [data-indicator]`);
      const counter = document.querySelector(`#${sliderId} [data-current-slide]`);

      slides.forEach((slide) => {
        slide.classList.replace('opacity-100', 'opacity-0');
        // Невидимый слайд не должен ловить Tab: раньше по галерее
        // пряталось девять кнопок «открыть фото», и обход шёл сквозь них.
        slide.setAttribute('inert', '');
        slide.setAttribute('aria-hidden', 'true');
      });
      const shown = slides[index];
      if (shown) {
        shown.classList.replace('opacity-0', 'opacity-100');
        shown.removeAttribute('inert');
        shown.removeAttribute('aria-hidden');
      }

      indicators.forEach((dot, i) => dot.classList.toggle('is-active', i === index));

      if (counter) counter.textContent = index + 1;
      currentSlide = index;
    }

    window.navigateSlide = function (id, direction) {
      if (id !== sliderId) return;
      stopAutoplay();
      let next = currentSlide + direction;
      if (next < 0) next = totalSlides - 1;
      if (next >= totalSlides) next = 0;
      showSlide(next);
      startAutoplay();
    };

    window.goToSlide = function (id, index) {
      if (id !== sliderId) return;
      stopAutoplay();
      showSlide(index);
      startAutoplay();
    };

    function startAutoplay() {
      if (reduceMotion) return;
      // Под открытым просмотром слайды не листаем — иначе, закрыв его,
      // человек оказывается на другом кадре, чем смотрел.
      const lightbox = document.getElementById(`lightbox-${sliderId}`);
      if (lightbox && !lightbox.classList.contains('hidden')) return;
      stopAutoplay();
      autoplayInterval = setInterval(() => {
        let next = currentSlide + 1;
        if (next >= totalSlides) next = 0;
        showSlide(next);
      }, autoplayDelay);
    }

    function stopAutoplay() {
      if (autoplayInterval) clearInterval(autoplayInterval);
    }

    function paintLightbox(index) {
      const image = document.getElementById(`lightbox-image-${sliderId}`);
      const caption = document.getElementById(`lightbox-caption-${sliderId}`);
      const counter = document.getElementById(`lightbox-counter-${sliderId}`);

      if (image) {
        image.src = images[index].src;
        image.alt = images[index].alt;
      }
      if (caption) {
        const text = images[index].caption;
        caption.querySelector('p').textContent = text || '';
        caption.classList.toggle('hidden', !text);
      }
      if (counter) counter.textContent = index + 1;
    }

    window.openLightbox = function (id, index) {
      if (id !== sliderId) return;
      const lightbox = document.getElementById(`lightbox-${sliderId}`);
      if (!lightbox) return;

      returnFocus = document.activeElement;
      lightboxIndex = index;
      paintLightbox(index);

      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      lightbox.querySelector('.lb-close')?.focus();
      stopAutoplay();
    };

    window.closeLightbox = function (id) {
      if (id !== sliderId) return;
      const lightbox = document.getElementById(`lightbox-${sliderId}`);
      if (!lightbox || lightbox.classList.contains('hidden')) return;

      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
      if (returnFocus && returnFocus.focus) returnFocus.focus();
      startAutoplay();
    };

    window.navigateLightbox = function (id, direction) {
      if (id !== sliderId) return;
      lightboxIndex += direction;
      if (lightboxIndex < 0) lightboxIndex = totalSlides - 1;
      if (lightboxIndex >= totalSlides) lightboxIndex = 0;
      paintLightbox(lightboxIndex);
    };

    document.addEventListener('keydown', (e) => {
      const lightbox = document.getElementById(`lightbox-${sliderId}`);
      if (!lightbox || lightbox.classList.contains('hidden')) return;

      if (e.key === 'Escape') { window.closeLightbox(sliderId); return; }
      if (e.key === 'ArrowLeft') { window.navigateLightbox(sliderId, -1); return; }
      if (e.key === 'ArrowRight') { window.navigateLightbox(sliderId, 1); return; }

      if (e.key !== 'Tab') return;

      // Держим фокус внутри просмотра: страница под ним скрыта от скринридера
      const items = [...lightbox.querySelectorAll('button')].filter((b) => b.offsetParent !== null);
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      } else if (!lightbox.contains(document.activeElement)) {
        e.preventDefault();
        first.focus();
      }
    });

    // Клик по фону закрывает просмотр
    document.getElementById(`lightbox-${sliderId}`)?.addEventListener('click', (e) => {
      if (e.target.classList.contains('lightbox') || e.target.classList.contains('lb-stage')) {
        window.closeLightbox(sliderId);
      }
    });

    const stage = document.getElementById(sliderId);
    if (stage) {
      stage.addEventListener('mouseenter', stopAutoplay);
      stage.addEventListener('mouseleave', startAutoplay);
    }

    startAutoplay();
  })();
</script>

<style>
  .band { padding: 96px 0; }
  .band-taupe { background: var(--taupe); }
  .inner { max-width: 1180px; margin: 0 auto; }
  .band-head { margin-bottom: 44px; }

  .gallery-frame { max-width: 1000px; margin: 0 auto; }

  .stage {
    position: relative;
    border-radius: var(--r-large);
    overflow: hidden;
    border: 1px solid var(--stone);
    background: var(--canvas);
  }

  .slides { position: relative; height: 420px; }

  .slide {
    position: absolute;
    inset: 0;
    transition: opacity .7s cubic-bezier(.4, 0, .2, 1);
  }
  .opacity-0 { opacity: 0; pointer-events: none; }
  .opacity-100 { opacity: 1; }

  .slide-btn {
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
    padding: 0;
    border: 0;
    background: none;
  }

  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .9s cubic-bezier(.2, .7, .3, 1);
  }
  .slide-btn:hover .slide-img { transform: scale(1.03); }

  .slide-veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, rgba(20, 24, 28, .62) 0%, rgba(20, 24, 28, .18) 34%, transparent 62%);
  }

  /* Подпись лежит поверх произвольной фотографии, поэтому у неё своя
     тёмная плашка: на светлых кадрах белый текст на одной вуали
     опускался до 2.3:1 и читался с трудом. */
  .slide-caption {
    position: absolute;
    left: 24px;
    right: 88px;
    bottom: 52px;
    display: inline-block;
    width: fit-content;
    max-width: calc(100% - 112px);
    padding: 9px 18px;
    border-radius: 99px;
    background: rgba(20, 24, 28, .72);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: -.01em;
    pointer-events: none;
  }

  /* Управление */
  .nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(251, 250, 248, .92);
    color: var(--ink);
    border: 1px solid var(--stone);
    transition: background .25s ease, transform .25s ease;
    z-index: 2;
  }
  .nav-btn:hover { background: var(--canvas); transform: translateY(-50%) scale(1.06); }
  .nav-prev { left: 18px; }
  .nav-prev :global(svg) { transform: rotate(180deg); }
  .nav-next { right: 18px; }

  .dots {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 12px;
    display: flex;
    justify-content: center;
    gap: 0;
    z-index: 2;
  }
  /* Сама точка маленькая, но нажимается вся клетка вокруг неё —
     иначе промах по 8 пикселям открывает фото вместо перелистывания. */
  .dot {
    width: 30px;
    height: 30px;
    border-radius: 99px;
    background: none;
    display: grid;
    place-items: center;
  }
  .dot::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 99px;
    background: rgba(255, 255, 255, .8);
    box-shadow: 0 0 0 1px rgba(20, 24, 28, .35);
    transition: width .3s ease, background .3s ease;
  }
  .dot:hover::before { background: rgba(255, 255, 255, .8); }
  .dot.is-active::before {
    width: 26px;
    background: #fff;
  }

  .counter {
    position: absolute;
    top: 20px;
    right: 20px;
    padding: 6px 13px;
    border-radius: 99px;
    background: rgba(20, 24, 28, .72);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 13px;
    letter-spacing: .01em;
    z-index: 2;
  }

  .expand-btn {
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 2;
    font-size: 14px;
  }

  .gallery-hint {
    margin-top: 22px;
    text-align: center;
    font-size: 14px;
    color: var(--smoke);
  }

  /* Лайтбокс */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(12, 15, 18, .95);
    backdrop-filter: blur(4px);
  }
  .lightbox.hidden { display: none; }

  .lb-stage {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lb-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 12px;
  }

  .lb-caption {
    position: absolute;
    bottom: 18px;
    left: 0;
    right: 0;
    text-align: center;
    pointer-events: none;
  }
  .lb-caption.hidden { display: none; }
  .lb-caption p {
    display: inline-block;
    padding: 10px 22px;
    border-radius: 99px;
    background: rgba(20, 24, 28, .6);
    backdrop-filter: blur(8px);
    color: #fff;
    font-size: 15px;
  }

  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, .1);
    color: #fff;
    transition: background .25s ease;
    z-index: 2;
  }
  .lb-btn:hover { background: rgba(255, 255, 255, .2); }
  .lb-close { top: 22px; right: 22px; }
  .lb-prev { left: 22px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 22px; top: 50%; transform: translateY(-50%); }

  .lb-counter {
    position: absolute;
    top: 30px;
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    font-size: 14px;
  }

  @media (max-width: 768px) {
    .band { padding: 64px 0; }
    .band-head { margin-bottom: 32px; }
    .slides { height: 300px; }
    .slide-caption { left: 16px; right: 16px; bottom: 48px; font-size: 14px;
      max-width: calc(100% - 32px); padding: 8px 15px; }
    .nav-btn { width: 44px; height: 44px; }
    .nav-prev { left: 12px; }
    .nav-next { right: 12px; }
    .expand-btn { display: none; }
    .counter { top: 16px; right: 16px; }
    .lb-prev { left: 10px; }
    .lb-next { right: 10px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide, .slide-img, .nav-btn, .dot::before { transition: none; }
  }
</style>
