---
// src/components/Footer.astro
// Все тексты — в src/content/global.json
import global from '../content/global.json';
import { url } from '../utils/url';

const { site, contacts, footer } = global;
---

<footer class="bg-gray-900 text-white py-12">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div>
        <h3 class="font-bold mb-4">{footer.aboutTitle}</h3>
        <ul class="space-y-2 text-sm text-gray-400">
          {footer.aboutLinks.map((link) => (
            <li><a href={url(link.href)} class="hover:text-white transition">{link.title}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="font-bold mb-4">{footer.servicesTitle}</h3>
        <ul class="space-y-3 text-sm text-gray-400">
          {footer.servicesLinks.map((link) => (
            <li>
              <a href={url(link.href)} class="hover:text-white transition font-semibold">{link.title}</a>
              <div class="text-xs text-gray-500">{link.note}</div>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="font-bold mb-4">{footer.contactsTitle}</h3>
        <ul class="space-y-2 text-sm text-gray-400">
          <li>📍 {contacts.address}</li>
          <li>📞 <a href={`tel:${contacts.phoneRaw}`} class="hover:text-white transition">{contacts.phone}</a></li>
          <li>📧 <a href={`mailto:${contacts.email}`} class="hover:text-white transition">{contacts.email}</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-bold mb-4">{footer.infoTitle}</h3>
        <ul class="space-y-2 text-sm text-gray-400">
          {footer.infoLinks.map((link) => (
            <li><a href={url(link.href)} class="hover:text-white transition">{link.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="border-t border-gray-800 mt-8 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-sm text-gray-400">{site.copyright}</p>
        <div class="flex gap-4">
          <a href={contacts.whatsapp} target="_blank" class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center hover:bg-[#4894B2] transition">
            <span class="text-sm">WA</span>
          </a>
          <a href={contacts.telegram} target="_blank" class="w-10 h-10 bg-gray-800 rounded-full flex items-center justify-center hover:bg-[#4894B2] transition">
            <span class="text-sm">TG</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
