---
// src/components/Footer.astro
// Все тексты — в src/data/global.json
import global from '../data/global.json';
import { url } from '../utils/url';
import Icon from './Icon.astro';

const { site, contacts, footer } = global;
---

<footer class="site-footer">
  <div class="container mx-auto px-4 lg:px-8">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div>
        <p class="footer-title">{footer.aboutTitle}</p>
        <ul class="footer-list">
          {footer.aboutLinks.map((link) => (
            <li><a href={url(link.href)} class="footer-link">{link.title}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="footer-title"><a href={url(footer.servicesHref)}>{footer.servicesTitle}</a></p>
        <ul class="footer-list footer-list-wide">
          {footer.servicesLinks.map((link) => (
            <li>
              <a href={url(link.href)} class="footer-link footer-link-strong">{link.title}</a>
              <div class="footer-note">{link.note}</div>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <p class="footer-title">{footer.contactsTitle}</p>
        <ul class="footer-list">
          <li class="footer-contact"><Icon name="address" size={17} /><a href={url('/contact#map')} class="footer-link footer-address">{contacts.address}</a></li>
          <li class="footer-contact"><Icon name="phone" size={17} /><a href={`tel:${contacts.phoneRaw}`} class="footer-link">{contacts.phone}</a></li>
          <li class="footer-contact"><Icon name="email" size={17} /><a href={`mailto:${contacts.email}`} class="footer-link">{contacts.email}</a></li>
          <li class="footer-contact footer-hours"><Icon name="working-hours" size={17} /><span>{contacts.hours}</span></li>
        </ul>
      </div>
      <div>
        <p class="footer-title">{footer.infoTitle}</p>
        <ul class="footer-list">
          {footer.infoLinks.map((link) => (
            <li><a href={url(link.href)} class="footer-link">{link.title}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="footer-copy">© {new Date().getFullYear()} {site.copyright}</p>
        <div class="flex gap-4">
          <a href={contacts.whatsapp} target="_blank" rel="noopener" class="footer-social" aria-label="WhatsApp" title="WhatsApp">
            <Icon name="whatsapp" size={18} />
          </a>
          <a href={contacts.telegram} target="_blank" rel="noopener" class="footer-social" aria-label="Telegram" title="Telegram">
            <Icon name="telegram" size={18} />
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--taupe);
    color: var(--graphite);
    padding: 64px 0 40px;
    border-top: 1px solid var(--stone);
  }

  .footer-title {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ash);
    margin-bottom: 18px;
  }

  /* Заголовок колонки «Услуги» ведёт на страницу со всеми услугами; выглядит как прежде */
  .footer-title a { color: inherit; transition: color 0.2s ease; }
  .footer-title a:hover { color: var(--ink); }

  .footer-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; font-size: 14px; }
  .footer-list-wide { gap: 6px; }

  .footer-link {
    color: var(--graphite);
    transition: color 0.2s ease;
    /* Ссылки шли строками по 21px — палец попадал в соседнюю */
    display: inline-flex;
    align-items: center;
    min-height: 34px;
  }
  .footer-link:hover { color: var(--ink); }
  .footer-link-strong { font-weight: 500; }

  .footer-note { font-size: 12.5px; color: var(--ash); margin-top: 2px; }

  .footer-bottom {
    margin-top: 44px;
    padding-top: 24px;
    border-top: 1px solid var(--stone);
  }

  .footer-contact {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    color: var(--graphite);
  }
  .footer-contact :global(svg) { color: var(--ash); flex-shrink: 0; margin-top: 1px; }
  /* Адрес длиннее строки и переносится: выравниваем по первой строке, как было у текста */
  .footer-address { align-items: flex-start; min-height: 0; }
  /* Часы — текст, а не ссылка: высоту строки держим той же, что у соседних */
  .footer-hours { min-height: 34px; align-items: center; }
  .footer-hours :global(svg) { margin-top: 0; }

  .footer-copy { font-size: 13px; color: var(--ash); }

  .footer-social {
    width: 38px; height: 38px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: var(--canvas);
    color: var(--graphite);
    border: 1px solid var(--stone);
    font-size: 12px; font-weight: 500;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .footer-social:hover { background: var(--ink); color: #fff; transform: translateY(-1px); }
</style>
