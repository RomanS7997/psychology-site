---
// src/layouts/Layout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/global/FloatingCTA.astro';
import ExitIntentPopup from '../components/global/ExitIntentPopup.astro';
import SimpleBookingForm from '../components/forms/SimpleBookingForm.astro';

interface Props {
  title: string;
  description?: string;
  /** Страница подключает компонент SEO сама. Если нет — Layout поставит теги за неё. */
  hasSEO?: boolean;
  /** Закрыть страницу от индексации (страница ошибки, служебные). */
  noindex?: boolean;
}

const {
  title,
  description = "Профессиональная психологическая помощь. Консультирование взрослых и детей, развивающие программы.",
  hasSEO = true,
  noindex = false,
} = Astro.props;
import { url } from '../utils/url';
import fontRanges from '../data/font-ranges.json';

const isHome = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');

// Превью на github.io — копия боевого сайта слово в слово. Два одинаковых
// сайта на двух адресах конкурируют между собой, и поисковик сам решает,
// какой показать; выиграть может превью. Поэтому превью закрыто от индексации,
// а смотреть его это не мешает.
const isPreview = /github\.io$/.test(Astro.site?.hostname || '');

// Куски шрифта и их диапазоны пересобирает scripts/build-font.py
const FONT_FILES = Object.keys(fontRanges);
// Просим вперёд только те куски, что нужны на каждой странице. latin-ext — это
// один знак рубля: на страницах без цен его нет, и браузер ругался бы, что
// запрошенный файл не пригодился.
const PRELOAD_FONTS = FONT_FILES.filter((name) => name !== 'latin-ext');
const fontFaces = FONT_FILES.map((name) => `
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 300 500;
        font-display: swap;
        src: url(${url(`/fonts/inter-${name}.woff2`)}) format('woff2');
        unicode-range: ${fontRanges[name]};
      }`).join('');
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Inter лежит рядом с сайтом и обрезан до знаков, которые на страницах
         есть: 148 КБ у Google превратились в 43 КБ в трёх кусках. Диапазоны
         не выдуманы, а посчитаны по самим файлам (scripts/build-font.py):
         знак рубля, например, Google держит в latin-ext, и без него цены
         рисовались бы чужим шрифтом. -->
    {PRELOAD_FONTS.map((f) => (
      <link rel="preload" as="font" type="font/woff2" href={url(`/fonts/inter-${f}.woff2`)} crossorigin />
    ))}
    <style is:inline set:html={fontFaces}></style>

    <!-- Подстраховка: обычно теги ставит компонент SEO, но если страница его
         не подключила, заголовок всё равно не должен потеряться. -->
    {!hasSEO && <title>{title}</title>}
    {!hasSEO && <meta name="description" content={description} />}
    {(noindex || isPreview) && <meta name="robots" content="noindex, follow" />}

    <!-- Сюда страница кладёт компонент SEO. Без слота его теги уезжали
         за пределы head: браузер их подбирает, простые парсеры соцсетей нет. -->
    <slot name="head" />
    
    <!-- Иконки вкладки и мобильного экрана -->
    <link rel="icon" href={url('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="icon" type="image/png" sizes="16x16" href={url('/favicon-16.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    
    <!-- Без JS блоки с data-reveal остались бы прозрачными: показываем их сразу -->
    <noscript>
      <style>
        [data-reveal],
        [data-animate],
        [data-stagger] > * {
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
        [data-counter] { visibility: visible !important; }
      </style>
    </noscript>

    <!-- Самый крупный элемент первого экрана: без подсказки браузер
         добирается до него только после разбора стилей -->
    {isHome && (
      <link
        rel="preload"
        as="image"
        href={url('/images/hero-psychologist-1120.webp')}
        imagesrcset={`${url('/images/hero-psychologist-620.webp')} 620w, ${url('/images/hero-psychologist-1120.webp')} 1120w`}
        imagesizes="(max-width: 860px) 92vw, 560px"
        type="image/webp"
        fetchpriority="high"
      />
    )}

    
  </head>
  <body>
    <a class="skip-link" href="#main">Перейти к содержимому</a>
    <Header />
    
    <main id="main">
      <slot />
    </main>
    
    <Footer />
    
    <!-- Глобальные компоненты конверсии -->
    <FloatingCTA />
    <ExitIntentPopup />
    <SimpleBookingForm />
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  /* Скрыть скроллбар, но оставить функциональность */
  ::-webkit-scrollbar {
    width: 8px;
  }
  
  ::-webkit-scrollbar-track {
    background: var(--taupe);
  }
  
  ::-webkit-scrollbar-thumb {
    background: var(--stone);
    border-radius: 4px;
  }
  
  ::-webkit-scrollbar-thumb:hover {
    background: var(--graphite);
  }
</style>
